{
  "info": {
    "_postman_id": "7a9a6d85-09a1-4a65-8db2-6f752f8f01a9",
    "name": "Ayushmita Disease–Treatment API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5001/api" },
    { "key": "sampleImage", "value": "C:\\temp\\sample.jpg" },
    { "key": "diseaseId", "value": "1" },
    { "key": "treatmentId", "value": "1" },
    { "key": "diseaseSlug", "value": "bile-duct-cancer" },
    { "key": "treatmentSlug", "value": "bile-duct-cancer-treatment" }
  ],
  "item": [
    {
      "name": "Diseases",
      "item": [
        {
          "name": "Create Disease",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Bile Duct Cancer", "type": "text" },
                { "key": "slug", "value": "{{diseaseSlug}}", "type": "text" },
                { "key": "short_description", "value": "Short blurb about the disease.", "type": "text" },
                { "key": "description_html", "value": "<p>Overview and details...</p>", "type": "text" },
                { "key": "seo_title", "value": "Bile Duct Cancer", "type": "text" },
                { "key": "seo_description", "value": "Meta description for disease.", "type": "text" },
                { "key": "seo_keywords", "value": "bile duct,cancer,treatment", "type": "text" },
                { "key": "canonical_url", "value": "https://example.com/bile-duct-cancer", "type": "text" },
                { "key": "status", "value": "1", "type": "text" },
                { "key": "image", "type": "file", "src": "{{sampleImage}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/diseases",
              "host": ["{{baseUrl}}"],
              "path": ["diseases"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.success && body.disease) {",
                  "  pm.environment.set('diseaseId', String(body.disease.id));",
                  "  pm.environment.set('diseaseSlug', body.disease.slug);",
                  "}",
                  "pm.test('Status 200/OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Diseases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/diseases?status=1&page=1&limit=20&q=cancer",
              "host": ["{{baseUrl}}"],
              "path": ["diseases"],
              "query": [
                { "key": "status", "value": "1" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "cancer" }
              ]
            }
          }
        },
        {
          "name": "Get Disease by ID (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/diseases/id/{{diseaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["diseases", "id", "{{diseaseId}}"]
            }
          }
        },
        {
          "name": "Get Disease by Slug (with treatments)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/diseases/{{diseaseSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["diseases", "{{diseaseSlug}}"]
            }
          }
        },
        {
          "name": "Update Disease",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Bile Duct Cancer (Updated)", "type": "text" },
                { "key": "short_description", "value": "Updated blurb.", "type": "text" },
                { "key": "seo_title", "value": "Updated SEO Title", "type": "text" },
                { "key": "status", "value": "1", "type": "text" },
                { "key": "image", "type": "file", "src": "{{sampleImage}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/diseases/{{diseaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["diseases", "{{diseaseId}}"]
            }
          }
        },
        {
          "name": "Delete Disease",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/diseases/{{diseaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["diseases", "{{diseaseId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Treatments",
      "item": [
        {
          "name": "Create Treatment",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "disease_id", "value": "{{diseaseId}}", "type": "text" },
                { "key": "name", "value": "Bile Duct Cancer Treatment", "type": "text" },
                { "key": "slug", "value": "{{treatmentSlug}}", "type": "text" },
                { "key": "short_description", "value": "Short treatment blurb.", "type": "text" },
                { "key": "description_html", "value": "<p>Treatment details...</p>", "type": "text" },
                { "key": "seo_title", "value": "Bile Duct Cancer Treatment", "type": "text" },
                { "key": "seo_description", "value": "Meta for treatment.", "type": "text" },
                { "key": "seo_keywords", "value": "bile duct,cancer,treatment", "type": "text" },
                { "key": "canonical_url", "value": "https://example.com/bile-duct-cancer-treatment", "type": "text" },
                { "key": "status", "value": "1", "type": "text" },
                { "key": "image", "type": "file", "src": "{{sampleImage}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/treatments",
              "host": ["{{baseUrl}}"],
              "path": ["treatments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.success && body.treatment) {",
                  "  pm.environment.set('treatmentId', String(body.treatment.id));",
                  "  pm.environment.set('treatmentSlug', body.treatment.slug);",
                  "}",
                  "pm.test('Status 200/OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Treatment by Slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/treatments/single/{{treatmentSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["treatments", "single", "{{treatmentSlug}}"]
            }
          }
        },
        {
          "name": "Get Treatments by Disease",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/treatments/disease/{{diseaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["treatments", "disease", "{{diseaseId}}"]
            }
          }
        },
        {
          "name": "Update Treatment",
          "request": {
            "method": "PUT",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Bile Duct Cancer Treatment (Updated)", "type": "text" },
                { "key": "status", "value": "1", "type": "text" },
                { "key": "image", "type": "file", "src": "{{sampleImage}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/treatments/{{treatmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["treatments", "{{treatmentId}}"]
            }
          }
        },
        {
          "name": "Delete Treatment",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/treatments/{{treatmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["treatments", "{{treatmentId}}"]
            }
          }
        }
      ]
    }
  ]
}

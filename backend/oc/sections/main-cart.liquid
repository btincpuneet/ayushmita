  document.addEventListener('DOMContentLoaded', () => {

    // Function to calculate the date range dynamically
    function getDateRange(dt1,dt2,Shippingrange) {
      const today = new Date(); // Current date

      // Start date: 2 days after today
      const startDate = new Date();
      startDate.setDate(today.getDate() + Number(dt1));

      // End date: 4 days after today
      const endDate = new Date();
      endDate.setDate(today.getDate() + Number(dt2));

      // Format dates as "Month Day"
      const options = { month: 'short', day: 'numeric' };
      const formattedStartDate = startDate.toLocaleDateString('en-US', options);
      const formattedEndDate = endDate.toLocaleDateString('en-US', options);

      // Return the formatted range
      if(dt1 >0 && dt2 >0)
      return `${formattedStartDate} - ${formattedEndDate}`;
     // return Shippingrange+' days';
      else
        return `In Stock`;
    }

    // Function to update cart item's properties
    async function updateCartProperties() {
      try {
     //  alert('hi');
        // Fetch the current cart
        const response = await fetch(`${window.Shopify.routes.root}cart.js`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
        });
        const cart = await response.json();

        let propertiesUpdated = false;

        const today = new Date();
        var inStockVDate = new Date();
        today.setHours(0, 0, 0, 0);
        inStockVDate.setHours(0, 0, 0, 0);

        for (let i = 0; i < cart.items.length; i++) {
        //  alert('d');
          const item = cart.items[i];
          const itemKey = item.key;
          const varientId = item.variant_id;
          const variantIdStock ="variant_"+varientId;
          const properties = { ...item.properties };
         console.dir(properties, { depth: null });
          var itemCount = parseInt(item.quantity, 10); //item.quantity;
          let Shippingrange = document.getElementById(item.id).value;
          var newEstimate ="";
          let range = Shippingrange.split('-');
          // Calculate the new date range
         // let newEstimate = getDateRange(range[0],range[1],Shippingrange);
          //alert(newEstimate);
          // const newEstimate = getDateRange(20,25,Shippingrange);
          let inStockDate = document.getElementById(variantIdStock).value;
          let checkDate = true;
         // alert(inStockDate.length);
                if(inStockDate.length > 0){
             //     alert('1');
                  inStockVDate = new Date(inStockDate);
                  inStockVDate.setHours(0, 0, 0, 0);
                    checkDate = false;  
                  }
           //       alert(checkDate);
                  if(checkDate){
           //         alert('12');
                    let range = Shippingrange.split('-');
                  // Calculate the new date range
                  newEstimate = getDateRange(range[0],range[1],Shippingrange);
                  }else{
         //       alert('3');
                  let msg = "";
                              if(inStockVDate >= today){
                               // let startDate = new Date(inStockVDate);
                                //  startDate.setDate(inStockVDate.getDate() - 14);
                                  let startDate = new Date(inStockDate);
                                  let startDateObj = new Date(inStockDate);
               const dateToday = new Date(today);
              const diffTime = startDate - dateToday; // difference in milliseconds
             const diffDaysOne = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            // alert(startDate+">>>>"+dateToday+">>>>>"+diffDaysOne);
          
          {% comment %} 1.check different between today date and start date {% endcomment %}
         
         
          const dateStartDate = new Date(startDate);
          const diffDays = Math.ceil((dateStartDate - dateToday) / (1000 * 60 * 60 * 24));
         // alert(diffDaysOne+">>>>"+diffDays);
          let diffDaysMinusOneDay =0;
          if( diffDaysOne >14){
       //     alert('1');
            diffDaysMinusOneDay = 14;
          }else  if(diffDaysOne >2){
         //   alert('2');
           diffDaysMinusOneDay = diffDays - 3;
          }else if(diffDaysOne == 1){
           // alert('3');
            diffDaysMinusOneDay = diffDays - 1;
          }else{
            //alert('4');
             diffDaysMinusOneDay = diffDays - 1;
          }
         // alert(startDate);
           startDate.setDate(startDateObj.getDate() - diffDaysMinusOneDay);
          // alert(startDate);
                                let endDate = new Date(inStockVDate);
                                const formatDate = (date) => {
                                            return date.toLocaleDateString("en-US", {
                                              day: "2-digit",
                                              month: "short"
                                            });
                                          };
                                let startFormatted = formatDate(startDate);
                                let endFormatted = formatDate(endDate);
                                let dateRange = `${startFormatted} - ${endFormatted}`;
                            //  msg = dateRange
                                newEstimate = dateRange;
                               // alert(newEstimate);
                              } // close inStockVDate >= today
                                  else{
                                  //  msg = 'In Stock';
                                  newEstimate = 'In Stock';
                                  }
                    }
                            // Skip if the property is already up to date
                            if (properties["Estimated to Ship by"] === newEstimate) {
                              continue;
                            } 
     //  alert(newEstimate);
          // Update the property
                    properties["Estimated to Ship by"] = newEstimate;
                    propertiesUpdated = true;
       //           alert('fffffffff');
                    // Send the update request for the specific line item
                    await fetch(`${window.Shopify.routes.root}cart/change.js`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        line: i + 1, // Line numbers are 1-based
                        //id:itemKey,
                        quantity:itemCount,
                      
                        properties:properties,
                        
                      }),
                    }); 
           
        }

        // Reload the page only if a property was updated
        if (propertiesUpdated) {
          location.reload();
        } 
          
      } catch (error) {
        console.error('Error updating cart properties:', error);
      }
      }
   // }
  
    // Run the update function once on page load
    updateCartProperties();

   
  });
window.onload = function () {
  //  alert("Page has fully loaded!");
     $("#updateCartBtn").prop("disabled", false);
      $("#checkoutCartBtn").prop("disabled", false);
  };
</script>


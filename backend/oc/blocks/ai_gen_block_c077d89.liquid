{% doc %}
  @prompt
    Each block must include:
    
    Image upload for the sports icon/logo (image_picker)
    
    Text label for the sport name
    
    URL field linking to a collection or page
    
    Functionality:
    
    The entire logo item (icon + text) must be clickable.
    
    Clicking a logo navigates to the assigned URL.
    
    Design & UX:
    
    Clean, modern, professional (Canada-mats style).
    
    Circular or badge-style icons.
    
    Subtle hover interaction (slight scale/lift and soft shadow or outline).
    
    Mobile-friendly grid layout.
    
    Settings:
    
    Include an optional section setting to toggle hover animation on/off.
    
    Let me add logo up until 8 logos please, please add a header and optional sub header for the whole block 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sports-logos-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-sports-logos-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-sports-logos-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-sports-logos-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-weight: 400;
    line-height: 1.5;
  }

  .ai-sports-logos-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-sports-logo-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  {% if block.settings.enable_hover_animation %}
    .ai-sports-logo-item-{{ ai_gen_id }}:hover {
      transform: translateY(-5px);
    }

    .ai-sports-logo-item-{{ ai_gen_id }}:hover .ai-sports-logo-icon-{{ ai_gen_id }} {
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }
  {% endif %}

  .ai-sports-logo-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    overflow: hidden;
    background-color: {{ block.settings.icon_background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.3s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .ai-sports-logo-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sports-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-sports-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-sports-logo-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    text-align: center;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    .ai-sports-logos-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-sports-logos-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-sports-logos-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 20px;
    }

    .ai-sports-logo-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-sports-logo-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<sports-logos-{{ ai_gen_id }} class="ai-sports-logos-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-sports-logos-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-sports-logos-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-sports-logos-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-sports-logos-container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign logo_enabled_key = 'logo_' | append: i | append: '_enabled'
        assign logo_image_key = 'logo_' | append: i | append: '_image'
        assign logo_label_key = 'logo_' | append: i | append: '_label'
        assign logo_url_key = 'logo_' | append: i | append: '_url'

        assign logo_enabled = block.settings[logo_enabled_key]
        assign logo_image = block.settings[logo_image_key]
        assign logo_label = block.settings[logo_label_key]
        assign logo_url = block.settings[logo_url_key]
      %}

      {% if logo_enabled %}
        <a
          href="{% if logo_url != blank %}{{ logo_url }}{% else %}#{% endif %}"
          class="ai-sports-logo-item-{{ ai_gen_id }}"
          {% if logo_label != blank %}aria-label="{{ logo_label }}"{% endif %}
        >
          <div class="ai-sports-logo-icon-{{ ai_gen_id }}">
            {% if logo_image %}
              <img
                src="{{ logo_image | image_url: width: 300 }}"
                alt="{{ logo_label | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% else %}
              <div class="ai-sports-logo-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if logo_label != blank %}
            <span class="ai-sports-logo-label-{{ ai_gen_id }}">{{ logo_label }}</span>
          {% endif %}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</sports-logos-{{ ai_gen_id }}>

<script>
  (function() {
    class SportsLogos{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-sports-logo-item-{{ ai_gen_id }}');
        links.forEach(link => {
          if (link.getAttribute('href') === '#') {
            link.addEventListener('click', (e) => {
              e.preventDefault();
            });
          }
        });
      }
    }

    customElements.define('sports-logos-{{ ai_gen_id }}', SportsLogos{{ ai_gen_id }});
  })();
</script>


{% doc %}
  @prompt
    I need a section following the Text columns with images format except all images and text fields can be dynamic metafield objects., each column has to be a separate block
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dynamic-column-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-dynamic-column__image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-dynamic-column__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-dynamic-column__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-dynamic-column__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-dynamic-column__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-dynamic-column__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-dynamic-column__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #666;
    font-size: 14px;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-dynamic-column__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-dynamic-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign column = block.settings.column_content %}

  {% if column != blank %}
    {% if column.image != blank %}
      <div class="ai-dynamic-column__image-wrapper-{{ ai_gen_id }}">
        <img
          src="{{ column.image | image_url: width: 800 }}"
          alt="{{ column.image.alt | escape }}"
          loading="lazy"
          width="{{ column.image.width }}"
          height="{{ column.image.height }}"
          class="ai-dynamic-column__image-{{ ai_gen_id }}"
        >
      </div>
    {% else %}
      <div class="ai-dynamic-column__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if column.title != blank %}
      <h3 class="ai-dynamic-column__title-{{ ai_gen_id }}">
        {{ column.title }}
      </h3>
    {% endif %}

    {% if column.description != blank %}
      <div class="ai-dynamic-column__text-{{ ai_gen_id }}">
        {{ column.description }}
      </div>
    {% endif %}
  {% else %}
    <div class="ai-dynamic-column__image-placeholder-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-dynamic-column__empty-state-{{ ai_gen_id }}">
        Next, add a metaobject
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Dynamic column",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "paragraph",
      "content": "Create a metaobject definition with fields for image, title, and description to use with this block"
    },
    {
      "type": "metaobject",
      "id": "column_content",
      "label": "Column content",
      "metaobject_type": "text_column"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Title spacing",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Image spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Dynamic column"
    }
  ]
}
{% endschema %}
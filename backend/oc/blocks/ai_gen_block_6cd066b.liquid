{% doc %}
  @prompt
    Article Page without the Back to Blog button at the bottom of the section., remove social sharing options at the bottom of this section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-article-page-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.spacing_top }}px 20px {{ block.settings.spacing_bottom }}px;
  }

  .ai-article-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-article-meta-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    color: {{ block.settings.meta_color }};
    font-size: {{ block.settings.meta_font_size }}px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-article-meta-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-article-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.2;
  }

  .ai-article-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-article-image-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-article-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-article-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_font_size }}px;
    color: {{ block.settings.content_color }};
    line-height: 1.7;
  }

  .ai-article-content-{{ ai_gen_id }} p {
    margin-bottom: 1.5em;
  }

  .ai-article-content-{{ ai_gen_id }} h2,
  .ai-article-content-{{ ai_gen_id }} h3,
  .ai-article-content-{{ ai_gen_id }} h4 {
    margin-top: 1.5em;
    margin-bottom: 0.75em;
    color: {{ block.settings.title_color }};
  }

  .ai-article-content-{{ ai_gen_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-article-tags-{{ ai_gen_id }} {
    margin-top: {{ block.settings.tags_spacing }}px;
    padding-top: {{ block.settings.tags_spacing }}px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-article-tags-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.meta_font_size }}px;
    color: {{ block.settings.meta_color }};
    margin-bottom: 12px;
    font-weight: 600;
  }

  .ai-article-tags-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-article-tag-{{ ai_gen_id }} {
    display: inline-block;
    padding: 6px 14px;
    background-color: {{ block.settings.tag_bg_color }};
    color: {{ block.settings.tag_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.tag_border_radius }}px;
    font-size: {{ block.settings.tag_font_size }}px;
    transition: background-color 0.2s ease;
  }

  .ai-article-tag-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tag_hover_bg_color }};
    color: {{ block.settings.tag_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-article-page-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing_top | times: 0.6 }}px 16px {{ block.settings.spacing_bottom | times: 0.6 }}px;
    }

    .ai-article-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-article-meta-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
{% endstyle %}

<article class="ai-article-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if article %}
    <header class="ai-article-header-{{ ai_gen_id }}">
      {% if block.settings.show_meta %}
        <div class="ai-article-meta-{{ ai_gen_id }}">
          {% if block.settings.show_author and article.author %}
            <div class="ai-article-meta-item-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>{{ article.author }}</span>
            </div>
          {% endif %}
          {% if block.settings.show_date %}
            <div class="ai-article-meta-item-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                {{ article.published_at | date: block.settings.date_format }}
              </time>
            </div>
          {% endif %}
        </div>
      {% endif %}

      <h1 class="ai-article-title-{{ ai_gen_id }}">{{ article.title }}</h1>

      {% if block.settings.show_excerpt and article.excerpt != blank %}
        <div class="ai-article-excerpt-{{ ai_gen_id }}">
          {{ article.excerpt }}
        </div>
      {% endif %}
    </header>

    {% if block.settings.show_featured_image and article.image %}
      <div class="ai-article-image-{{ ai_gen_id }}">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          alt="{{ article.image.alt | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="lazy"
        >
      </div>
    {% endif %}

    <div class="ai-article-content-{{ ai_gen_id }}">
      {{ article.content }}
    </div>

    {% if block.settings.show_tags and article.tags.size > 0 %}
      <div class="ai-article-tags-{{ ai_gen_id }}">
        <div class="ai-article-tags-label-{{ ai_gen_id }}">Tags</div>
        <div class="ai-article-tags-list-{{ ai_gen_id }}">
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="ai-article-tag-{{ ai_gen_id }}">
              {{ tag }}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <div style="text-align: center; padding: 60px 20px; color: #999;">
      <p>This block displays article content. Add it to an article template to see the content.</p>
    </div>
  {% endif %}
</article>

{% schema %}
{
  "name": "Article page",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 60
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 60
    },
    {
      "type": "header",
      "content": "Article header"
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show metadata",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "Date format",
      "default": "%B %d, %Y"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "header_spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Header spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Featured image"
    },
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Image spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Tags"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "range",
      "id": "tags_spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Tags spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "tag_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Tag border radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Title spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "excerpt_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Content size",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Metadata size",
      "default": 14
    },
    {
      "type": "range",
      "id": "tag_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Tag size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Metadata",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "tag_bg_color",
      "label": "Tag background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_hover_bg_color",
      "label": "Tag hover background",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "tag_hover_text_color",
      "label": "Tag hover text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Article page"
    }
  ]
}
{% endschema %}
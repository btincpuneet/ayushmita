{% doc %}
  @prompt
    Use dynamic blocks so I can add, remove, and reorder logos from the Shopify theme editor.
    
    Each block must include:
    
    Image upload for the sports icon/logo (image_picker)
    
    Text label for the sport name
    
    URL field linking to a collection or page
    
    Functionality:
    
    The entire logo item (icon + text) must be clickable.
    
    Clicking a logo navigates to the assigned URL.
    
    Design & UX:
    
    Clean, modern, professional (Canada-mats style).
    
    Circular or badge-style icons.
    
    Subtle hover interaction (slight scale/lift and soft shadow or outline).
    
    Mobile-friendly grid layout.
    
    Settings:
    
    Include an optional section setting to toggle hover animation on/off.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sports-logo-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-sports-logo-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 24px;
    padding: 20px 0;
    width: 100%;
  }

  .ai-sports-logo-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-sports-logo-item-{{ ai_gen_id }}:hover {
    {% if block.settings.enable_hover_animation %}
      transform: translateY(-4px);
    {% endif %}
  }

  .ai-sports-logo-icon-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_background_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
  }

  .ai-sports-logo-item-{{ ai_gen_id }}:hover .ai-sports-logo-icon-wrapper-{{ ai_gen_id }} {
    {% if block.settings.enable_hover_animation %}
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
      transform: scale(1.05);
    {% endif %}
  }

  .ai-sports-logo-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sports-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-sports-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-sports-logo-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    text-align: center;
    transition: color 0.3s ease;
  }

  .ai-sports-logo-item-{{ ai_gen_id }}:hover .ai-sports-logo-label-{{ ai_gen_id }} {
    {% if block.settings.enable_hover_animation %}
      color: {{ block.settings.label_hover_color }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-sports-logo-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 16px;
    }

    .ai-sports-logo-icon-wrapper-{{ ai_gen_id }} {
      width: 80px;
      height: 80px;
    }

    .ai-sports-logo-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-sports-logo-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
      gap: 12px;
    }

    .ai-sports-logo-icon-wrapper-{{ ai_gen_id }} {
      width: 70px;
      height: 70px;
    }
  }
{% endstyle %}

<div class="ai-sports-logo-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-sports-logo-container-{{ ai_gen_id }}">
    {% if block.settings.logo_image != blank %}
      <a
        href="{{ block.settings.logo_url }}"
        class="ai-sports-logo-item-{{ ai_gen_id }}"
        {% if block.settings.logo_url == blank %}aria-disabled="true" style="pointer-events: none;"{% endif %}
      >
        <div class="ai-sports-logo-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.logo_image %}
            <img
              src="{{ block.settings.logo_image | image_url: width: 200 }}"
              alt="{{ block.settings.logo_label | escape }}"
              class="ai-sports-logo-icon-{{ ai_gen_id }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-sports-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.logo_label != blank %}
          <span class="ai-sports-logo-label-{{ ai_gen_id }}">{{ block.settings.logo_label }}</span>
        {% endif %}
      </a>
    {% else %}
      <div class="ai-sports-logo-item-{{ ai_gen_id }}" style="pointer-events: none;">
        <div class="ai-sports-logo-icon-wrapper-{{ ai_gen_id }}">
          <div class="ai-sports-logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
        <span class="ai-sports-logo-label-{{ ai_gen_id }}">
          {% if block.settings.logo_label != blank %}
            {{ block.settings.logo_label }}
          {% else %}
            Add logo
          {% endif %}
        </span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sports logo",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_label",
      "label": "Sport name",
      "default": "Sport"
    },
    {
      "type": "url",
      "id": "logo_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Background color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "icon_border_width",
      "label": "Border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Label style"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_hover_color",
      "label": "Hover text color",
      "default": "#ab2237"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_animation",
      "label": "Enable hover animation",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sports logo"
    }
  ]
}
{% endschema %}

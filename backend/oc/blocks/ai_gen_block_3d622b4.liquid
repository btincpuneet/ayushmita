    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "label": "Image height (mobile)",
      "default": 400
    },
    {
      "type": "color",
      "id": "image_bg_color",

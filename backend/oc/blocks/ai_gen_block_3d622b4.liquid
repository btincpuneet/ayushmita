    {
      "type": "header",
      "content": "Text box style"
    },
    {
      "type": "range",
      "id": "text_box_width",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 500
    },
    {
      "type": "color",
      "id": "text_box_bg_color",

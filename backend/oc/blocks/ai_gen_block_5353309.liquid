{% doc %}
  @prompt
    Create a trust badges strip section for a Shopify storefront selling professional sports mats. The strip should display 4 horizontally aligned badges in a single row, separated by thin vertical dividers. Each badge has a short bold stat or label on top and a muted descriptor below it. The four badges are: (1) a star rating "★ 4.9" in green with subtitle "1,200+ reviews", (2) "ISO Certified" in bold with subtitle "Safety tested", (3) "Bulk Orders" in bold with subtitle "Custom pricing", and (4) "Ships in 3–5 days" in bold with subtitle "Track your order". The strip background should be white, full width, with a thin top and bottom border. Text should be center-aligned within each badge. Font size for the stat/label is 14px semi-bold, and 12px muted gray for the subtitle. The overall strip height should be compact — around 56–64px tall. Make it responsive so on mobile the badges stack into a 2x2 grid.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    padding: {{ block.settings.vertical_padding }}px 20px;
  }

  .ai-trust-badges__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 1200px;
    margin: 0 auto;
    gap: 0;
  }

  .ai-trust-badges__badge-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 16px;
    position: relative;
  }

  .ai-trust-badges__badge-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 60%;
    background-color: {{ block.settings.divider_color }};
  }

  .ai-trust-badges__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.label_color }};
    margin: 0 0 4px 0;
    line-height: 1.2;
  }

  .ai-trust-badges__label-{{ ai_gen_id }}.has-star {
    color: {{ block.settings.star_color }};
  }

  .ai-trust-badges__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px 0;
    }

    .ai-trust-badges__badge-{{ ai_gen_id }}:nth-child(2)::after {
      display: none;
    }

    .ai-trust-badges__badge-{{ ai_gen_id }}:nth-child(odd)::after {
      display: block;
    }

    .ai-trust-badges__badge-{{ ai_gen_id }}:nth-child(even)::after {
      display: none;
    }

    .ai-trust-badges-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px 16px;
    }
  }
{% endstyle %}

<trust-badges-{{ ai_gen_id }} class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges__container-{{ ai_gen_id }}">
    <div class="ai-trust-badges__badge-{{ ai_gen_id }}">
      <div class="ai-trust-badges__label-{{ ai_gen_id }} has-star">{{ block.settings.badge_1_label }}</div>
      <div class="ai-trust-badges__subtitle-{{ ai_gen_id }}">{{ block.settings.badge_1_subtitle }}</div>
    </div>

    <div class="ai-trust-badges__badge-{{ ai_gen_id }}">
      <div class="ai-trust-badges__label-{{ ai_gen_id }}">{{ block.settings.badge_2_label }}</div>
      <div class="ai-trust-badges__subtitle-{{ ai_gen_id }}">{{ block.settings.badge_2_subtitle }}</div>
    </div>

    <div class="ai-trust-badges__badge-{{ ai_gen_id }}">
      <div class="ai-trust-badges__label-{{ ai_gen_id }}">{{ block.settings.badge_3_label }}</div>
      <div class="ai-trust-badges__subtitle-{{ ai_gen_id }}">{{ block.settings.badge_3_subtitle }}</div>
    </div>

    <div class="ai-trust-badges__badge-{{ ai_gen_id }}">
      <div class="ai-trust-badges__label-{{ ai_gen_id }}">{{ block.settings.badge_4_label }}</div>
      <div class="ai-trust-badges__subtitle-{{ ai_gen_id }}">{{ block.settings.badge_4_subtitle }}</div>
    </div>
  </div>
</trust-badges-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustBadges{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('trust-badges-{{ ai_gen_id }}', TrustBadges{{ ai_gen_id }});
  })();
</script>


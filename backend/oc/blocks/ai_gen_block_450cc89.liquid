{% doc %}
  @prompt
    A case study page full of images of the project. The purpose of this is to encourage customers to partner with us for their projcts.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-case-study-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-case-study-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-case-study-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-case-study-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-case-study-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    line-height: 1.6;
  }

  .ai-case-study-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-case-study-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.grid_spacing }}px;
  }

  .ai-case-study-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-case-study-image-wrapper-{{ ai_gen_id }}--featured {
    grid-column: span {{ block.settings.columns_desktop }};
  }

  .ai-case-study-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-case-study-image-wrapper-{{ ai_gen_id }}:hover .ai-case-study-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-case-study-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-case-study-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-case-study-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-case-study-caption-{{ ai_gen_id }} {
    margin-top: 12px;
    font-size: {{ block.settings.caption_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    line-height: 1.4;
  }

  .ai-case-study-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.cta_spacing }}px;
  }

  .ai-case-study-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background-color 0.3s ease;
  }

  .ai-case-study-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-case-study-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-case-study-image-wrapper-{{ ai_gen_id }}--featured {
      grid-column: span {{ block.settings.columns_tablet }};
    }

    .ai-case-study-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-case-study-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-case-study-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-case-study-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-case-study-image-wrapper-{{ ai_gen_id }}--featured {
      grid-column: span {{ block.settings.columns_mobile }};
    }

    .ai-case-study-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-case-study-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.85);
    }

    .ai-case-study-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-case-study-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-case-study-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank or block.settings.description != blank %}
      <div class="ai-case-study-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-case-study-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <div class="ai-case-study-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-case-study-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-case-study-grid-{{ ai_gen_id }}">
      {% if block.settings.featured_image != blank %}
        <div class="ai-case-study-image-wrapper-{{ ai_gen_id }} ai-case-study-image-wrapper-{{ ai_gen_id }}--featured">
          <img
            src="{{ block.settings.featured_image | image_url: width: 2000 }}"
            alt="{{ block.settings.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.featured_image.width }}"
            height="{{ block.settings.featured_image.height }}"
            class="ai-case-study-image-{{ ai_gen_id }}"
          >
          {% if block.settings.featured_caption != blank %}
            <div class="ai-case-study-caption-{{ ai_gen_id }}">{{ block.settings.featured_caption }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign caption_key = 'caption_' | append: i
          assign image = block.settings[image_key]
          assign caption = block.settings[caption_key]
        %}

        {% if image != blank %}
          <div class="ai-case-study-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ image | image_url: width: 1000 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-case-study-image-{{ ai_gen_id }}"
            >
            {% if caption != blank %}
              <div class="ai-case-study-caption-{{ ai_gen_id }}">{{ caption }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      {% if block.settings.featured_image == blank %}
        {% assign has_images = false %}
        {% for i in (1..8) %}
          {% liquid
            assign image_key = 'image_' | append: i
            assign image = block.settings[image_key]
          %}
          {% if image != blank %}
            {% assign has_images = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% unless has_images %}
          <div class="ai-case-study-image-wrapper-{{ ai_gen_id }} ai-case-study-image-wrapper-{{ ai_gen_id }}--featured">
            <div class="ai-case-study-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-case-study-empty-state-{{ ai_gen_id }}">
                Add project images to showcase your work
              </div>
            </div>
          </div>
        {% endunless %}
      {% endif %}
    </div>

    {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
      <div class="ai-case-study-cta-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="ai-case-study-button-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>


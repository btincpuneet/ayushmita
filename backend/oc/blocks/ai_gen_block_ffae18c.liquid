{% doc %}
  @prompt
    Create a responsive FAQ block with two columns.
    Each column should neatly display multiple question-and-answer pairs.
    The layout should be balanced, visually clean, and easy to read.
    Include proper spacing between each FAQ item and ensure padding adjusts well for both mobile and desktop.
    Padding above and below the section should be adjustable to fit seamlessly before or after the  blocks.
    Style should be simple, modern, and consistent with a professional eCommerce design.
    Section heading, Create a responsive FAQ block with two columns.
    Each column should display multiple question-and-answer pairs in a balanced, visually clean layout.
    If there’s an odd number of items, automatically center the last item on its own row for proper visual balance.
    Include adequate spacing between FAQ items, with adjustable padding above and below the section so it can sit seamlessly before or after the product section.
    Ensure the design is modern, minimal, and aligns with a professional eCommerce look.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign total_faqs = 0 %}
{% for i in (1..12) %}
  {% assign question_key = 'question_' | append: i %}
  {% if block.settings[question_key] != blank %}
    {% assign total_faqs = total_faqs | plus: 1 %}
  {% endif %}
{% endfor %}

{% assign is_odd = total_faqs | modulo: 2 %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-faq-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.item_spacing }}px {{ block.settings.column_gap }}px;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_background }};
    border: 1px solid {{ block.settings.item_border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.item_padding }}px;
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    max-width: calc(50% - {{ block.settings.column_gap | divided_by: 2 }}px);
    margin: 0 auto;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    font-weight: 600;
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    margin: 0 0 12px;
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.7 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      margin-bottom: 30px;
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-faq-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.item_spacing }}px;
    }

    .ai-faq-item-{{ ai_gen_id }}:last-child:nth-child(odd) {
      max-width: 100%;
    }

    .ai-faq-item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding | times: 0.8 }}px;
    }

    .ai-faq-question-{{ ai_gen_id }} {
      font-size: {{ block.settings.question_size | times: 0.9 }}px;
    }

    .ai-faq-answer-{{ ai_gen_id }} {
      font-size: {{ block.settings.answer_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-faq-grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% assign question_key = 'question_' | append: i %}
        {% assign answer_key = 'answer_' | append: i %}
        {% assign question = block.settings[question_key] %}
        {% assign answer = block.settings[answer_key] %}

        {% if question != blank %}
          <div class="ai-faq-item-{{ ai_gen_id }}">
            <h3 class="ai-faq-question-{{ ai_gen_id }}">{{ question }}</h3>
            <div class="ai-faq-answer-{{ ai_gen_id }}">{{ answer }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>


{% doc %}
  @prompt
    Generate a section similar to Text columns with images except without the text features. Only retain image sections. Make those dynamic metafield objects. And then we can add as many as 3 columns.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-metafield-columns-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-metafield-columns__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-metafield-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-metafield-columns__column-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-metafield-columns__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-metafield-columns__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-metafield-columns__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-metafield-columns__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-metafield-columns__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-metafield-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-metafield-columns-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.75 }}px 0;
    }
  }
{% endstyle %}

<div class="ai-metafield-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-metafield-columns__container-{{ ai_gen_id }}">
    <div class="ai-metafield-columns__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign metaobject_key = 'metaobject_' | append: i
          assign metaobject = block.settings[metaobject_key]
        %}

        {% if metaobject != blank %}
          <div class="ai-metafield-columns__column-{{ ai_gen_id }}">
            <div class="ai-metafield-columns__image-wrapper-{{ ai_gen_id }}">
              {% if metaobject.image %}
                <img
                  src="{{ metaobject.image | image_url: width: 800 }}"
                  alt="{{ metaobject.image.alt | escape }}"
                  loading="lazy"
                  width="{{ metaobject.image.width }}"
                  height="{{ metaobject.image.height }}"
                  class="ai-metafield-columns__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-metafield-columns__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-metafield-columns__empty-state-{{ ai_gen_id }}">
                    Add an image to this metaobject
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Metafield image columns",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Metaobjects"
    },
    {
      "type": "metaobject",
      "id": "metaobject_1",
      "label": "Metaobject 1",
      "metaobject_type": "image_column"
    },
    {
      "type": "metaobject",
      "id": "metaobject_2",
      "label": "Metaobject 2",
      "metaobject_type": "image_column"
    },
    {
      "type": "metaobject",
      "id": "metaobject_3",
      "label": "Metaobject 3",
      "metaobject_type": "image_column"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Metafield image columns"
    }
  ]
}
{% endschema %}

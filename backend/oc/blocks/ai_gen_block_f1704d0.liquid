{% doc %}
  @prompt
    Create a Shopify block that displays a responsive table. The table should:
    
    Features:
    
    Include a heading and subheading (optional)
    
    Support icons in the first column or any column as specified
    
    Be fully responsive on desktop and mobile (scrollable horizontally or stacked rows on small screens)
    
    Have adjustable padding for rows and cells
    
    Include clear borders or alternating row colors for readability
    
    Include alt text for accessibility
    
    Table Inputs:
    
    Column headers: [List the headers you want]
    
    Row data: [Provide your data in a list format]
    
    Icons: [Specify icons for each row or column if needed]
    
    Padding preferences: [Specify padding values if desired]
    
    Optional styles: font size, background color, border style, row striping, etc.
    Make it mobile-friendly with adjustable padding and readable text
    
    Include icons inline with text where specified, Create a Shopify block that displays a responsive table. The table should:
    
    Features:
    
    Include a heading and subheading (optional)
    
    Support icons in any column as specified
    
    Be fully responsive on desktop and mobile:
    
    On desktop, display a normal table
    
    On mobile, stack rows or allow horizontal scrolling
    
    Include adjustable padding for cells and rows
    
    Use clear borders or alternating row colors for readability
    
    Include alt text for icons for accessibility
    
    Table Inputs:
    
    Column headers: [List your headers]
    
    Row data: [Provide your data in a list or spreadsheet-style format]
    
    Icons: [Specify icons for each row or column if needed]
    
    Padding preferences: [Specify top/bottom and left/right padding]
    
    Optional styles: font size, background color, border style, row striping, etc.
    
    Output Instructions:
    
    Provide HTML and CSS code that can be directly inserted into Shopify blocks
    
    Ensure responsive design, proper padding, and icon placement
    
    Include mobile-specific adjustments so content is readable and accessible
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-responsive-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-responsive-table__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_align }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-responsive-table__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    font-weight: 600;
  }

  .ai-responsive-table__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-responsive-table__wrapper-{{ ai_gen_id }} {
    {% if block.settings.mobile_layout == 'scroll' %}
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    {% endif %}
    background-color: {{ block.settings.table_background }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-responsive-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.table_font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-responsive-table__table-{{ ai_gen_id }} thead {
    background-color: {{ block.settings.header_bg_color }};
  }

  .ai-responsive-table__table-{{ ai_gen_id }} th {
    padding: {{ block.settings.header_padding_vertical }}px {{ block.settings.header_padding_horizontal }}px;
    text-align: {{ block.settings.header_text_align }};
    font-weight: 600;
    color: {{ block.settings.header_text_color }};
    {% if block.settings.show_borders %}
      border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-responsive-table__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding_vertical }}px {{ block.settings.cell_padding_horizontal }}px;
    text-align: {{ block.settings.cell_text_align }};
    {% if block.settings.show_borders %}
      border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    {% endif %}
  }

  {% if block.settings.enable_row_striping %}
    .ai-responsive-table__table-{{ ai_gen_id }} tbody tr:nth-child(even) {
      background-color: {{ block.settings.stripe_color }};
    }
    .ai-responsive-table__table-{{ ai_gen_id }} tbody tr:nth-child(odd) {
      background-color: {{ block.settings.row_bg_color }};
    }
  {% else %}
    .ai-responsive-table__table-{{ ai_gen_id }} tbody tr {
      background-color: {{ block.settings.row_bg_color }};
    }
  {% endif %}

  .ai-responsive-table__table-{{ ai_gen_id }} tbody tr:hover {
    background-color: {{ block.settings.row_hover_color }};
  }

  .ai-responsive-table__icon-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-right: {{ block.settings.icon_spacing }}px;
    vertical-align: middle;
  }

  .ai-responsive-table__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-responsive-table__cell-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    {% if block.settings.mobile_layout == 'stack' %}
      .ai-responsive-table__table-{{ ai_gen_id }},
      .ai-responsive-table__table-{{ ai_gen_id }} thead,
      .ai-responsive-table__table-{{ ai_gen_id }} tbody,
      .ai-responsive-table__table-{{ ai_gen_id }} th,
      .ai-responsive-table__table-{{ ai_gen_id }} td,
      .ai-responsive-table__table-{{ ai_gen_id }} tr {
        display: block;
      }

      .ai-responsive-table__table-{{ ai_gen_id }} thead tr {
        position: absolute;
        top: -9999px;
        left: -9999px;
      }

      .ai-responsive-table__table-{{ ai_gen_id }} tr {
        margin-bottom: 15px;
        border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
        border-radius: {{ block.settings.border_radius }}px;
      }

      .ai-responsive-table__table-{{ ai_gen_id }} td {
        border: none;
        position: relative;
        padding-left: 50%;
        text-align: left;
      }

      .ai-responsive-table__table-{{ ai_gen_id }} td:before {
        content: attr(data-label);
        position: absolute;
        left: {{ block.settings.cell_padding_horizontal }}px;
        width: 45%;
        padding-right: 10px;
        white-space: nowrap;
        font-weight: 600;
        color: {{ block.settings.header_text_color }};
      }
    {% else %}
      .ai-responsive-table__table-{{ ai_gen_id }} {
        min-width: 600px;
      }
    {% endif %}

    .ai-responsive-table__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-responsive-table__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-responsive-table__table-{{ ai_gen_id }} {
      font-size: {{ block.settings.table_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<responsive-table-{{ ai_gen_id }} class="ai-responsive-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-responsive-table__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-responsive-table__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-responsive-table__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}


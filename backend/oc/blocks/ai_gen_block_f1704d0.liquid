            assign row_col1_key = 'row' | append: i | append: '_col1'
            assign row_col2_key = 'row' | append: i | append: '_col2'
            assign row_col3_key = 'row' | append: i | append: '_col3'
            assign row_col4_key = 'row' | append: i | append: '_col4'
            assign row_col5_key = 'row' | append: i | append: '_col5'
            assign row_icon_key = 'row' | append: i | append: '_icon'
            assign row_icon_col_key = 'row' | append: i | append: '_icon_column'
            assign row_icon_alt_key = 'row' | append: i | append: '_icon_alt'

            assign col1_value = block.settings[row_col1_key]
            assign col2_value = block.settings[row_col2_key]
            assign col3_value = block.settings[row_col3_key]
            assign col4_value = block.settings[row_col4_key]
            assign col5_value = block.settings[row_col5_key]
            assign icon_type = block.settings[row_icon_key]
            assign icon_column = block.settings[row_icon_col_key]
            assign icon_alt = block.settings[row_icon_alt_key]

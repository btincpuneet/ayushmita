          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</responsive-table-{{ ai_gen_id }}>

<script>
  (function() {
    class ResponsiveTable{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const wrapper = this.querySelector('.ai-responsive-table__wrapper-{{ ai_gen_id }}');
        if (wrapper && wrapper.scrollWidth > wrapper.clientWidth) {
          wrapper.setAttribute('tabindex', '0');
          wrapper.setAttribute('role', 'region');
          wrapper.setAttribute('aria-label', 'Scrollable table');
        }
      }
    }

    customElements.define('responsive-table-{{ ai_gen_id }}', ResponsiveTable{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Responsive table",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Space between heading and subheading",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Table columns"
    },
    {
      "type": "text",
      "id": "col1_header",
      "label": "Column 1 header",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "col2_header",
      "label": "Column 2 header",

            <tr>
              {% if block.settings.col1_header != blank %}
                <td data-label="{{ block.settings.col1_header }}">
                  {% if icon_column == '1' and icon_type != 'none' %}
                    <div class="ai-responsive-table__cell-content-{{ ai_gen_id }}">
                      <span class="ai-responsive-table__icon-{{ ai_gen_id }}" role="img" aria-label="{{ icon_alt }}">
                        {% if icon_type == 'check' %}

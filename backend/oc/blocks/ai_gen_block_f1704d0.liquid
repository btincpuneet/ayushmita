    <table class="ai-responsive-table__table-{{ ai_gen_id }}">
      <thead>
        <tr>
          {% if block.settings.col1_header != blank %}
            <th>{{ block.settings.col1_header }}</th>
          {% endif %}
          {% if block.settings.col2_header != blank %}
            <th>{{ block.settings.col2_header }}</th>
          {% endif %}
          {% if block.settings.col3_header != blank %}
            <th>{{ block.settings.col3_header }}</th>
          {% endif %}
          {% if block.settings.col4_header != blank %}
            <th>{{ block.settings.col4_header }}</th>
          {% endif %}
          {% if block.settings.col5_header != blank %}
            <th>{{ block.settings.col5_header }}</th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        {% for i in (1..10) %}

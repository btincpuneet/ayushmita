{% doc %}
  @prompt
    Create a highly flexible, modular content block section for an eCommerce store.
    
    Build a section with independent components that can be enabled or disabled individually without breaking layout.
    
    Each component must work both:
    
    As part of a full section
    Or as a standalone block when others are turned off
    
    . Header (Optional Toggle)
    Large, bold heading text
    Primary attention element
    Must support empty state (if disabled, layout adjusts smoothly)
    2. Subheader (Optional Toggle)
    Smaller supporting headline under header
    Used for emphasis or campaign messaging
    Should collapse spacing if disabled
    3. Body Text (Optional Toggle)
    Paragraph or short description
    Supports multi-line text
    Clean readability, max width for better UX
    4. Button (Optional Toggle)
    Primary CTA button (e.g. “Shop Now”)
    Smooth hover animation (scale + soft glow)
    Fully configurable link URL
    Can be disabled without breaking layout
    
    Padding can be adjusted up and down
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-modular-content-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-modular-content__inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.element_spacing }}px;
  }

  .ai-modular-content__header-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    font-weight: {{ block.settings.header_weight }};
    color: {{ block.settings.header_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-modular-content__subheader-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheader_size }}px;
    font-weight: {{ block.settings.subheader_weight }};
    color: {{ block.settings.subheader_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-modular-content__body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    color: {{ block.settings.body_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-modular-content__button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.button_alignment }};
  }

  .ai-modular-content__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-modular-content__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: scale({{ block.settings.button_hover_scale }});
    box-shadow: 0 {{ block.settings.button_glow_size }}px {{ block.settings.button_glow_size | times: 2 }}px {{ block.settings.button_glow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-modular-content-{{ ai_gen_id }} {
      padding-left: {{ block.settings.padding_horizontal | times: 0.6 }}px;
      padding-right: {{ block.settings.padding_horizontal | times: 0.6 }}px;
    }

    .ai-modular-content__header-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_size | times: 0.7 }}px;
    }

    .ai-modular-content__subheader-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheader_size | times: 0.8 }}px;
    }

    .ai-modular-content__body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-modular-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-modular-content__inner-{{ ai_gen_id }}">
    {% if block.settings.enable_header and block.settings.header_text != blank %}
      <h2 class="ai-modular-content__header-{{ ai_gen_id }}">
        {{ block.settings.header_text }}
      </h2>
    {% endif %}

    {% if block.settings.enable_subheader and block.settings.subheader_text != blank %}
      <h3 class="ai-modular-content__subheader-{{ ai_gen_id }}">
        {{ block.settings.subheader_text }}
      </h3>
    {% endif %}

    {% if block.settings.enable_body and block.settings.body_text != blank %}
      <div class="ai-modular-content__body-{{ ai_gen_id }}">
        {{ block.settings.body_text }}
      </div>
    {% endif %}

    {% if block.settings.enable_button and block.settings.button_text != blank %}
      <div class="ai-modular-content__button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_link }}"
          class="ai-modular-content__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>


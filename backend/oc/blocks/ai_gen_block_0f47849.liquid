<script>
  (function() {
    class ImageHotspot{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.triggers = this.querySelectorAll('[data-hotspot-trigger]');
        this.contents = this.querySelectorAll('[data-hotspot-content]');
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.triggers.forEach((trigger) => {
          trigger.addEventListener('click', (e) => {
            e.preventDefault();
            const hotspotId = trigger.getAttribute('data-hotspot-trigger');
            this.activateHotspot(hotspotId);
          });
        });
      }

      activateHotspot(hotspotId) {
        this.triggers.forEach((trigger) => {
          trigger.classList.remove('active');
        });

        this.contents.forEach((content) => {
          content.classList.remove('active');
        });

        const activeTrigger = this.querySelector(`[data-hotspot-trigger="${hotspotId}"]`);
        const activeContent = this.querySelector(`[data-hotspot-content="${hotspotId}"]`);

        if (activeTrigger) {
          activeTrigger.classList.add('active');
        }

        if (activeContent) {
          activeContent.classList.add('active');
        }
      }
    }

    customElements.define('image-hotspot-{{ ai_gen_id }}', ImageHotspot{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hotspot side preview",
  "tag": null,
  "class": "ai-hotspot-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image_left",
          "label": "Left"
        },
        {
          "value": "image_right",
          "label": "Right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "side_panel_width",
      "label": "Side panel width",
      "min": 30,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Main image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "range",

{% doc %}
  @prompt
    Create a "Structure Difference" comparison block for a gym flooring product page. Layout:
    
    - Full-width dark banner at top with white uppercase text "THE STRUCTURE DIFFERENCE" centered, bold, letter-spaced
    - Below that, two side-by-side panels of equal width (50/50 split):
      - Left panel: displays an uploadable image filling the panel, with a dark overlay at the bottom containing "POLYURETHANE-BONDED RUBBER" in white uppercase bold as header and "LOOSE PARTICLES + GLUE" in smaller red/muted text below it
      - Right panel: displays an uploadable image filling the panel, with a dark overlay at the bottom containing "VULCANIZED RUBBER" in white uppercase bold as header and "FUSED & DENSE STRUCTURE" in smaller muted text below it
    - Both panels should be equal height (around 200-250px), images cover the full panel area (object-fit: cover)
    - Schema settings for: left_image, left_title, left_subtitle, right_image, right_title, right_subtitle
    - No extra padding around the panels — they sit flush edge to edge
    - Dark background (#0a0a0a) for the banner row
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-structure-comparison-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-structure-comparison__banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.banner_bg_color }};
    padding: {{ block.settings.banner_padding }}px 20px;
    text-align: center;
  }

  .ai-structure-comparison__banner-title-{{ ai_gen_id }} {
    color: {{ block.settings.banner_text_color }};
    font-size: {{ block.settings.banner_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
  }

  .ai-structure-comparison__panels-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
  }

  .ai-structure-comparison__panel-{{ ai_gen_id }} {
    position: relative;
    width: 50%;
    height: {{ block.settings.panel_height }}px;
    overflow: hidden;
  }

  .ai-structure-comparison__panel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-structure-comparison__panel-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-structure-comparison__panel-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-structure-comparison__panel-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: {{ block.settings.overlay_bg_color }};
    padding: {{ block.settings.overlay_padding }}px 20px;
  }

  .ai-structure-comparison__panel-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-structure-comparison__panel-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_color }};
    font-size: {{ block.settings.subtitle_font_size }}px;
    margin: 0;
    line-height: 1.3;
  }

  .ai-structure-comparison__panel-subtitle--accent-{{ ai_gen_id }} {
    color: {{ block.settings.subtitle_accent_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-structure-comparison__panels-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-structure-comparison__panel-{{ ai_gen_id }} {
      width: 100%;
      height: {{ block.settings.panel_height_mobile }}px;
    }

    .ai-structure-comparison__banner-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.banner_font_size | times: 0.7 }}px;
    }

    .ai-structure-comparison__panel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-structure-comparison__panel-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<structure-comparison-{{ ai_gen_id }} class="ai-structure-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-structure-comparison__banner-{{ ai_gen_id }}">
    <h2 class="ai-structure-comparison__banner-title-{{ ai_gen_id }}">
      {{ block.settings.banner_title }}
    </h2>
  </div>

  <div class="ai-structure-comparison__panels-{{ ai_gen_id }}">
    <div class="ai-structure-comparison__panel-{{ ai_gen_id }}">
      {% if block.settings.left_image %}
        <img
          src="{{ block.settings.left_image | image_url: width: 1000 }}"
          alt="{{ block.settings.left_image.alt | escape }}"
          class="ai-structure-comparison__panel-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.left_image.width }}"
          height="{{ block.settings.left_image.height }}"
        >
      {% else %}
        <div class="ai-structure-comparison__panel-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-structure-comparison__panel-overlay-{{ ai_gen_id }}">
        <h3 class="ai-structure-comparison__panel-title-{{ ai_gen_id }}">
          {{ block.settings.left_title }}
        </h3>
        <p class="ai-structure-comparison__panel-subtitle-{{ ai_gen_id }} {% if block.settings.left_use_accent_color %}ai-structure-comparison__panel-subtitle--accent-{{ ai_gen_id }}{% endif %}">
          {{ block.settings.left_subtitle }}
        </p>
      </div>
    </div>

    <div class="ai-structure-comparison__panel-{{ ai_gen_id }}">
      {% if block.settings.right_image %}
        <img
          src="{{ block.settings.right_image | image_url: width: 1000 }}"
          alt="{{ block.settings.right_image.alt | escape }}"
          class="ai-structure-comparison__panel-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.right_image.width }}"
          height="{{ block.settings.right_image.height }}"
        >
      {% else %}
        <div class="ai-structure-comparison__panel-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
      <div class="ai-structure-comparison__panel-overlay-{{ ai_gen_id }}">
        <h3 class="ai-structure-comparison__panel-title-{{ ai_gen_id }}">
          {{ block.settings.right_title }}
        </h3>
        <p class="ai-structure-comparison__panel-subtitle-{{ ai_gen_id }}">
          {{ block.settings.right_subtitle }}
        </p>
      </div>
    </div>
  </div>
</structure-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class StructureComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('structure-comparison-{{ ai_gen_id }}', StructureComparison{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Structure difference",
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner title",
      "default": "THE STRUCTURE DIFFERENCE"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "banner_font_size",
      "label": "Font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "banner_padding",
      "label": "Padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "left_title",
      "label": "Title",
      "default": "POLYURETHANE-BONDED RUBBER"
    },
    {
      "type": "text",
      "id": "left_subtitle",
      "label": "Subtitle",
      "default": "LOOSE PARTICLES + GLUE"
    },
    {
      "type": "checkbox",
      "id": "left_use_accent_color",
      "label": "Use accent color for subtitle",
      "default": true
    },
    {
      "type": "header",
      "content": "Right panel"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "right_title",
      "label": "Title",
      "default": "VULCANIZED RUBBER"
    },
    {
      "type": "text",
      "id": "right_subtitle",
      "label": "Subtitle",
      "default": "FUSED & DENSE STRUCTURE"
    },
    {
      "type": "header",
      "content": "Panel style"
    },
    {
      "type": "range",
      "id": "panel_height",
      "label": "Panel height (desktop)",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "panel_height_mobile",
      "label": "Panel height (mobile)",
      "min": 150,
      "max": 350,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "color",
      "id": "overlay_bg_color",
      "label": "Overlay background",
      "default": "rgba(0, 0, 0, 0.8)"
    },
    {
      "type": "range",
      "id": "overlay_padding",
      "label": "Overlay padding",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "subtitle_accent_color",
      "label": "Subtitle accent color",
      "default": "#ff4444"
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "Subtitle font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Structure difference"
    }
  ]
}
{% endschema %}

<div class="cart__item" data-key="{{ product.key }}">
  {%- assign img_url = product | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
 
 {% assign fraction = product.variant.metafields.custom.estimated_ship_days_weeks %}
{% assign parts = fraction | split: "-" %}
{% if parts.size >1 %}
{% assign today = 'now' | date: '%s' %}
{% assign add_days = parts[0] | times: 86400 %}
{% assign future_date = today | plus: add_days %}
{% assign future_date_formatted_first = future_date | date: "%Y-%m-%d" %}
 
{% assign add_days = parts[1] | times: 86400 %}
{% assign future_date = today | plus: add_days %}
{% assign future_date_formatted_second = future_date | date: "%Y-%m-%d" %}
{% assign instockDate = product.variant.metafields.custom.variant_instock_date | date: '%Y-%m-%d' %}
{% assign today = 'now' | date: '%Y-%m-%d' %}

{%  endif %}
  <div class="cart__image">
    <a href="{{ product.url }}" style="height: 0; padding-bottom: {{ 100 | divided_by: product.image.aspect_ratio }}%;">
      <img class="lazyload"
          data-src="{{ img_url }}"
          data-widths="[180, 360, 540]"
          data-aspectratio="{{ product.aspect_ratio }}"
          data-sizes="auto"
          alt="{{ product.product.title | escape }}">

      <noscript>
        <img class="lazyloaded"
          src="{{ product | img_url: '400x' }}"
          alt="{{ product.product.title | escape }}">
      </noscript>
    </a>
  </div>
  <div class="cart__item-details">
    <div class="cart__item-title">
      <a href="{{ product.url }}" class="cart__item-name">
        {{ product.product.title }}
      </a>
      {%- unless product.product.has_only_default_variant -%}
        <div class="cart__item--variants">
          {%- for option in product.options_with_values -%}
            <div><span>{{ option.name }}:</span> {{ option.value }}</div>
          {%- endfor -%}
        </div>
      {%- endunless -%}
      {%- if product.selling_plan_allocation != empty -%}
        <div class="cart__item--variants">
          {{ product.selling_plan_allocation.selling_plan.name }}
        </div>
      {%- endif -%}
      {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
             {% if p.first !="Estimated to Ship by"  %}
            <div class="proper">
              {% if p.first contains 'Your design' %}
                &nbsp;
              {% else %}
              {{ p.first }}:
              {% if p.last contains '/uploads/' %}
                <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
              {% else %}
                {{ p.last }}
              {% endif %}
            {% endif %}
            </div>
           
             
      {% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
<div class="proper">
  {% if product.variant.metafields.custom.variant_instock_date != blank %}
 {% if instockDate < today %}
              Estimated to Ship by : In Stock
 {% else %}
  {% comment %}
  {%- assign inStockVDate = product.variant.metafields.custom.variant_instock_date -%}
   {% endcomment %}
     {%- assign inStockVDate = product.variant.metafields.custom.variant_instock_date -%}

{%- assign end_timestamp = inStockVDate | date: "%s" -%}
{%- assign start_timestamp = end_timestamp | minus: 1209600 -%} 

{%- assign startFormatted = start_timestamp | date: "%d %b" -%}
{%- assign endFormatted   = end_timestamp   | date: "%d %b" -%}

{%- assign dateRange = startFormatted | append: " - " | append: endFormatted -%}
Estimated to Ship by : {{ dateRange }}
 {%  endif %}
  {% else %}
          {% if parts.size >1 %}
           
            Estimated to Ship by  : {{ future_date_formatted_first | date: "%b %d" }} - {{ future_date_formatted_second | date: "%b %d" }}
           
        {% else if fraction == 0 %}
            In Stock
          {% endif %}
        {% endif %} 
        </div>
    </div>
    <div class="cart__item-sub sd">
      <div>
  

   {%- assign property_size = product.properties | size -%}
      {% if property_size > 0 %}
        {% for p in product.properties %}
          {%- assign first_character_in_key = p.first | truncate: 1, '' -%}
          {% unless p.last == blank or first_character_in_key == '_' %}
            
            <div class="proper">
             {% if p.first == "Quantity of Mats" %}
                           {% assign customQuantity = p.last | plus: 0 %}
                    	   {% assign customItem = true %}
                       {% endif %}
                      
            </div>
         
          {% endunless %}
        
        {% endfor %}
        
      {% endif %}


           {% if customItem %}
                      <div class="grid__item one-third text-center" style="display:none;">
                        <label for="updates_{{ item.key }}" class="medium-up--hide">{{ 'cart.label.quantity' | t }}</label>
                        <label for="updates_{{ item.key }}" class="visually-hidden">{{ 'cart.label.quantity' | t }}</label>
                        <input type="number" value="{{ customQuantity }}" disabled min="0" style="text-align: center;margin: 0 auto;max-width: 80px;cursor: not-allowed;">
                        <input type="number" name="updates[]" id="updates_{{ item.key }}" class="cart__product-qty" value="{{ item.quantity }}" min="0" data-id="{{ item.key }}" style="display:none;">
                      </div>
                    {% else %}
				  <div class="js-qty__wrapper" style="display:none;">
          <label for="cart_updates_{{ product.key }}" class="hidden-label">{{ 'cart.label.quantity' | t }}</label>
          <input type="text"
            id="cart_updates_{{ product.key }}"
            name="updates[]"
            class="js-qty__num"
            value="{{ product.quantity }}"
            min="0"
            pattern="[0-9]*"
            data-id="{{ product.key }}">
          <button type="button"
            class="js-qty__adjust js-qty__adjust--minus"
            aria-label="{{ 'cart.general.reduce_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="#444" d="M17.543 11.029H2.1A1.032 1.032 0 0 1 1.071 10c0-.566.463-1.029 1.029-1.029h15.443c.566 0 1.029.463 1.029 1.029 0 .566-.463 1.029-1.029 1.029z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">&minus;</span>
          </button>
          <button type="button"
            class="js-qty__adjust js-qty__adjust--plus"
            aria-label="{{ 'cart.general.increase_quantity' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="#444" d="M17.409 8.929h-6.695V2.258c0-.566-.506-1.029-1.071-1.029s-1.071.463-1.071 1.029v6.671H1.967C1.401 8.929.938 9.435.938 10s.463 1.071 1.029 1.071h6.605V17.7c0 .566.506 1.029 1.071 1.029s1.071-.463 1.071-1.029v-6.629h6.695c.566 0 1.029-.506 1.029-1.071s-.463-1.071-1.029-1.071z"/></svg>
              <span class="icon__fallback-text" aria-hidden="true">+</span>
          </button>
        </div>
                    {% endif %}
      

        <div class="cart__remove" style="display: block;">
          <a href="{{ routes.cart_change_url }}?id={{ product.key }}&amp;quantity=0" class="text-link">
            {{ 'cart.general.remove' | t }}
          </a>
        </div>
      </div>

      <div class="cart__item-price-col text-center"> 
        <span class="cart__price a_pplr_item_price"> 
          {% if product.original_price > product.discounted_price %}
          <span class="price-cut"> {{ product.original_price | money }}</span>
          {% endif %}
        {{ product.discounted_price | money }}

        </span>
            </div>
    </div>
  </div>
</div>
<style>
  .price-cut {
  text-decoration: line-through;
  color: #999;
}
</style>
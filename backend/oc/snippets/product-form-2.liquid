{% assign minimum-width = product.metafields.canadamats.extra_details.minimum-width %}
{% assign minimum-length = product.metafields.canadamats.extra_details.minimum-length %}
{% assign maximum-width = product.metafields.canadamats.extra_details.maximum-width %}
{% assign maximum-length = product.metafields.canadamats.extra_details.maximum-length %}
{% assign roll-width = product.metafields.canadamats.extra_details.roll-width %}
{% assign wastagemultiplier = product.metafields.canadamats.extra_details.wastage %}
{% assign edgingmultiplier = product.metafields.canadamats.extra_details.edging %}

{%liquid
  comment
  echo minimum-width | append: '<br>'
  echo minimum-length | append: '<br>'
  echo maximum-width | append: '<br>'
  echo maximum-length | append: '<br>'
  echo roll-width | append: '<br>'
  echo wastagemultiplier | append: '<br>'
  echo edgingmultiplier | append: '<br>'
  endcomment
%}

{%- form 'product', product, id: form_id, class: 'product-single__form' -%}
  
<input type="hidden" id="mat-shipping-info" disabled name="properties[Estimated to Ship by]" value="2">
  <select name="id" data-product-select class="product-single__variants no-js">
  {%- for variant in product.variants -%}
    {%- if variant.available -%}
      <option {% if variant == product.selected_or_first_available_variant %}
        selected="selected"{% endif %}
        value="{{ variant.id }}">
        {{ variant.title }} - {{ variant.price | money_with_currency }}
      </option>
    {%- else -%}
      <option disabled="disabled">
        {{ variant.title }} - {{ 'products.product.sold_out' | t }}
      </option>
    {%- endif -%}
  {%- endfor -%}
</select>
 {% render 'custom-1-length-width-form',
  	section_id: section_id
  %}	
    <div class="product__quantity product__quantity--{{ settings.variant_type }}">
      <label for="Quantity-{{ section_id }}">{{ 'products.product.quantity' | t }}</label>
      {% render 'quantity-input-custom-1', id: section_id, qty: 1, min: 1 %}
    </div>

    <div id="pplr-{{ product.id }}" data-id="{{ product.id }}" class="product-personalizer" data-handle="{{product.handle}}"></div>

  {%- liquid
    assign enable_dynamic_buttons = false
    if show_dynamic_checkout and template != 'product.preorder'
      assign enable_dynamic_buttons = true
    endif
  -%}

  {%- if enable_dynamic_buttons -%}
    <div class="payment-buttons">
  {%- endif -%}

    {%- liquid
      assign default_text = 'products.product.add_to_cart' | t
      assign button_text = 'products.product.add_to_cart' | t
      if template contains 'preorder'
        assign default_text = 'products.product.preorder' | t
        assign button_text = 'products.product.preorder' | t
      endif
      unless current_variant.available
        assign button_text = 'products.product.sold_out' | t
      endunless
    -%}

    <button
      {% if product.empty? %}type="button"{% else %}type="submit"{% endif %}
      name="add"
      data-add-to-cart
      class="btn btn--full add-to-cart{% if enable_dynamic_buttons and product.selling_plan_groups == empty %} btn--secondary{% endif %}"
      {% unless current_variant.available %} disabled="disabled"{% endunless %}>
      <span data-add-to-cart-text data-default-text="{{ default_text }}">
        {{ button_text }}
      </span>
    </button>

    {%- if enable_dynamic_buttons -%}
      {{ form | payment_button }}
    {%- endif -%}

  {%- if enable_dynamic_buttons -%}
    </div>
  {%- endif -%}

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>
{%- endform -%}

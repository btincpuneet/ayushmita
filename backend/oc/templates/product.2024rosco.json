center"}},"image_x3QFhe":{"type":"image","settings":{"image":"{{ product.metafields.custom.promotion_grid_banner_image_1.value }}","link":"","width":"100%","alignment":"center"}}},"block_order":["liquid_L37jD7","image_x3QFhe"],"settings":{"full_width":false,"space_around":true}},"text_columns_dLTJpk":{"type":"text-columns","blocks":{"text_block_WGTizV":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Adagio_Adagio_Tour_7e866af5-f60a-428b-8b8d-5588cf2497df.png","image_width":650,"title":"Homogeneous PVC","text":"<p>Made from homogeneous PVC offer unmatched durability and flexibility, providing an optimal surface for dancers to perform. <\/p><p>The high-quality PVC ensures long-lasting performance, making it ideal for rigorous use in studios and stages.<\/p>","button_label":"","button_link":""}},"text_block_WTtyM6":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Duette___Black_Grey_502cf245-0095-4f99-bb83-d9886a999a54.png","image_width":650,"title":"PVC with Glass Mesh Interlayer","text":"<p>This PVC option is engineered for exceptional stability and strength.<\/p><p>Featuring a glass mesh interlayer, the innovative design combines the flexibility of PVC with the reinforcement of glass mesh, creating a robust surface that withstands heavy foot traffic while maintaining its integrity.<\/p>","button_label":"","button_link":""}},"text_block_mAWKyB":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Dance_Floor_Black_Grey_bd1f2017-0ae2-4422-aace-e4f18758792c.png","image_width":650,"title":"Two Homogeneous PVC Outer Layers with a Glass Mesh Interlayer","text":"<p>Experience the perfect blend of strength and comfort with our dual-layered PVC dance floors, featuring a glass mesh interlayer. <\/p><p>The dual homogeneous PVC outer layers provide a smooth, resilient surface, while the glass mesh adds stability, ensuring a safe and supportive environment for all types of dance.<br\/><\/p>","button_label":"","button_link":""}}},"block_order":["text_block_WGTizV","text_block_WTtyM6","text_block_mAWKyB"],"disabled":true,"settings":{"title":"Select Ideal Floor for Optimal Dance Performance","align_text":"left","divider":false}},"rich_text_TWh7n4":{"type":"rich-text","blocks":{"heading_7cj6Ur":{"type":"heading","settings":{"title":"SECURE, CARE AND MAINTAIN YOUR FLOORS"}},"text_tMM848":{"type":"text","settings":{"enlarge_text":false,"text":"<p><strong>PAIR IT WITH THE FOLLOWING ACCESSORIES<\/strong><\/p>"}}},"block_order":["heading_7cj6Ur","text_tMM848"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"7e055e20-1bd5-4eba-946b-e661b38d89db":{"type":"text-columns","blocks":{"template--14501101764737__7e055e20-1bd5-4eba-946b-e661b38d89db-16868738212d7a2fbe-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Vinyl_Floor_Tape_-_Black.jpg","image_width":650,"title":"Vinyl Floor Tape","text":"","button_label":"BUY HERE","button_link":"https:\/\/canadamats.ca\/products\/vinyl-tape"}},"template--14501101764737__7e055e20-1bd5-4eba-946b-e661b38d89db-16868738212d7a2fbe-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/DoubleStickFloortape.jpg","image_width":650,"title":"Double Stick Tape","text":"","button_label":"BUY HERE","button_link":"https:\/\/canadamats.ca\/products\/double-stick-tape"}},"template--14501101764737__7e055e20-1bd5-4eba-946b-e661b38d89db-16868738212d7a2fbe-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/All_Purpose_1_Liter.jpg","image_width":650,"title":"All Purpose Floor Cleaner","text":"","button_label":"BUY HERE","button_link":"https:\/\/canadamats.ca\/products\/all-purpose-cleaner"}}},"block_order":["template--14501101764737__7e055e20-1bd5-4eba-946b-e661b38d89db-16868738212d7a2fbe-0","template--14501101764737__7e055e20-1bd5-4eba-946b-e661b38d89db-16868738212d7a2fbe-1","template--1
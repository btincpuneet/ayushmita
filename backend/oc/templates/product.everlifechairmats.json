r","sales_point","inventory_status","a11a2a1c-b642-486c-b9a2-8c77a2640094","buy_buttons","4dc57701-9cf6-463e-afb8-cb4482dca980","608900a1-e324-4d71-a392-afacb6bb49d7","tab","contact","description","share"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"flexible","thumbnail_arrows":false,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"sub":{"type":"product-full-width","blocks":{"69abb819-e880-4d65-bc21-bcef1d6fc60d":{"type":"description","settings":{"is_tab":false}}},"block_order":["69abb819-e880-4d65-bc21-bcef1d6fc60d"],"settings":{"max_width":false}},"background-image-text":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"Impressive","title":"About your brand","text":"<p>Pair large text with a full-width image to draw attention to an important detail of your brand or product line.<\/p>","button_label":"","button_link":"","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"text-and-image":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_09T11_24_58_420Z.png","image_width":350,"subtitle":"","title":"Finished edges","text":"<p>Complete your floor’s look with optional finished edges. The edges <em>“snap”<\/em> into place using the same interlocking system as the dance flooring tiles and provide a clean, beveled border around your dance floor.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"text-and-image2":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_09T11_26_54_262Z.png","image_width":400,"subtitle":"","title":"WHEELED CART STORAGE","text":"<p>Pair large text with an image to tell a story, explain a detail about your product, or describe a new promotion.Specially designed cart for safe and convenient storage of your portable floor, minimal space required! A perfect tool to store and transport the 21′ X 21′ dance floors <\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"37afe09d-e6c1-4ab3-b02e-886b131010a1":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"","title":"simple and effective tiles","text":"<p>Attractive event flooring that is easy to install.<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/Slate_Black_Tap_Studio.webp","focal_point":"center","layout":"left","height":650,"framed":true,"parallax":false,"parallax_direction":"top"}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","disabled":true,"settings":{"title":"Simple Installation"}},"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1":{"type":"text","disabled":true,"settings":{"enlarge_text":true,"text":"<p>In four simple and fast steps, you can have your surface fully installed in minutes or less.<\/p><p><strong>Getting Started<\/strong><\/p><p>The panels have two sides with female PowerLocks, and two sides with male PowerLocks. All tiles on any given installation should always have the female PowerLocks going in the same direction.<\/p><p><strong>Step One<\/strong><\/p><p>Begin the installation by laying down your first panel in any one corner and pointing the female PowerLocks in the two directions that additional panels are to be added.<\/p><p><strong>Step Two<\/strong><\/p><p>Place the next panel so that the male PowerLock line up over the top of the female loops on the first panel. It's important to make sure that the female PowerLocks are facing exactly the same direction as the first panel.<\/p><p><strong>Step Three<\/strong><\/p><p>Gently step along the joint of the two panels. You will hear and feel the PowerLocks snap into place as you go.<\/p><p><strong>Step Four<\/strong><\/p><p>Once the two panels are joined, repeat steps one through three remembering to keep the female PowerLocks aligned until your floor is complete. That's all there is to this easy-to-install flooring!<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"testimonials":{"type":"testimonials","blocks":{"testimonials-0":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}}},"block_order":["testimonials-0","testimonials-1","testimonials-2"],"disabled":true,"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#f9f9f9","color_text":"#1c1d1d"}},"8dee5b19-f3b7-478f-9187-7d6dbce1c9ab":{"type":"hero-video","settings":{"title":"Everlife chairmats","title_size":70,"subheading":"Protect your floors against damage from office chairs while improving comfort and mobility","link_text":"","link":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","video_url":"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/ES_Robbins_Chair_1.mp4?v=1593214568","overlay_opacity":0,"section_height":"650px","mobile_height":"auto"}},"f7c3225f-e625-4856-a697-866928ef710b":{"type":"rich-text","blocks":{"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0":{"type":"heading","settings":{"title":"carpet thickness"}},"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>Carpets have different levels of thickness. Use our diagram below to select the correct chair mat for you.<\/p>"}}},"block_order":["template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0","template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"1148b4e3-2cf6-42af-910e-9aa29caa2a70":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_22_21_609Z.png","image_width":700,"subtitle":"GARAGE CONTAINMENT MATS","title":"CONTAIN THE ELEMENTS","text":"<p>Rated for environment ranging between -40 degrees to +40 degrees Celsius. These mats are perfect for harsh winters.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_24_19_294Z.png","image_width":700,"subtitle":"GARAGE FLOOR PROTECTION","title":"NO MUDDY MESS","text":"<p>Dirt, Dust, and Debris are no problem as the Floor Defender Containment Mat catches it all and keeps it from being tracked into the house.<\/p><p>The Floor Defenders will hold up to 62 gallons of water at once and keep it off your floors until you are ready to safely empty it outside your garage.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"3eb2f88f-12e5-4f87-aabb-ad99d885f103":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_38_17_168Z.png","image_width":500,"subtitle":"GARAGE FLOOR PROTECTION MATS","title":"PROTECT AGAINST CHEMICALS","text":"<p>Keep oil, geese, anti-freeze, and other chemicals that may drain out of your car contained, and away from other possessions stored in the garage.<\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"081e0a07-01f6-4b1b-a2e4-130cff88c443":{"type":"text-columns","blocks":{"template--14487883284609__081e0a07-01f6-4b1b-a2e4-130cff88c443-167931168047b25a76-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_1_19218bda-9956-4be7-8356-17739ea37d45.png","image_width":500,"title":"low pile","text":"<p>If carpet thickness is about 3\/8'' thick or lower<\/p>","button_label":"Low Pile Mat","button_link":"shopify:\/\/products\/everlife-chairmat-low"}},"template--14487883284609__081e0a07-01f6-4b1b-a2e4-130cff88c443-167931168047b25a76-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_2_125d2a48-91e0-4927-b00a-39d40e2a8e33.png","image_width":500,"title":"medium pile","text":"<p>If carpet thickness is about 3\/4'' thick or lower<\/p>","button_label":"Medium Pile Mat","button_link":"shopify:\/\/products\/everlife-chairmat-med"}},"template--14487883284609__081e0a07-01f6-4b1b-a2e4-130cff88c443-167931168047b25a76-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_3_4914d4b4-605a-4043-9ba3-458e6b95bd23.png","image_width":500,"title":"high pile","text":"<p>If carpet thickness is about 1'' thick or lower<\/p>","button_label":"High Pile Mat","button_link":"shopify:\/\/products\/everlife-chairmat-high"}}},"block_order":["template--14487883284609__081e0a07-01f6-4b1b-a2e4-130cff88c443-167931168047b25a76-0","template--14487883284609__081e0a07-01f6-4b1b-a2e4-130cff88c443-167931168047b25a76-
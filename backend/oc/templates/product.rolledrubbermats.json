tab","contact","description","share"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"flexible","thumbnail_arrows":false,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"promo_grid_MXazFM":{"type":"promo-grid","blocks":{"banner_KtwbkP":{"type":"banner","settings":{"heading":"Need more help?","text":"Contact our sales department at (800) 624-0041","link":"https:\/\/canadamats.ca\/pages\/request-a-quote","label":"GET A QUOTE","color_tint":"#000000","color_tint_opacity":8,"framed":true}}},"block_order":["banner_KtwbkP"],"name":"t:sections.promo-grid.presets.promotional_grid.name","settings":{"full_width":false,"gutter_size":0,"space_above":false,"space_below":true}},"sub":{"type":"product-full-width","blocks":{"b117ab64-780e-4a47-80ae-6809122610dc":{"type":"description","settings":{"is_tab":false}}},"block_order":["b117ab64-780e-4a47-80ae-6809122610dc"],"settings":{"max_width":false}},"1148b4e3-2cf6-42af-910e-9aa29caa2a70":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/VersaThreadRolledRubberLF10.png","image_width":600,"subtitle":"Comfort and Safety","title":"Ideal for High-Traffic, Multi-Use Spaces","text":"<p>Our Rolled Rubber excels in high-traffic environments, offering a high-traction, cushioned surface that reduces slips and fatigue. Its moisture-resistant, easy-to-clean properties make it suitable for both indoor and outdoor use, supporting applications in<br\/><br\/>✔ Gyms<br\/>✔ High-Traffic Walkways<br\/>✔ Sports centers<br\/>✔ Retail areas<br\/>✔ Winter sports facilities<\/p><p>Designed for versatility, our Rolled Rubber enhances aesthetics while ensuring a comfortable, safe flooring experience.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f7c3225f-e625-4856-a697-866928ef710b":{"type":"rich-text","blocks":{"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0":{"type":"heading","settings":{"title":"Experience Unmatched quality with rolled rubber mats"}},"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>The Perfect Balance of Strength and Flexibility<\/p>"}}},"block_order":["template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0","template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"text_columns_cjDfQY":{"type":"text-columns","blocks":{"text_block_tNaQQc":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Flexibility-100.jpg","image_width":120,"title":"FLEXIBILITY","text":"<p>Our rubber rolls range from 6mm (1\/4\") to 12mm (1\/2\") in thickness and in lengths of 25 feet to 150 feet or in 28.5' x 28.5' interlocking tiles. Custom lengths and thicknesses available upon request.<\/p>","button_label":"","button_link":""}},"text_block_UWQ6Gp":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/comfort-100.jpg","image_width":120,"title":"COMFORT & SOUND ABSORPTION","text":"<p>Designed to provide comfort underfoot to strain on feet, legs and joints of users while minimizing noise in heavy traffic areas.<\/p>","button_label":"","button_link":""}},"text_block_RjaPwz":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/slip_resistant-100.jpg","image_width":120,"title":"SLIP-RESISTANT","text":"<p>Provides a secure grip on various surfaces, making it highly effective in preventing slips, skids, and falls.<\/p>","button_label":"","button_link":""}},"text_block_9dgUbh":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/protection-100.jpg","image_width":120,"title":"PROTECTION","text":"<p>Reduces the risk of damage to equipment and sub-floors resulting from weight drops, cleated shoes and skate blades.<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_tNaQQc","text_block_UWQ6Gp","text_block_RjaPwz","text_block_9dgUbh"],"settings":{"title":"","align_text":"center","divider":false}},"text-and-image":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/VersaThreadRolledRubberLF1.png","image_width":600,"subtitle":"High-Performance Composition","title":"Sustainable Rubber Crafted for Durability","text":"<p>Rolled Rubber is made with recycled rubber content and colored EPDM granules, providing an eco-friendly flooring choice designed to endure high-impact use. Its innovative composition supports fitness and sports applications, with benefits that enhance both performance and user comfort:<\/p><ul><li><strong>Improved Indoor Air Quality:<\/strong> Non-vulcanized and low-odor design minimizes off-gassing, making it ideal for indoor settings.<\/li><li><strong>Long-Lasting Resilience:<\/strong> Engineered for high-impact activities, the recycled rubber withstands wear and tear, maintaining its appearance over time.<\/li><li><strong>Sustainable Choice:<\/strong> Made with recycled materials, VersaTREAD contributes to environmental sustainability without compromising durability or style.<\/li><\/ul>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"text_columns_R7BjUK":{"type":"text-columns","blocks":{"text_block_X9MqUe":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Flexibility-100.jpg","image_width":120,"title":"FLEXIBILITY","text":"<p>Our rubber rolls range from 6mm (1\/4\") to 12mm (1\/2\") in thickness and in lengths of 25 feet to 150 feet or in 28.5' x 28.5' interlocking tiles. Custom lengths and thicknesses available upon request.<\/p>","button_label":"","button_link":""}},"text_block_84K7LC":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/odor_reduction-100.jpg","image_width":120,"title":"ODOR REDUCTION","text":"<p>Ultimate's lower odor and minimal off-gassing makes it ideal for use in indoor spaces.<\/p>","button_label":"","button_link":""}},"text_block_gGR7p4":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/easy_instolation-100.jpg","image_width":120,"title":"COLOR OPTIONS","text":"<p>Available in 8 colors, our Rubber Rolls are manufactured from vivid EPDM color granules.<\/p>","button_label":"","button_link":""}},"text_block_3ryyMz":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/environmentally-100.jpg","image_width":120,"title":"ENVIRONMENTALLY FRIENDLY","text":"<p>Our Rubber Rolls are made with recycled rubber providing a sustainable, environmentally responsible resilient flooring solution.<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_X9MqUe","text_block_84K7LC","text_block_gGR7p4","text_block_3ryyMz"],"settings":{"title":"","align_text":"center","divider":false}},"328c4c0d-b22e-4a15-b3fe-0599c9f89681":{"type":"logo-list","blocks":{"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-0":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/1_14634a0f-2cb9-4f49-858c-d5b7507bdbba.jpg","link":""}},"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-1":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/2_25f476ab-48fe-4ac8-b43c-245223d14ba9.jpg","link":""}},"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-2":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/3_47f6a7e3-72c8-4171-a0bd-5915e360e
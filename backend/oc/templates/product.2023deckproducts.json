n  <thead>\n    <tr style=\"background-color: lightgray;\">\n      <th style=\"background-color: lightgray; text-align: center;\"><\/th>\n      <th style=\"background-color: lightgray; text-align: center;\">2' x 8'<\/th>\n      <th style=\"background-color: lightgray; text-align: center;\">4' x 8'<\/th>\n    <\/tr>\n  <\/thead>\n  <tbody>\n    <tr>\n      <th style=\"background-color: lightgray; text-align: center;\">Thickness<\/th>\n      <td colspan=\"2\" style=\"text-align: center;\">12 mm<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray; text-align: center;\">Weight<\/th>\n      <td style=\"text-align: center;\">38.5 lbs<\/td>\n      <td style=\"text-align: center;\">77 lbs<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray; text-align: center;\">Material<\/th>\n      <td colspan=\"2\" style=\"text-align: center;\">High Density Poly Ethylene<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray; text-align: center;\">Load Capacity<\/th>\n      <td colspan=\"2\" style=\"text-align: center;\">Up to 80 Tons (210psi) on hard surfaces<\/td>\n    <\/tr>\n  <\/tbody>\n<\/table>","width":"66%","alignment":"center"}}},"block_order":["template--14498159001729__0d72f363-ade5-4fe4-ba0e-abdaacb810a8-1684936863110cd631-0","template--14498159001729__0d72f363-ade5-4fe4-ba0e-abdaacb810a8-1684936863110cd631-1"],"disabled":true,"settings":{"full_width":false,"space_around":true}},"d1a405f0-7704-4ea8-9257-b4b072c901f3":{"type":"text-columns","blocks":{"template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Artboard_28-8_1.png","image_width":170,"title":"GREAT TRACTION","text":"<p>The mats have unique patterns that provide excellent traction, making it easy for machinery to move on any surface<\/p>","button_label":"","button_link":""}},"template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Artboard_26-8_1.png","image_width":170,"title":"HEAVY DUTY","text":"<p>These mats are designed to accommodate the weight of machinery as heavy as cranes and excavators<\/p>","button_label":"","button_link":""}},"template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Artboard_30-8_1.png","image_width":170,"title":"Long-lasting","text":"<p>The mats' impressive durability and resistance to moisture ensure they last a long time<\/p>","button_label":"","button_link":""}},"ccc66f1b-7578-492e-b5fd-2aa71ed0d44a":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Artboard_25_1-8_1.png","image_width":170,"title":"WEATHERPROOF","text":"<p>The mats are immune to mold, frost, and do not absorb water, maintaining their quality in various weather conditions<\/p>","button_label":"","button_link":""}},"c94e2d8f-729c-4554-acb2-0b692fdd36da":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Artboard_29-8_1.png","image_width":170,"title":"EASY TO CARRY","text":"<p>Designed to be easily carried and transported<\/p>","button_label":"","button_link":""}}},"block_order":["template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-0","template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-1","template--14498159001729__d1a405f0-7704-4ea8-9257-b4b072c901f3-16851408782a3382ed-2","ccc66f1b-7578-492e-b5fd-2aa71ed0d44a","c94e2d8f-729c-4554-acb2-0b692fdd36da"],"settings":{"title":"","align_text":"center","divider":false}},"bf2a28ec-f9a5-4f16-890f-58be7e189d2f":{"type":"rich-text","blocks":{"template--14498159001729__bf2a28ec-f9a5-4f16-890f-58be7e189d2f-168494678495535239-0":{"type":"heading","settings":{"title":"{{ product.metafields.custom.rich_text_hea
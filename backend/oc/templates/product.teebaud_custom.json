"59dee446-43ce-4ef6-aea9-a20662917dfc","a37e2cbe-87d7-4c66-923f-23eaee50efdb","9cc31818-34fd-4e15-a302-d4205455ec62","separator","variant_picker","sales_point","inventory_status","1766752a-b20c-4b5c-b87f-0f6e4a00d968","buy_buttons","cd68ae15-7254-437b-949b-9b69be701f4b","tab","contact","description"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"flexible","thumbnail_arrows":false,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"promo_grid_BEP6Rm":{"type":"promo-grid","blocks":{"banner_XmMniN":{"type":"banner","settings":{"heading":"Need more help?","text":"Contact our sales department at (800) 624-0041","link":"https:\/\/canadamats.ca\/pages\/request-a-quote","label":"GET A QUOTE","color_tint":"#000000","color_tint_opacity":8,"framed":true}}},"block_order":["banner_XmMniN"],"name":"t:sections.promo-grid.presets.promotional_grid.name","settings":{"full_width":false,"gutter_size":0,"space_above":false,"space_below":true}},"sub":{"type":"product-full-width","blocks":{"2cbc8d9e-93ff-4951-be79-975c6021ab8c":{"type":"description","settings":{"is_tab":false}}},"block_order":["2cbc8d9e-93ff-4951-be79-975c6021ab8c"],"settings":{"max_width":false}},"ded999a6-ed2a-489e-a02a-7449ce727ed7":{"type":"slideshow","blocks":{"template--14491778842753__ded999a6-ed2a-489e-a02a-7449ce727ed7-1683553412cb816e6c-0":{"type":"image","settings":{"top_subheading":"","title":"CREATE A\nSAFER FLOOR","title_size":60,"subheading":"Works on both carpet & hard floors","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/Teebaud_7_bd0db653-4a7d-426d-9fbb-17d3cd1c7382.jpg","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14491778842753__ded999a6-ed2a-489e-a02a-7449ce727ed7-1683553412cb816e6c-0"],"settings":{"section_height":"650px","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"2fdf84c3-6a13-4a11-9b4c-ef6fd1d2f03b":{"type":"background-image-text","disabled":true,"custom_css":[".background-media-text__text {text-align: right; font-size: 1.8em; background: var(--shopify-editor-setting-color_body_bg); background: #ffffff00; padding: 50px; width: 1000px; margin-top: 300px; color: white;}",".h3,h3 {font-size: 50px;}"],"settings":{"subtitle":"","title":"CREATE ASAFER FLOOR","text":"<p>Works on both carpet & hard floors<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/Teebaud_7_bd0db653-4a7d-426d-9fbb-17d3cd1c7382.jpg","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"text-and-image":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/Teebaud_4_6eb9532b-fc36-4a28-a3fe-b7f83c493635.jpg","image_width":500,"subtitle":"","title":"WORKS ON HARD FLOORS","text":"<p>The gray side is ideal for use on hard floor such as marble, hardwood, ceramic, vinyl or stone. Teebaud adheres firmly to your rug and floor.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"text-and-image2":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/Teebaud_2_01e82ae5-6109-4d0c-aaa2-25235c0fdd89.jpg","image_width":500,"subtitle":"Flip it over and it also","title":"WORKS ON CARPET","text":"<p>Teebaud adheres firmly to your rug and carpet and so helps to prevent slipping or falling over.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"12ee58e8-5133-4e52-a73b-887b18d27f7f":{"type":"background-image-text","settings":{"subtitle":"","title":"","text":"<p>The light cushioning effect allows the pad and the rug to breathe together with no risk of oxidation or discoloration to any flooring surface.<\/p><p><\/p><p><strong>TEEBAUD’s<\/strong> two components, containing <strong>12 ounces of fiber per square yard<\/strong>, gives to the pad enough body and density to resist the horizontal movement that creates the buckling effect of the underlay under the rug.<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/Teebaud_8_9a10a493-d20c-4cd9-8515-6e5a6725dde6.jpg","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","disabled":true,"settings":{"title":"Simple Installation"}},"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1":{"type":"text","disabled":true,"settings":{"enlarge_text":true,"text":"<p>In four simple and fast steps, you can have your surface fully installed in minutes or less.<\/p><p><strong>Getting Started<\/strong><\/p><p>The panels have two sides with female PowerLocks, and two sides with male PowerLocks. All tiles on any given installation should always have the female PowerLocks going in the same direction.<\/p><p><strong>Step One<\/strong><\/p><p>Begin the installation by laying down your first panel in any one corner and pointing the female PowerLocks in the two directions that additional panels are to be added.<\/p><p><strong>Step Two<\/strong><\/p><p>Place the next panel so that the male PowerLock line up over the top of the female loops on the first panel. It's important to make sure that the female PowerLocks are facing exactly the same direction as the first panel.<\/p><p><strong>Step Three<\/strong><\/p><p>Gently step along the joint of the two panels. You will hear and feel the PowerLocks snap into place as you go.<\/p><p><strong>Step Four<\/strong><\/p><p>Once the two panels are joined, repeat steps one through three remembering to keep the female PowerLocks aligned until your floor is complete. That's all there is to this easy-to-install flooring!<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"testimonials":{"type":"testimonials","blocks":{"testimonials-0":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}}},"block_order":["testimonials-0","testimonials-1","testimonials-2"],"disabled":true,"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#f9f9f9","color_text":"#1c1d1d"}},"8dee5b19-f3b7-478f-9187-7d6dbce1c9ab":{"type":"hero-video","disabled":true,"settings":{"title":"SNOW, MUD\n& DAMAGE","title_size":60,"subheading":"CONTAIN THEM WITH THE FLOOR DEFENDER","link_text":"","link":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","video_url":"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/205bf0dd43474cadbc436af39a1133dd.mp4","overlay_opacity":0,"section_height":"650px","mobile_height":"auto"}},"f7c3225f-e625-4856-a697-866928ef710b":{"type":"rich-text","blocks":{"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0":{"type":"heading","settings":{"title":"REGULAR VS PRO GRADE MATS"}},"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>The underside of Floor Defender Pro Garage Containment Mats features a tatami grain pattern for increased traction. This patterned backing prevents these mats from lifting and allows them to retain their shape over extended periods of time. Also, the tatami grain patterned backing produces a smoother, less wrinkled surface than the smooth backed regular Floor Defender Garage Containment Mats.<\/p>"}}},"block_order":["template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0","template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"1148b4e3-2cf6-42af-910e-9aa29caa2a70":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_22_21_609Z.png","image_width":700,"subtitle":"GARAGE CONTAINMENT MATS","title":"CONTAIN THE ELEMENTS","text":"<p>Rated for environment ranging between -40 degrees to +40 degrees Celsius. These mats are perfect for harsh winters.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"49e1522d-4e00-4356-91df-3d3dbada5a3e":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_45_06_105Z.png","image_width":500,"subtitle":"","title":"SIMPLE & COMPACT STORAGE","text":"<p>Although the Floor Defender Mats can be used year round, some of our customers prefer to only have the mats out in the winter.<\/p><p>Storing these mats after winter is incredibly easy. Simply roll them back up into a compact size and store it way in your garage.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"e98b186a-cb19-48cb-8775-57d1b1ee5ebe":{"type":"rich-text","blocks":{"19395395-ab98-4ad2-8cb6-274c48ffe6a1":{"type":"heading","settings":{"title":"Frequently Asked Questions"}},"c2c28a4a-2065-470b-9375-0248492fed55":{"type":"text","settings":{"enlarge_text":true,"text":"<p><a href=\"https:\/\/canadamats.ca\/pages\/frequently-asked-questions-floor-defender-garage-containment-mats\" target=\"_blank\" title=\"https:\/\/canadamats.ca\/pages\/frequently-asked-questions-floor-defender-garage-containment-mats\"><strong>Got Questions? Learn more about our Floor Defender Garage Continment Mats ❗HERE<\/strong><\/a>❗<\/p>"}}},"block_order":["19395395-ab98-4ad2-8cb6-274c48ffe6a1","c2c28a4a-2065-470b-9375-0248492fed55"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"product-recommendations":{"type":"product-recommendations","settings":{"show_product_recommendations":true,"product_recommendations_heading":"You may also like","related_count":5}},"recently-viewed":{"type":"recently-viewed","settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}},"1681304396c259475e":{"type":"apps","blocks":{"08afedf9-d403-440e-ab66-a752c69611cf":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":""}}},"block_order":["08afedf9-d403-440e-ab66-a752c69611cf"],"settings":{"full_width":false,"space_around":true}}},"order":["main","promo_grid_BEP6Rm","sub","ded999a6-ed2a-489e-a02a-7449ce727ed7","2fdf84c3-6a13-4a11-9b4c-ef6fd1d2f03b","text-and-image","text-and-image2","12ee58e8-5133-4e52-a73b-887b18d27f7f","0cdbf87b-3e79-4778-b332-d27fd5320
ht":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"94c7b3df-d4cc-494e-844f-893c7782e65e":{"type":"text-columns","blocks":{"template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-0":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/bdrako_2_1_1080x_85fa4103-8760-47c7-803b-6c58ff0efd2f.jpg","image_width":650,"title":"drako martial arts crash mat","text":"<p>High-density Drako Martial Arts Crash Mats offer robust protection, making them ideal for falls, tumbles, or general groundwork. A prime choice for injury prevention in various martial arts disciplines or high intensity.<\/p><p>Mat Thickness: 8\"<\/p><p><em>Starting at <\/em><em><strong>$9.53\/Sq ft.<\/strong><\/em><\/p>","button_label":"buy drako crash mats","button_link":"shopify:\/\/products\/drako-martial-arts-crash-mat"}},"template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/sc_1080x_5ee60449-00e3-4b08-8903-01e94d516e09.jpg","image_width":650,"title":"safety cushions","text":"<p>Made with a honeycomb foam and vinyl surface to offer durability and ultimate landing protection. These are perfect during gymnastics and cheerleading training.<br\/><br\/>Mat Thickness: Available from 10\" up to 30\"<\/p><p><em>Starting at <\/em><em><strong>$27.97\/sq ft.<\/strong><\/em><\/p>","button_label":"buy safety cushions","button_link":"shopify:\/\/products\/safety-cushions"}},"template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/competition_landing_a03ac18a-cb24-46b2-b051-143e83d9a6dc.png","image_width":650,"title":"Competition landing mats","text":"<p>These mats combine the firmness of cross-link polyethylene to support stable footing with the flexibility of polyurethane foam as a bottom layer, providing enough cushion for optimal shock absorption.<br\/><br\/>Mat Thickness: Available in 12cm & 20cm<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$25.25\/sq ft.<\/strong><\/em><\/p>","button_label":"buy competition landing mats","button_link":"shopify:\/\/products\/competition-landing-mats"}},"68028e00-dc30-4cd8-8329-b5c1dd1d5649":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Throw-Mats_aa4da9dc-9b56-4b99-86a7-c0770febcfe2.jpg","image_width":650,"title":"Throw mats","text":"<p>These Throw Mats are made out of heavy-duty 18 oz, vinyl that can offer extra cushioning that is ideal for a more protective landing. These mats are great for absorbing jumps in activities such as gymnastics.<br\/><br\/>Mat thickness: 4\"<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$22.81\/sq ft.<\/strong><\/em><\/p>","button_label":"buy THROW mats","button_link":"shopify:\/\/products\/throw-mats"}}},"block_order":["template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-0","template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-1","template--14486593667201__94c7b3df-d4cc-494e-844f-893c7782e65e-1678206284db50f2e2-2","68028e00-dc30-4cd8-8329-b5c1dd1d5649"],"disabled":true,"settings":{"title":"","align_text":"center","divider":false}},"c7046369-9f17-482f-a591-b29308036a19":{"type":"featured-collection","disabled":true,"settings":{"title":"All Martial Arts Mats","home_featured_products":"martial-arts-mats","per_row":5,"rows":5,"mobile_scrollable":true,"view_all":false,"divider":false}},"772219f6-37a8-4e76-b1bc-a343f5e417de":{"type":"promo-grid","blocks":{"a889990e-3020-4401-8a7c-ae2d50b65d79":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/REBIRTHLifestyle1.png","link":"","width":"33"}},"c6956fc2-ea3f-4a46-8bf2-3c856846a582":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/SourceLifestyleimage2.png","link":"","width":"33"}},"image_mbMf9L":{"type":"image","setting
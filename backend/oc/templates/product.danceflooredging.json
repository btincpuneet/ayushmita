1038e297f1e6","27fa8671-3590-4e2f-829e-4bdcb8367ed1"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"flexible","thumbnail_arrows":false,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"promo_grid_YiNUPM":{"type":"promo-grid","blocks":{"banner_hcGxpi":{"type":"banner","settings":{"heading":"Need more help?","text":"Contact our sales department at (800) 624-0041","link":"https:\/\/canadamats.ca\/pages\/request-a-quote","label":"GET A QUOTE","color_tint":"#000000","color_tint_opacity":8,"framed":true}}},"block_order":["banner_hcGxpi"],"name":"t:sections.promo-grid.presets.promotional_grid.name","settings":{"full_width":false,"gutter_size":0,"space_above":false,"space_below":true}},"sub":{"type":"product-full-width","blocks":{"8749a105-f5ed-4455-9273-0c50c4c8ec20":{"type":"description","settings":{"is_tab":false}}},"block_order":["8749a105-f5ed-4455-9273-0c50c4c8ec20"],"settings":{"max_width":false}},"7ce2c581-2643-4a8c-ae8b-67ce8351b0d0":{"type":"promo-grid","blocks":{"cfb49439-8ccf-461c-af1d-00ef97054059":{"type":"banner","settings":{"heading":"Dance Floor Tiles","text":"our Dance Floors with a waterproof wood grain surface are your perfect choice.","link":"shopify:\/\/products\/event-and-dance-floor-kits","label":"BUY dance floor tiles","color_tint":"#848484","color_tint_opacity":4,"framed":true}}},"block_order":["cfb49439-8ccf-461c-af1d-00ef97054059"],"settings":{"full_width":false,"gutter_size":7,"space_above":false,"space_below":false}},"text-and-image2":{"type":"text-and-image","disabled":true,"custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_09T11_26_54_262Z.png","image_width":400,"subtitle":"","title":"WHEELED CART STORAGE","text":"<p>Pair large text with an image to tell a story, explain a detail about your product, or describe a new promotion.Specially designed cart for safe and convenient storage of your portable floor, minimal space required! A perfect tool to store and transport the 21′ X 21′ dance floors <\/p>","button_label":"buy wheeled cart storage","button_link":"shopify:\/\/products\/wheeled-cart-storage","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"text-and-image":{"type":"text-and-image","disabled":true,"custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_09T11_24_58_420Z.png","image_width":350,"subtitle":"","title":"Finished edges","text":"<p>Complete your floor’s look with optional finished edges. The edges <em>“snap”<\/em> into place using the same interlocking system as the dance flooring tiles and provide a clean, beveled border around your dance floor.<\/p>","button_label":"buy dance floor edging","button_link":"shopify:\/\/products\/dance-floor-edging","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"9f19a8ea-a128-403a-940e-ccbd6129ee1b":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/MapleXL-4-920x614-600x600_c.jpg","image_width":700,"subtitle":"From Setup to Showcase","title":"Simplifying Dance Floors","text":"<p>Regardless of your venue's terrain - be it grass, sand, or any solid ground, our dance flooring has been meticulously crafted to transform any space into a vibrant dance floor in an instant. It showcases the perfect fusion of form and functionality, combining an easy, tool-free assembly process with a durable, all-weather design that stands up to the most rigorous dance routines.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"782b8b0d-3204-481c-b7c7-24cfd92fc04c":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/Add_a_heading_7.jpg","image_width":700,"subtitle":"with EASY TO INSTALL","title":"INTERLOCKING PANELS","text":"","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"5e6ff3b5-cb52-41d8-9a1d-60e29bbd2a2f":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/dkk-maple-plus-dance-floor-tent.jpg","image_width":700,"subtitle":"","title":"YOUR FLOOR READY IN MINUTES!","text":"<p>Lightweight, easy-to-install, and featuring interlocking edges for stability, these tiles provide a safe, high-traction surface that's ideal for dance or fitness studios.<\/p>","button_label":"Buy Dance floors","button_link":"shopify:\/\/products\/event-and-dance-floor-kits","button_label2":"","button_link2":"","button_style":"primary","align_text":"center","layout":"left","divider":false}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","settings":{"title":"Floor Setup Simplified: Just 4 Steps"}},"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1":{"type":"text","disabled":true,"settings":{"enlarge_text":true,"text":"<p>In four simple and fast steps, you can have your surface fully installed in minutes or less.<\/p><p><strong>Getting Started<\/strong><\/p><p>The panels have two sides with female PowerLocks, and two sides with male PowerLocks. All tiles on any given installation should always have the female PowerLocks going in the same direction.<\/p><p><strong>Step One<\/strong><\/p><p>Begin the installation by laying down your first panel in any one corner and pointing the female PowerLocks in the two directions that additional panels are to be added.<\/p><p><strong>Step Two<\/strong><\/p><p>Place the next panel so that the male PowerLock line up over the top of the female loops on the first panel. It's important to make sure that the female PowerLocks are facing exactly the same direction as the first panel.<\/p><p><strong>Step Three<\/strong><\/p><p>Gently step along the joint of the two panels. You will hear and feel the PowerLocks snap into place as you go.<\/p><p><strong>Step Four<\/strong><\/p><p>Once the two panels are joined, repeat steps one through three remembering to keep the female PowerLocks aligned until your floor is complete. That's all there is to this easy-to-install flooring!<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"a281eca1-e986-4448-b78b-e0b4a9b515bf":{"type":"text-columns","blocks":{"template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/easy-to-install-flooring-step-one_f1217054-5bf3-42e2-b047-cd39094e11e4.jpg","image_width":650,"title":"Step One","text":"<p>Begin the installation by laying down your first panel in any one corner and pointing the female PowerLocks in the two directions that additional panels are to be added.<\/p>","button_label":"","button_link":""}},"template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/aligning-dance-floor-panels-for-installation_b25003cb-7d91-44e3-b20f-d828fb107461.jpg","image_width":650,"title":"Step two","text":"<p>Place the next panel so that the male PowerLock line up over the top of the female loops on the first panel. It’s important to make sure that the female PowerLocks are facing exactly the same direction as the first panel.<\/p>","button_label":"","button_link":""}},"template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/snapping-powerlocks-together_e5cf1203-7948-4105-8476-1e7c83c0c309.jpg","image_width":650,"title":"Step Three","text":"<p>Gently step along the joint of the two panels. You will hear and feel the PowerLocks snap into place as you go.<\/p>","button_label":"","button_link":""}},"7fbeb2ff-c3dc-40dc-8f08-461ab7c566d9":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/easy-to-install-flooring-step-four_129af8e8-2ac6-4fed-920f-cad5632e9390.jpg","image_width":650,"title":"Step Four","text":"<p>Once the two panels are joined, repeat steps one through three remembering to keep the female PowerLocks aligned until your floor is complete.<\/p><h3>That’s all there is to this easy-to-install flooring!<\/h3>","button_label":"","button_link":""}}},"block_order":["template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-0","template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-1","template--14491777335425__a281eca1-e986-4448-b78b-e0b4a9b515bf-1686000777ed1c93e6-2","7fbeb2ff-c3dc-40dc-8f08-461ab7c566d9"],"settings":{"title":"","align_text":"center","divider":false}},"7e2e31f4-8d25-4e24-8a8a-ff6eb1f4cbfc":{"type":"slideshow","blocks":{"template--14491777335425__7e2e31f4-8d25-4e24-8a8a-ff6eb1f4cbfc-1686006296f7935651-0":{"type":"image","settings":{"top_subheading":"","title":"Where Convenience Meets Performance","title_size":60,"subheading":"Dance Floors Made Easy","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","image":"shopify:\/\/shop_images\/hauser-hill-event-center-02.jpg","parallax_direction":"top","overlay_opacity":30,"focal_point":"center center"}}},"block_order":["template--14491777335425__7e2e31f4-8d25-4e24-8a8a-ff6eb1f4cbfc-1686006296f79356
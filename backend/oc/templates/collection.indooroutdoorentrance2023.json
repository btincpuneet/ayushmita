set=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Matting Product Selector<\/title>\n    <style>\n        table {\n            border-collapse: collapse;\n        }\n        table, th, td {\n            border: 1px solid black;\n        }\n        th, td {\n            padding: 10px;\n            text-align: center;\n        }\n        .mat-list {\n            display: none;\n        }\n        .mat-list.active {\n            display: block;\n        }\n    <\/style>\n<\/head>\n<body>\n    <table>\n        <tr>\n            <th><\/th>\n            <th>A<\/th>\n            <th>B<\/th>\n        <\/tr>\n        <tr>\n            <th>X<\/th>\n            <td><a href=\"javascript:void(0);\" onclick=\"showMats('A')\">Select A Mats<\/a><\/td>\n            <td><a href=\"javascript:void(0);\" onclick=\"showMats('B')\">Select B Mats<\/a><\/td>\n        <\/tr>\n        <tr>\n            <th>Y<\/th>\n            <td><a href=\"javascript:void(0);\" onclick=\"showMats('C')\">Select C Mats<\/a><\/td>\n            <td><a href=\"javascript:void(0);\" onclick=\"showMats('D')\">Select D Mats<\/a><\/td>\n        <\/tr>\n    <\/table>\n    \n    <div class=\"mat-list\" id=\"matA\">\n        <!-- List of A Mats -->\n        <ul>\n            <li>Mat A1<\/li>\n            <li>Mat A2<\/li>\n        <\/ul>\n    <\/div>\n    \n    <div class=\"mat-list\" id=\"matB\">\n        <!-- List of B Mats -->\n        <ul>\n            <li>Mat B1<\/li>\n            <li>Mat B2<\/li>\n        <\/ul>\n    <\/div>\n    \n    <div class=\"mat-list\" id=\"matC\">\n        <!-- List of C Mats -->\n        <ul>\n            <li>Mat C1<\/li>\n            <li>Mat C2<\/li>\n        <\/ul>\n    <\/div>\n    \n    <div class=\"mat-list\" id=\"matD\">\n        <!-- List of D Mats -->\n        <ul>\n            <li>Mat D1<\/li>\n            <li>Mat D2<\/li>\n        <\/ul>\n    <\/div>\n    \n    <script>\n        function showMats(type) {\n            \/\/ Hide all mat lists\n            document.querySelectorAll('.mat-list').forEach(function(matList) {\n                matList.classList.remove('active');\n            });\n\n            \/\/ Show the selected mat list\n            document.getElementById('mat' + type).classList.add('active');\n        }\n    <\/script>\n<\/body>\n<\/html>","width":"100%","alignment":"center"}}},"block_order":["template--14543725756545__3bfc80a5-45b5-446b-bf99-12a2ebb83951-liquid-1"],"settings":{"full_width":false,"space_around":true}}},"order":["collection-header","promo-grid","826080eb-f5ab-4a44-b429-9c4a05a4c3fc","main-collection","3bfc80a5-45b5-446b-bf99-12a2ebb83951"]}
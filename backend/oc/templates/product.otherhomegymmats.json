,"divider":false}},"328c4c0d-b22e-4a15-b3fe-0599c9f89681":{"type":"logo-list","blocks":{"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-0":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/1_03d8da70-6394-4eec-8d38-627c617e4b78.png","link":""}},"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-1":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/2_70935699-f467-47a0-8df9-6b01717df7e3.png","link":""}},"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-2":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/3_e3c37f5c-8d93-4d4f-8a4f-099f8231adf9.png","link":""}},"template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-3":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/4_12cec760-6148-49c1-adda-b7d4da9fccc6.png","link":""}}},"block_order":["template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-0","template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-1","template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-2","template--14491778023553__328c4c0d-b22e-4a15-b3fe-0599c9f89681-16856368552b0dcea8-3"],"disabled":true,"settings":{"title":"","logo_opacity":100,"divider":false}},"fd4f0100-3551-4159-8fb5-2ded36cfab80":{"type":"slideshow","blocks":{"template--14491778023553__fd4f0100-3551-4159-8fb5-2ded36cfab80-1685550678ab0547b4-0":{"type":"image","settings":{"top_subheading":"","title":"Elevate Your Space","title_size":60,"subheading":"with Vulcanized Rubber Flooring","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-left","image":"shopify:\/\/shop_images\/next_level_flooring.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14491778023553__fd4f0100-3551-4159-8fb5-2ded36cfab80-1685550678ab0547b4-0"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","settings":{"title":"VULCANIZED FLOORING VS. POLYURETHANE FLOORING"}},"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>Discover the Unmatched Excellence of Vulcanized Rubber Flooring for Elite Gyms and Sports Facilities<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"ee9ab566-ada6-4b02-9b17-0b54db0bd62c":{"type":"advanced-content","blocks":{"template--14491778023553__ee9ab566-ada6-4b02-9b17-0b54db0bd62c-16853617405f3c542a-1":{"type":"liquid","settings":{"code":"<table>\n  <thead>\n    <tr style=\"background-color: lightgray;\">\n      <th style=\"background-color: lightgray;\"><\/th>\n      <th style=\"background-color: lightgray; text-align: center;\">Vulcanized Products<\/th>\n      <th style=\"background-color: lightgray; text-align: center;\">Urethane Bound Products<\/th>\n    <\/tr>\n  <\/thead>\n  <tbody>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/durability.png?v=1685465529\" alt=\"Durability\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">\n  Durability\n<\/th>\n      <td style=\"text-align: center;\">Hard wearing and durable<\/td>\n      <td style=\"text-align: center;\">With heavy\/continuous use product deteriorates<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/porosity.png?v=1685465530\" alt=\"Porosity\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Porosity<\/th>\n      <td style=\"text-align: center;\">Does not absorb liquid<\/td>\n      <td style=\"text-align: center;\">Liquids (water, perspiration, sport drinks) absorb into pores between rubber particles<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/finish_sealers.png\" alt=\"Finish\/Sealers\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Finish\/Sealers<\/th>\n      <td style=\"text-align: center;\">Not required<\/td>\n      <td style=\"text-align: center;\">Required to close pores from absorbing liquids<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/maintenance.png?v=1685465529\" alt=\"Maintenance\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Maintenance<\/th>\n      <td style=\"text-align: center;\">Smooth top surface makes mopping\/cleaning easy<\/td>\n      <td style=\"text-align: center;\">Rough\/porous top makes cleaning more difficult - mops 'stick' to it<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/cleanliness.png?v=1685465529\" alt=\"Cleanliness\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Cleanliness<\/th>\n      <td style=\"text-align: center;\">Does not harbour bacteria<\/td>\n      <td style=\"text-align: center;\">Porous surface allows bacteria to penetrate and spread<\/td>\n    <\/tr>\n   <\/tbody>\n<\/table>","width":"100%","alignment":"center"}}},"block_order":["template--14491778023553__ee9ab566-ada6-4b02-9b17-0b54db0bd62c-16853617405f3c542a-1"],"settings":{"full_width":false,"space_around":true}},"2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9":{"type":"text-columns","blocks":{"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vulcanized_gym_floor.png","image_width":650,"title":"What is Vulcanization?","text":"<p>Vulcanization is the process of transforming raw rubber into a durable cured material through cross-linking of polymer chains under high heat and pressure.<\/p>","button_label":"","button_link":""}},"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/How_vulcanized_rubber_is_made_2_e812fb9e-c44b-4266-93bb-b350ab9f756f.png","image_width":650,"title":"How is Vulcanized Flooring Made?","text":"<p>End-of-life tires are recycled into tire crumb rubber, which is molded and vulcanized under high heat and pressure to create the final product.<\/p>","button_label":"","button_link":""}},"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-2":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image_width":650,"title":"WHY DO WE VULCANIZE?","text":"<p>Vulcanized rubber flooring is highly durable and dense with a strong bond between fine crumb rubber particles. It's non-porous, resisting moisture absorption from ice, drinks, cleaning liquids, and perspiration. Unlike polyurethane rubber, it's up to 20 times less absorbent, making maintenance easier as liquids stay on the surface. Its non-porous nature inhibits bacterial growth, reducing the risk of infections. Third-party testing confirms NWR vulcanized rubber flooring eliminates 99.5% of microbial build-up with simple cleaning.<\/p>","button_label":"","button_link":""}}},"block_order":["template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-0","template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-1","template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-2"],"settings":{"title":"","align_text":"center","divider":false}},"text-and-image":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/vulcanized_gym_flooring.png","image_width":700,"subtitle":"","title":"WHY DO WE VULCANIZE?","text":"<ul><li>Vulcanized rubber flooring is <strong>highly durable and dense<\/strong> with a strong bond between fine crumb rubber particles. <\/li><li>It's non-porous, <strong>resisting moisture absorption<\/strong> from ice, drinks, cleaning liquids, and perspiration. <\/li><li>Unlike polyurethane rubber, it's <strong>up to 20 times less absorbent<\/strong>, making maintenance easier as liquids stay on the surface. <\/li><li>Its non-porous nature <strong>inhibits bacterial growth<\/strong>, reducing the risk of infections. <\/li><li>Third-party testing confirms <strong>vulcanized rubber flooring eliminates 99.5% of microbial build-up<\/strong> with simple cleaning.<\/li><\/ul>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"48a0bdef-8092-498f-8877-bc3b04c05166":{"type":"rich-text","blocks":{"template--14491778023553__48a0bdef-8092-498f-8877-bc3b04c05166-168554474396c33494-0":{"type":"heading","settings":{"title":"Rich text"}},"template--14491778023553__48a0bdef-8092-498f-8877-bc3b04c05166-168554474396c33494-1":{"type":"text","disabled":true,"settings":{"enlarge_text":true,"text":"<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.<\/p>"}}},"block_order":["template--14491778023553__48a0bdef-8092-498f-8877-bc3b04c05166-168554474396c33494-0","template--14491778023553__48a0bdef-8092-498f-8877-bc3b04c05166-168554474396c33494-1"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"cb654345-0288-483c-97d7-cdd6f500edee":{"type":"logo-list","blocks":{"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-1":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_1.value }}","link":""}},"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-0":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_2.value }}","link":""}},"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-2":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_3.value }}","link":""}}},"block_order":["template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-1","template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-0","template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-2"],"disabled":true,"settings":{"title":"{{ product.metafields.custom.logo_list_heading.value }}","logo_opacity":76,"divider":false}},"8bd18c70-81ee-42a1-bed3-542a7d64c395":{"type":"text-and-image","disabled":true,"settings":{"image_width":700,"subtitle":"","title":"Image with text","text":"<p>Pair large text with an image to tell a story, explain a detail about your product, or describe a new promotion.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"4f5eac09-4703-41cd-8c98-7f7ae60f5938":{"type":"faq","blocks":{"5df8823c-afeb-46c7-91e3-01d7d08f11e2":{"type":"question","settings":{"title":"What are the benefits of using vulcanized rubber flooring for my gym?","text":"<p>Vulcanized rubber gym flooring offers a multitude of benefits for your gym. Its superior durability makes it ideal for high-traffic areas and heavy-duty workouts, including weightlifting and cardio exercises. This resilience stems from the vulcanization process, which enhances the strength and elasticity of the rubber.<\/p><p>Vulcanized rubber flooring provides an excellent grip and stable surface, reducing the risk of slips and falls during workouts, contributing to a safer exercise environment. Its high-density structure also ensures excellent impact absorption, protecting your gym's subfloors from damage due to dropped weights.<\/p><p>This type of flooring is resistant to moisture and easy to clean, making gym maintenance simpler. It's also available in various colours and patterns, allowing you to customize your gym's aesthetic.<\/p><p>Our gym flooring is made from vulcanized virgin rubber. It is recycled and making it an eco-friendly choice for your gym.<\/p>"}},"template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-1":{"type":"question","settings":{"title":"What is the difference between vulcanized gym flooring and traditional polyurethane (foam) gym flooring? Which one offers superior performance?","text":"<p>Foam and rubber gym flooring tiles cater to different fitness needs. Foam tiles, with their softness, are ideal for floor exercises like sit-ups and planks, or for creating safe play areas for children. However, if you plan to install cardio or strength training equipment such as treadmills, weight machines, dumbbells, barbells, or squat racks, we highly recommend our Stamina gym flooring. Its durability and stability provide the perfect lifting surface for exercises like deadlifts, squats, and bench presses. Additionally, rubber gym flooring offers a stable base for cardio and strength machines, ensuring they remain sturdy and don't leave imprints on the floor beneath, no matter how much weight is applied. This ensures that your underlying floor is always protected.<\/p>"}},"template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-0":{"type":"question","settings":{"title":"What is the required quantity of Gym Flooring for my space, and how can I measure it accurately? What factors should I consider when choosing this durable, easy-to-clean flooring option for my fitness area?","text":"<p>To figure out the amount of Gym Flooring you'll need, simply measure the length and width of your desired gym area. This calculation will give you the floor coverage area. Please also consider factors such as your existing floor type, room shape, room temperature, and even provide cost-effective layout suggestions. <\/p>"}}},"block_order":["5df8823c-afeb-46c7-91e3-01d7d08f11e2","template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-1","template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-0"],"settings":{"title":"FAQs"}},"f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9":{"type":"slideshow","blocks":{"template--14491778023553__f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9-168329114236b7c3f0-0":{"type":"image","settings":{"top_subheading":"","title":"workout with confidence","title_size":50,"subheading":"Go all out, knowing your floors are protected.","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/victor-freitas-qZ-U9z4TQ6A-unsplash_12_1.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14491778023553__f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9-168329114236b7c3f0-0"],"settings":{"section_height":"650px","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"e4a12b9c-5bf3-4d59-a393-5c994e4028c1":{"type":"featured-product","blocks":{"template--14499854811265__e4a12b9c-5bf3-4d59-a393-5c994e4028c1-1685963720bc487ff4-0":{"type":"price","settings":{}},"template--14499854811265__e4a12b9c-5bf3-4d59-a393-5c994e4028c1-1685963720bc487ff4-1":{"type":"description","disabled":true,"settings":{"is_tab":false}},"template--14499854811265__e4a12b9c-5bf3-4d59-a393-
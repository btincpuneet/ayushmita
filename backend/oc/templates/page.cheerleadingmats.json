{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"fd44e4e8-867b-4179-8578-36e9ec1c6e49":{"type":"slideshow","blocks":{"template--14491774451841__fd44e4e8-867b-4179-8578-36e9ec1c6e49-1686664961ffe9b8fb-0":{"type":"image","settings":{"top_subheading":"","title":"CHEERLEADING MATS","title_size":70,"subheading":"Elevate Your Routine, Master Your Technique","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/cheerleading.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"bottom center"}}},"block_order":["template--14491774451841__fd44e4e8-867b-4179-8578-36e9ec1c6e49-1686664961ffe9b8fb-0"],"settings":{"section_height":"450px","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"68202255-70d0-424e-ab49-bfd9924b7b32":{"type":"rich-text","blocks":{"template--14485354905729__68202255-70d0-424e-ab49-bfd9924b7b32-1677600757f6f67c53-1":{"type":"text","settings":{"enlarge_text":true,"text":"<h2>Designed to the highest standards with safety in mind<\/h2>"}}},"block_order":["template--14485354905729__68202255-70d0-424e-ab49-bfd9924b7b32-1677600757f6f67c53-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"625f302f-0aee-4e6c-aafe-11986f626889":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/cheer_1_ecd9bfe2-75fc-4052-a0c8-0c9f11ef6778.png","image_width":500,"subtitle":"","title":"Roll-Out Cheerleading Mats","text":"<p>Designed for competitions and events, these mats are quick to set up, light-weight, easy to move, and pack up. Made from shock-absorbent EVA foam and a carpet surface, these mats provide excellent protection against impact injuries and are ideal for experienced athletes.<\/p><p><\/p><p><strong>Skill level:<\/strong> Experienced to Competitive Athletes<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$9.22\/sq ft.<\/strong><\/em><\
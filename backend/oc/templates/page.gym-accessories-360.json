{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"f867adac-9e2b-422d-9abb-30bf64062345":{"type":"slideshow","blocks":{"template--14486593044609__f867adac-9e2b-422d-9abb-30bf64062345-167820966345fc81bc-0":{"type":"image","settings":{"top_subheading":"Essentials for Every Workout","title":"Gym handles and accessories","title_size":53,"subheading":"Everything you need to complete your home or studio gym. From bars and attachments to mats and replacement parts, these accessories keep your workouts safe, efficient, and effective.","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-left","image":"shopify:\/\/shop_images\/Gym_Accessories.png","parallax_direction":"top","overlay_opacity":52,"focal_point":"80% 100%"}}},"block_order":["template--14486593044609__f867adac-9e2b-422d-9abb-30bf64062345-167820966345fc81bc-0"],"settings":{"section_height":"450px","mobile_height":"500px","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"rich_text_XkgWB4":{"type":"rich-text","blocks":{"heading_gdj7hx":{"type":"heading","settings":{"title":"Landmine Handle & Post"}},"text_tUWVGd":{"type":"text","settings":{"enlarge_text":false,"text":"<p>Add angles, power, and core activation to your barbell workouts. The COREFX Landmine Handle & Post let you perform rotational presses, rows, twists, and full-body exercises safely and effectively—anywhere you have plates and a bar.<\/p>"}},"button_7YfUcW":{"type":"button","disabled":true,"settings":{"link":"shopify:\/\/collections\/basketballs","link_text":"See all"}}},"block_order":["heading_gdj7hx","text_tUWVGd","button_7YfUcW"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"text_columns_Nyi3gF":{"type":"text-columns","blocks":{"text_block_GehpjG":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/CFXLMH-Landmine-Handle-Priscilla-800x1000-1_7ebcee66-6bd6-43b7-9d85-c27188cd8
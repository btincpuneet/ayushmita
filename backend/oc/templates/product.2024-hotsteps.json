{"sections":{"main":{"type":"main-product-length-only","blocks":{"0a318256-f2b4-46cd-a113-3415e79eb5e6":{"type":"custom","settings":{"code":"<h2 style=\"font-weight: normal; font-size: 0.8em; margin-top: 0.5em;\">\nOutdoor Snow Melting Mats for Ice and Snow\n<\/h2>"}},"price":{"type":"price","settings":{}},"95af784e-7e2a-42e9-a6df-83860fd22321":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/star-rating\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}},"8d840510-5183-4889-a2fb-a67be81aedd3":{"type":"custom","settings":{"code":"{% render 'estimated-shipping' %}\n<\/div>"}},"separator":{"type":"separator","settings":{}},"custom_YjDYBf":{"type":"custom","settings":{"code":"{%- render 'custom-variant-text' -%}"}},"variant_picker":{"type":"variant_picker","settings":{"variant_labels":true,"picker_type":"dropdown","product_dynamic_variants_enable":true,"color_swatches":false}},"custom_nFmmAM":{"type":"custom","disabled":true,"settings":{"code":"<div style=\"text-align: left; padding: 10px 0;\">\n  <span style=\"color: green; font-weight: bold; font-size: 18px;\">\n    Free Shipping\n  <\/span>\n<\/div>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"surface_pickup_enable":true}},"custom_wkxxQm":{"type":"custom","name":"HTML - Stock Counter","settings":{"code":"<div id=\"variant-inventory-root\" style=\"opacity: 0; transition: opacity 0.4s ease-in-out; pointer-events: none;\">\n  <div id=\"variant-inventory\" style=\"display:flex; align-items:center; justify-content:center; gap:6px; margin-top:10px;\">\n    <span id=\"inventory-dot\" style=\"display:inline-block;width:12px;height:12px;border-radius:50%;transition: background-color 0.3s ease;\"><\/span>\n    <span id=\"inventory-text\" style=\"font-weight:600;transition: color 0.3s ease;\"><\/span>\n  <\/div>\n<\/div>\n\n<script>\n(function() {\n  const variants = [\n    {%- for variant in product.variants -%}\n    {\n      \"id\": {{ variant.id | json }},\n      \"inventory_quantity\": {{ variant.inventory_quantity | default: 0 }},\n      \"available\": {{ variant.available | json }}\n    }{% unless forloop.last %},{% endunless %}\n    {%- endfor -%}\n  ];\n\n  let lastId = null;\n\n  function updateInventory() {\n    const root = document.getElementById('variant-inventory-root');\n    const dot = document.getElementById('inventory-dot');\n    const text = document.getElementById('inventory-text');\n    if (!root || !dot || !text) return;\n\n    \/\/ 1. Get current variant ID\n    const urlParams = new URLSearchParams(window.location.search);\n    let currentId = urlParams.get('variant');\n    if (!currentId) {\n      const hiddenInput = document.querySelector('input[name=\"id\"]');\n      currentId = hiddenInput ? hiddenInput.value : variants[0].id;\n    }\n\n    \/\/ 2. Lead Time detection\n    const pageContent = document.body.innerText;\n    const hasLeadTime = pageContent.includes(\"Estimated to Ship\");\n\n    \/\/ 3. VARIANT CHANGE FADE EFFECT\n    \/\/ If the ID changed, fade out briefly then back in with new data\n    if (currentId !== lastId) {\n      root.style.opacity = \"0\"; \/\/ Start fade out\n      lastId = currentId;\n      \n      \/\/ Short delay to allow the fade out before updating text\n      setTimeout(() => {\n        renderContent(currentId, hasLeadTime);\n      }, 200); \n    } else {\n      renderContent(currentId, hasLeadTime);\n    }\n  }\n\n  function renderContent(currentId, hasLeadTime) {\n    const root = document.getElementById('variant-inventory-root');\n    const dot = document.getElementById('inventory-dot');\n    const text = document.getElementById('inventory-text');\n    const variant = variants.find(v => v.id.toString() === currentId.toString()) || variants[0];\n\n    if (hasLeadTime) {\n      root.style.opacity = \"0\";\n      root.style.pointerEvents = \"none\";\n      return;\n    }\n\n    \/\/ Update Text\/Colors\n    let color = \"#d0021b\"; \n    let msg = \"\";\n\n    if (!variant.available) {\n      color = \"#d0021b\";\n      msg = \"Out of stock\";\n    } else if (variant.inventory_quantity >= 200) {\n      color = \"#2e7d32\";\n      msg = variant.inventory_quantity + \" in stock\";\n    } else if (variant.inventory_quantity >= 51) {\n      color = \"#d97706\";\n      msg = variant.inventory_quantity + \" in stock\";\n    } else {\n      color = \"#d0021b\";\n      msg = \"Only \" + variant.inventory_quantity + \" left!\";\n    }\n\n    dot.style.backgroundColor = color;\n    text.style.color = color;\n    text.textContent = msg;\n\n    \/\/ Fade back in\n    root.style.opacity = \"1\";\n    root.style.pointerEvents = \"auto\";\n  }\n\n  setInterval(updateInventory, 400);\n  updateInventory();\n})();\n<\/script>"}},"dbcc834d-d043-4bc8-b158-68a859ff0efa":{"type":"sales_point","disabled":true,"settings":{"icon":"checkmark","text":"2-Year Warranty on all HotStep snow melting mats"}},"sales_point_UMfEdY":{"type":"sales_point","settings":{"icon":"checkmark","text":"UL & CSA Certified snowmelt mats"}},"sales_point_cCNqLY":{"type":"sales_point","settings":{"icon":"checkmark","text":"Replaces snow salt and ice melt — no more shoveling or slipping"}},"sales_point_qX9Hww":{"type":"sales_point","disabled":true,"settings":{"icon":"checkmark","text":"{{ product.metafields.custom.sales_point_1.value }}"}},"3d817c16-d453-43dc-b014-ab5f2fefe11c":{"type":"sales_point","settings":{"icon":"checkmark","text":"Melts up to 2” of snow per hour, supports light vehicle traffic on driveways and walkways"}},"daaa8f57-84fc-4c7b-8619-cbe0a684f081":{"type":"sales_point","disabled":true,"settings":{"icon":"checkmark","text":"Heats up to 7–10°C above ambient temp, melting 2\" of snow per hour"}},"sales_point_7mCbmG":{"type":"sales_point","settings":{"icon":"checkmark","text":"{{ product.metafields.custom.sales_point_4.value }}"}},"383f2e3f-d810-4a2b-acaf-a1308cfe8421":{"type":"trust_badge","settings":{"trust_image":"shopify:\/\/shop_images\/HOTSTEP_73902
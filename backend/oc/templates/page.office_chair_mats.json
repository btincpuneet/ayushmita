{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"10776546-f8b9-4964-b476-b539e846f98b":{"type":"slideshow","blocks":{"template--14491775860865__10776546-f8b9-4964-b476-b539e846f98b-image-1":{"type":"image","settings":{"top_subheading":"","title":"OFFICE CHAIR MATS","title_size":60,"subheading":"Floor protection solutions for the workplace at home","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/everlife-lipped-crystal-edge-highpile-carpet-insetting1.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14491775860865__10776546-f8b9-4964-b476-b539e846f98b-image-1"],"settings":{"section_height":"450px","mobile_height":"auto","parallax":true,"style":"bars","autoplay":true,"autoplay_speed":5}},"af883198-f7f8-4344-a02d-fbce581e681f":{"type":"rich-text","blocks":{"template--14486605922433__af883198-f7f8-4344-a02d-fbce581e681f-1678206211dc006287-0":{"type":"heading","settings":{"title":"office chair mats"}},"template--14486605922433__af883198-f7f8-4344-a02d-fbce581e681f-1678206211dc006287-1":{"type":"text","settings":{"enlarge_text":false,"text":"<p>The ideal solution for protecting your floors against damage from office chairs while improving comfort and ease of chair use. <\/p>"}}},"block_order":["template--14486605922433__af883198-f7f8-4344-a02d-fbce581e681f-1678206211dc006287-0","template--14486605922433__af883198-f7f8-4344-a02d-fbce581e681f-1678206211dc006287-1"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"190c5bc0-14e4-468e-89af-3372a9711ba2":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/image_119_b3acc730-8bad-4767-91c1-17e38377fbe2.png","image_width":500,"subtitle":"","title":"everlife chair mats","text":"<p>Protect your flooring from caster wear, spills, and other damage with these mats.<\/p><ul><li>AnchorPro® cleat system ensures safe handling<\/li><li>Locks gently into the carpet<\/li><li>Eliminates buckling and shifting during use<\/li><li>Suitable for low pile to high pile carpets<\/li><\/ul><p><\/p><p><em>Starting at <\/em><em><strong>$23.25\/sq ft.<\/strong><\/em><\/p>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"0fc5bfb1-4241-4f86-b240-14644df24337":{"type":"text-columns","blocks":{"template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_1_9a523f93-6f70-4b1a-91b8-1e6506ca0efc.png","image_width":290,"title":"low pile","text":"<p>If carpet thickness is about 3\/8'' thick or lower<\/p>","button_label":"buy low pile mat","button_link":"shopify:\/\/products\/everlife-chairmat-low"}},"template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_2_1f10b715-67cd-44f5-8ad2-7fd79cfb0b19.png","image_width":290,"title":"medium pile","text":"<p>If carpet thickness is about 3\/4'' thick or lower<\/p>","button_label":"buy medium pile mat","button_link":"shopify:\/\/products\/everlife-chairmat-med"}},"template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Frame_3_61a7baf6-1990-400b-9883-b34c3f6b2bb3.png","image_width":290,"title":"High Pile","text":"<p>If carpet thickness is about 1'' thick or over<\/p>","button_label":"buy high pile mat","button_link":"shopify:\/\/products\/everlife-chairmat-high"}}},"block_order":["template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-0","template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-1","template--14486605922433__0fc5bfb1-4241-4f86-b240-14644df24337-1678206284db50f2e2-2"],"settings":{"title":"everlife chair mats","align_text":"center","divider":false}},"36d201af-c970-43bd-be25-49f76ff8f1b3":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/image_116_2095d498-ef44-4392-8c63-0c86c136f239.png","image_width":500,"subtitle":"","title":"Everlife Hardwood Chair Mats","text":"<p>These chairmats are designed to protect your hardwood flooring from the wear of office chair wheels. It provides plenty of grip to eliminate any movement during use.<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$24.50\/sq ft.<\/strong><\/em><\/p>","button_label":"buy hardwood chair mat","button_link":"shopify:\/\/products\/everlife-chairmat-hardwood","button_style":"primary","align_text":"left","layout":"right","divider":false}},"text_and_image_6CfdJR":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/8x8-Black-Rectangle-on-carpet.jpg","image_width":500,"subtitle":"","title":"TrendSetter Chairmat","text":"<p>Offer superior floor protection for both carpet and hard surfaces like wood, tile, and laminate. Enjoy a smooth rolling surface that enhances mobility and ergonomic comfort while safeguarding your floors from scuffs, scrapes, and damage from chair casters.<br\/><\/p>","button_label":"buy TrendSetter Chairmat","button_link":"shopify:\/\/products\/trendsetter-chairmat","button_style":"primary","align_text":"left","layout":"left","divider":false}},"7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf":{"type":"text-columns","blocks":{"template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/image_121_0adc8f65-53c5-45d1-b56e-42262ca985fe.png","image_width":650,"title":"PVC CHAIR MATS","text":"<p>PVC Chairmat provides durable and affordable carpet protection for the office or your home. Trust the unique Cleartex PVC formulation for the clearest, most durable PVC mats.<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$8.94\/sq ft.<\/strong><\/em><\/p>","button_label":"buy pvc chair mat","button_link":"shopify:\/\/products\/greenside-chairmat-pvc"}},"template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/image_115_27fe3c4c-97af-4be4-aa0f-b544310f19ba.png","image_width":650,"title":"pOLYCARBONATE CHAIR MATS","text":"<p>Polycarbonate has double the strength of PVC and won’t scratch, crack, buckle, curl at the edges, or discolour. The mat has ergonomic benefits for chair users and reduces leg fatigue.<\/p><p><\/p><p><em>Starting at <\/em><em><strong>$13.75\/sq ft.<\/strong><\/em><\/p>","button_label":"BUY POLYCARBONATE CHAIR MAT","button_link":"shopify:\/\/products\/greenside-chairmat-polycarbonate"}},"template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-2":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image_width":650,"title":"Example title","text":"<p>Use this section to explain a set of product features, to link to a series of pages, or to answer common questions about your products. Add images for emphasis.<\/p>","button_label":"Optional button","button_link":""}}},"block_order":["template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-0","template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-1","template--14486605922433__7abac706-6e6a-4ef8-b0b2-1e63f95ad5bf-1678206284db50f2e2-2"],"disabled":true,"settings":{"title":"","align_text":"center","divider":false}},"6045cd3e-cd0c-4f78-8da9-72df93cdd825":{"type":"testimonials","blocks":{"template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>So far, very good. Sure beats the thinner one I had before!<\/p>","author":"Marian","author_info":"Verified Buyer"}},"template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>I have only had this mat for a short time but so far I am very impressed with how easy my chair rolls around on it. So much better than the previous mats I have had.<\/p>","author":"Donna S.","author_info":"Verified Buyer"}},"template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-3":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p><strong>Excellent product<\/strong><br\/>A great chair mat and great customer service!<\/p>","author":"Darlene","author_info":"Verified Buyer"}},"template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-4":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>I use this mat in my home gym area. Adds just the right cushioning for hex bar squats using weights. Also much easier on my knees when using skipping rope. Also easy to roll up and store if needed. Great mat...<\/p>","author":"Norman M.","author_info":"Verified Buyer"}}},"block_order":["template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-1","template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-2","template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-3","template--14491775860865__6045cd3e-cd0c-4f78-8da9-72df93cdd825-testimonial-4"],"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#e6e6e6","color_text":"#1c1d1d"}},"df970d9d-93a6-49ab-95d3-473ec443fe26":{"type":"featured-collection","settings":{"title":"All office chair mats","home_featured_products":"office-chair-mats","per_row":4,"rows":5,"mobile_scrollable":true,"view_all":false,"divider":false}}},"order":["main","10776546-f8b9-4964-b476-b539e846f98b","af883198-f7f8-4344-a02d-fbce581e681f","190c5bc0-14e4-468e-89af-3372a9711ba2","0fc5bfb1-4241-4f86-b240-14644df24337","36d201af-c970-43bd-be25-49f76ff8f1b3","text_and_image_6CfdJR","7abac706-6e6a-4ef8-b0b2-1e63f95ad5
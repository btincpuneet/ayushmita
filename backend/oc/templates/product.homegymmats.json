154-c2ae0c387173.jpg","video_url":"","width":"50","height":460,"text_size":40,"text_align":"vertical-center horizontal-center","focal_point":"center","color_accent":"rgba(0,0,0,0)","boxed":false,"framed":false}},"f640cacc-0b61-4785-8dc0-13ffba2bbc87":{"type":"advanced","settings":{"subheading":"","heading":"","textarea":"","cta_text1":"","cta_link1":"","cta_text2":"","cta_link2":"","image":"shopify:\/\/shop_images\/titan_1_21bc3247-9c55-439d-99b8-31326ea366fe.jpg","video_url":"","width":"50","height":460,"text_size":40,"text_align":"vertical-center horizontal-center","focal_point":"center","color_accent":"rgba(0,0,0,0)","boxed":false,"framed":false}}},"block_order":["template--14487890165889__e68c6051-85fb-4e14-893d-e35d0a923c09-16793808214b868500-0","template--14487890165889__e68c6051-85fb-4e14-893d-e35d0a923c09-16793808214b868500-1","d2e47ffe-d0b8-4056-977e-68be09d719ed","ab930a1d-1400-482e-a535-48a0ed5abbd0","f640cacc-0b61-4785-8dc0-13ffba2bbc87"],"disabled":true,"settings":{"full_width":true,"gutter_size":10,"space_above":true,"space_below":true}},"featured_video_LPYbqd":{"type":"featured-video","settings":{"title":"","video_url":"https:\/\/www.youtube.com\/watch?v=ihddxFrsha0","divider":false}},"4f5eac09-4703-41cd-8c98-7f7ae60f5938":{"type":"faq","blocks":{"5df8823c-afeb-46c7-91e3-01d7d08f11e2":{"type":"question","settings":{"title":"What are the benefits of using vulcanized rubber flooring for my gym?","text":"<p>Vulcanized rubber gym flooring offers a multitude of benefits for your gym. Its superior durability makes it ideal for high-traffic areas and heavy-duty workouts, including weightlifting and cardio exercises. This resilience stems from the vulcanization process, which enhances the strength and elasticity of the rubber.<\/p><p>Vulcanized rubber flooring provides an excellent grip and stable surface, reducing the risk of slips and falls during workouts, contributing to a safer exercise environment. Its high-density structure also ensures excellent impact absorption, protecting your gym's subfloors from damage due to dropped weights.<\/p><p>This type of flooring is resistant to moisture and easy to clean, making gym maintenance simpler. It's also available in various colours and patterns, allowing you to customize your gym's aesthetic.<\/p><p>Our gym flooring is made from vulcanized rubber. It is recycled, making it an eco-friendly choice for your gym.<\/p>"}},"template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-1":{"type":"question","settings":{"title":"What is the difference between vulcanized gym flooring and traditional polyurethane (foam) gym flooring? Which one offers superior performance?","text":"<p>Foam and rubber gym flooring tiles cater to different fitness needs. Foam tiles, with their softness, are ideal for floor exercises like sit-ups and planks, or for creating safe play areas for children. However, if you plan to install cardio or strength training equipment such as treadmills, weight machines, dumbbells, barbells, or squat racks, we highly recommend our Stamina gym flooring. Its durability and stability provide the perfect lifting surface for exercises like deadlifts, squats, and bench presses. Additionally, rubber gym flooring offers a stable base for cardio and strength machines, ensuring they remain sturdy and don't leave imprints on the floor beneath, no matter how much weight is applied. This ensures that your underlying floor is always protected.<\/p>"}},"template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-0":{"type":"question","settings":{"title":"What is the required quantity of Gym Flooring for my space, and how can I measure it accurately? What factors should I consider when choosing this durable, easy-to-clean flooring option for my fitness area?","text":"<p>To figure out the amount of Gym Flooring you'll need, simply measure the length and width of your desired gym area. This calculation will give you the floor coverage area. Please also consider factors such as your existing floor type, room shape, room temperature, and even provide cost-effective layout suggestions. <\/p>"}}},"block_order":["5df8823c-afeb-46c7-91e3-01d7d08f11e2","template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-1","template--14491778023553__4f5eac09-4703-41cd-8c98-7f7ae60f5938-1685534984d30e3095-0"],"settings":{"title":"FAQs"}},"f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9":{"type":"slideshow","blocks":{"template--14491778023553__f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9-168329114236b7c3f0-0":{"type":"image","settings":{"top_subheading":"","title":"workout with confidence","title_size":50,"subheading":"Go all out, knowing your floors are protected.","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/victor-freitas-qZ-U9z4TQ6A-unsplash_12_1.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14491778023553__f6f90d2a-ff1a-4ce1-ae9d-f64bd8e516a9-168329114236b7c3f0-0"],"settings":{"section_height":"650px","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"1681226711ef3acf02":{"type":"apps","blocks":{"62527db9-a0b0-4a1d-b962-18ad01337429":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}}},"block_order":["62527db9-a0b0-4a1d-b962-18ad01337429"],"settings":{"full_width":false,"space_around":true}},"product-recommendations":{"type":"product-recommendations","settings":{"show_product_recommendations":true,"product_recommendations_heading":"You may also like","related_count":5}},"recently-viewed":{"type":"recently-viewed","settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}}},"order":["main","promo_grid_YAyQyB","sub","174292538395d6c81c","1148b4e3-2cf6-42af-910e-9aa2
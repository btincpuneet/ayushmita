'form[action*=\"\/cart\/add\"] input[name=\"id\"]');\n    if (!idInput) return;\n\n    const currentId = idInput.value;\n    const variant = variants.find(v => v.id.toString() === currentId.toString()) || variants[0];\n\n    \/\/ 3. RULE: Hide if inventory is above 100\n    if (variant.inventory_quantity > 100) {\n      root.style.display = 'none';\n      return; \n    } \n\n    \/\/ Otherwise, show the tracker\n    root.style.display = 'block';\n\n    let color = \"#d0021b\"; \/\/ Default Red\n    let msg = \"\";\n\n    if (!variant.available) {\n      msg = \"Out of stock\";\n    } else if (variant.inventory_quantity >= 51) {\n      color = \"#d97706\"; \/\/ Impulse Amber\n      msg = variant.inventory_quantity + \" in stock\";\n    } else {\n      color = \"#d0021b\"; \/\/ Red\n      msg = \"Only \" + variant.inventory_quantity + \" left!\";\n    }\n\n    dot.style.backgroundColor = color;\n    text.style.color = color;\n    text.textContent = msg;\n  }\n\n  \/\/ Check every 500ms to catch variant changes or page loads\n  setInterval(updateInventory, 500);\n  updateInventory();\n})();\n<\/script>"}}},"block_order":["price_irDAXy","custom_U9zKTp","custom_ETQhJr","sales_point_BfD4Lw","sales_point_b8XAWe","sales_point_nb73Tx","custom_99LPzg","description_DnMzDm","variant_picker_B6JLqW","custom_HT7ME4","buy_buttons_CbKexE","custom_cVVFXy"],"name":"t:sections.featured-product.presets.featured_product.name","settings":{"featured_product":"snow-melting-heated-mats","divider":false,"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_arrows":true,"mobile_layout":"full","enable_video_looping":true,"product_video_style":"muted"}},"hero_video_m7cCMf":{"type":"hero-video","settings":{"title":"Build Your \nSnow-Melting System","title_size":49,"subheading":"Combine mats and accessories to create a custom setup that keeps every step safe, dry, and snow-free.","link_text":"Get HotStep Heated Mats","li
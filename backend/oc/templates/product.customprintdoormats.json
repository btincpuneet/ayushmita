a_link2":"","video_url":"","width":"50","height":500,"text_size":100,"text_align":"vertical-center horizontal-center","focal_point":"center","color_accent":"rgba(0,0,0,0)","boxed":false,"framed":false}}},"block_order":["template--14487890329729__2588cca7-13d7-48ae-9230-3a7fdbc6f173-16793808214b868500-0","template--14487890329729__2588cca7-13d7-48ae-9230-3a7fdbc6f173-16793808214b868500-1"],"settings":{"full_width":true,"gutter_size":20,"space_above":true,"space_below":true}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","settings":{"title":"YOUR CHOICE OF TRADITIONAL HANDWOVEN OR MODERN VINYL BACKED MATS"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"text-and-image":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/coco_handwoven_447363f8-0536-4be8-9b20-e4cb6c2bebd3.webp","image_width":650,"subtitle":"TRADITIONALLY MAGNIFICENT","title":"HANDWOVEN DOORMATS","text":"<p>Each handwoven coco doormat is unique in its own way. The mats are produced in a sustainable and eco-friendly manner by weaving together coconut husk fibers into a <strong>1.5\" thick<\/strong> rectangular shape.<\/p><p>Carefully weaved and held together by a beautiful braid around the edge, these mats instantly upgrade any doorway they are paced in front of.<br\/><\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"text-and-image2":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/vinyl_backed_c341e0da-6870-4123-b6bc-225220380293.webp","image_width":650,"subtitle":"THIN & MODERN","title":"VINYL BACK DOORMATS","text":"<p>The thin and modern version of our coco doormats is made by embedding eco-friendly coco fibers into a PVC vinyl backing. The fibers, standing up, are sheared at a <strong>5\/8” thick<\/strong> height.<\/p><p>This creates an even and attractive surface level that is extremely effective at scrapping away dirt and debris from the bottom of shoes, as well as preventing water from leaking through to the bottom.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"background-image-text":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"Impressive","title":"About your brand","text":"<p>Pair large text with a full-width image to draw attention to an important detail of your brand or product line.<\/p>","button_label":"","button_link":"","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"37afe09d-e6c1-4ab3-b02e-886b131010a1":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"","title":"simple and effective tiles","text":"<p>Attractive event flooring that is easy to install.<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/Slate_Black_Tap_Studio.webp","focal_point":"center","layout":"left","height":650,"framed":true,"parallax":false,"parallax_direction":"top"}},"testimonials":{"type":"testimonials","blocks":{"testimonials-0":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}},"testimonials-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p>Add customer reviews and testimonials to showcase your store’s happy customers.<\/p>","author":"Author's name","author_info":"Los Angeles, CA"}}},"block_order":["testimonials-0","testimonials-1","testimonials-2"],"disabled":true,"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#f9f9f9","color_text":"#1c1d1d"}},"8dee5b19-f3b7-478f-9187-7d6dbce1c9ab":{"type":"hero-video","disabled":true,"settings":{"title":"SNOW, MUD\n& DAMAGE","title_size":60,"subheading":"CONTAIN THEM WITH THE FLOOR DEFENDER","link_text":"","link":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","video_url":"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/205bf0dd43474cadbc436af39a1133dd.mp4","overlay_opacity":0,"section_height":"650px","mobile_height":"auto"}},"f7c3225f-e625-4856-a697-866928ef710b":{"type":"rich-text","blocks":{"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0":{"type":"heading","settings":{"title":"REGULAR VS PRO GRADE MATS"}},"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>The underside of Floor Defender Pro Garage Containment Mats features a tatami grain pattern for increased traction. This patterned backing prevents these mats from lifting and allows them to retain their shape over extended periods of time. Also, the tatami grain patterned backing produces a smoother, less wrinkled surface than the smooth backed regular Floor Defender Garage Containment Mats.<\/p>"}}},"block_order":["template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0","template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"1148b4e3-2cf6-42af-910e-9aa29caa2a70":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_22_21_609Z.png","image_width":700,"subtitle":"GARAGE CONTAINMENT MATS","title":"CONTAIN THE ELEMENTS","text":"<p>Rated for environment ranging between -40 degrees to +40 degrees Celsius. These mats are perfect for harsh winters.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_24_19_294Z.png","image_width":700,"subtitle":"GARAGE FLOOR PROTECTION","title":"NO MUDDY MESS","text":"<p>Dirt, Dust, and Debris are no problem as the Floor Defender Containment Mat catches it all and keeps it from being tracked into the house.<\/p><p>The Floor Defenders will hold up to 62 gallons of water at once and keep it off your floors until you are ready to safely empty it outside your garage.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"12ee58e8-5133-4e52-a73b-887b18d27f7f":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"ROLL OUT AND LAY DOWN","title":"HASSLE-FREE INSTALL","text":"<p>Incredibly easy to use, the floor defenders unlike some other garage containments mats come ready to use. The single piece construction allows you to simply roll the mat out and lay it on your floor.<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/ezgif.com-gif-maker_8.gif","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":true,"parallax_direction":"top"}},"3eb2f88f-12e5-4f87-aabb-ad99d885f103":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_38_17_168Z.png","image_width":500,"subtitle":"GARAGE FLOOR PROTECTION MATS","title":"PROTECT AGAINST CHEMICALS","text":"<p>Keep oil, geese, anti-freeze, and other chemicals that may drain out of your car contained, and away from other possessions stored in the garage.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"9d8d2f29-27b5-4648-b084-5ca9f0b9964b":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_42_33_705Z.png","image_width":500,"subtitle":"Improved","title":"EASY CLEAN UP","text":"<p>Floor defenders are very easy to clean, simply drag the mat outside with all its contents and hose it down. In a matter of minutes, the mat is ready to be redeployed and used all over again.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"f220664d-cc7b-4aea-a660-b60af2d6dd55":{"type":"featured-collection","disabled":true,"settings":{"title":"Featured collection","home_featured_products":"garage-flooring","per_row":4,"rows":1,"mobile_scrollable":true,"view_all":false,"divider":false}},"f439fa7b-3c66-47db-841a-b1b505910716":{"type":"promo-grid","blocks":{"15cdc791-90a5-4cbe-abe9-ccba4e018ea1":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/coco_mat_538c59b6-2b58-47df-9ff0-bc1c7e476423.webp","link":"","width":"33"}},"78f96427-7fdc-41b4-b32a-46ba55234de3":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/coco_mat_2.jpg","link":"","width":"33"}},"7558ff02-3b92-4f3b-a714-cf217206b43e":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/coco_mat_3.jpg","link":"","width":"33"}}},"block_order":["15cdc791-90a5-4cbe-abe9-ccba4e018ea1","78f96427-7fdc-41b4-b32a-46ba55234de3","7558ff02-3b92-4f3b-a714-cf217206b43e"],"settings":{"full_width":false,"gutter_size":20,"space_above":true,"space_below":true}},"produ
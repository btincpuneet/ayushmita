le Animal","align_text":"center","divider":false}},"rich_text_yRAXGG":{"type":"rich-text","blocks":{"heading_NnQBbX":{"type":"heading","settings":{"title":"Play Kits"}},"text_xB8nQN":{"type":"text","settings":{"enlarge_text":false,"text":"<p>Complete activity kits designed for schools, gyms, and group play. Each kit includes safe, durable equipment that promotes movement, teamwork, and active fun across a variety of games and age levels.<\/p>"}}},"block_order":["heading_NnQBbX","text_xB8nQN"],"custom_css":[],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"align_text":"center","narrow_column":true,"divider":false}},"featured_collection_WCChaX":{"type":"featured-collection","name":"t:sections.featured-collection.presets.featured_collection.name","settings":{"title":"","home_featured_products":"play-kits","per_row":5,"rows":2,"mobile_scrollable":true,"view_all":true,"divider":false}},"background_image_text_KQm6Fn":{"type":"background-image-text","name":"t:sections.background-image-text.presets.large_image_with_text_box.name","settings":{"subtitle":"Throw, Catch, Play","title":"Flying Discs","text":"<p>A versatile range of flying discs designed for safe, active play and skill development. Ideal for schools, recreation programs, and casual games, with options for training, target play, and all-age use.<\/p>","button_label":"See collection","button_link":"shopify:\/\/collections\/flying-discs","image":"shopify:\/\/shop_images\/Flying_Discs.png","focal_point":"center","layout":"left","height":450,"framed":false,"parallax":true,"parallax_direction":"top"}},"featured_collection_EWFan8":{"type":"featured-collection","name":"t:sections.featured-collection.presets.featured_collection.name","settings":{"title":"","home_featured_products":"flying-discs","per_row":5,"rows":2,"mobile_scrollable":true,"view_all":true,"divider":false}},"background_image_text_iKRzaf":{"type":"background-image-text","name":"t:sections.background-image-text.presets.large_image_with_text_box.name","settings":{"subtitle":"Play, Move, Explore","title":"Games & Activities","text":"<p>A fun and engaging collection of games and activity sets designed to promote movement, coordination, teamwork, and sensory play. Perfect for schools, recreation programs, and group activities for all ages.<\/p>","button_label":"See collection","button_link":"shopify:\/\/collections\/games-activities","image":"shopify:\/\/shop_images\/Games_Activities.png","focal_point":"20% 100%","layout":"right","height":450,"framed":false,"parallax":true,"parallax_direction":"top"}},"featured_collection_KMYeiJ":{"type":"featured-collection","name":"t:sections.featured-collection.presets.featured_collection.name","settings":{"title":"","home_featured_products":"games-activities","per_row":5,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"text_and_image_WjN7CM":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/Rings_Hoops.png","image_width":360,"subtitle":"","title":"Rings & Hoops","text":"<p>Level up the fun with our rings and hoops! Perfect for tossing, diving, and active play, these colorful, durable rings and hoops keep kids moving and smiling—indoors, outdoors, or in the pool. Easy to grab, safe to use, and built to last.<\/p>","button_label":"See more","button_link":"shopify:\/\/collections\/rings-hoops","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"background_image_text_pyhzMH":{"type":"background-image-text","name":"t:sections.background-image-text.presets.large_image_with_text_box.name","settings":{"subtitle":"Fun, Active Play","title":"Scooter Board Equipment","text":"<p>Durable scooter boards and accessories designed for dynamic movement, games, and skill-building activities for kids and classrooms.<\/p>","button_label":"See collection","button_link":"shopify:\/\/collections\/scooter-board-equipment","image":"shopify:\/\/shop_images\/Scooter_Board_Equipment.png","focal_point":"bottom","layout":"right","height":450,"framed":false,"parallax":true,"parallax_direction":"top"}},"featured_collection_XAi3rQ":{"type":"featured-collection","name":"t:sections.featured-collection.presets.featured_collection.name","settings":{"title":"","home_featured_products":"scooter-board-equipment","per_row":4,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"text_columns_VCqYrF":{"type":"text-columns","blocks":{"text_block_eFYiVi":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/TUNMEGA-Mega-Tunnel-800x1000px.jpg","image_width":280,"title":"Tunnel","text":"<p>Crawl, duck, and explore! Our rainbow tunnels are perfect for solo or group fun, with Velcro ends to connect for endless adventures. From individual to jumbo-sized Mega Tunnels, kids stay active, playful, and smiling.<\/p>","button_label":"Shop Now","button_link":"shopify:\/\/products\/tunnel"}},"text_block_4iiipc":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/PP-TunnelsAndParachutes-MultiColouredParachute-1-800x1000px.jpg","image_width":280,"title":"Multi-Coloured Parachute","text":"<p>Bring everyone together with our colourful, durable parachutes! Perfect for group games, PE activities, and cooperative play—kids will lift, wiggle, and laugh while learning teamwork and coordination.<\/p>","button_label":"Shop Now","button_link":"shopify:\/\/products\/multi-coloured-parachute"}},"text_block_dhx7zi":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/PCACS-Catch-A-Cup-Set_f9226a14-863f-4388-acb7-75a0c18b021b.jpg","image_width":330,"title":"Catch A Cup Set","text":"<p>Build hand-eye coordination and motor skills with this beginner-friendly cup and ball set. Perfect for indoor or outdoor play and skill development.<\/p>","button_label":"Shop Now","button_link":"https:\/\/canadamats.ca\/products\/toys?variant=40556680347777"}},"text_block_WyTJ3A":{"ty
-4a05-b600-0d4070c9d895-advanced-2"],"settings":{"full_width":true,"gutter_size":20,"space_above":true,"space_below":false}},"1d9c5cd0-7d05-4f33-936b-ae939dd3f73e":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/Comfort-Series-Mat_Full_036869ff-f0da-40f3-b7cb-a07421dd37dd.jpg","image_width":550,"subtitle":"Alleviate posture strain","title":"ANTI-FATIGUE MATS","text":"<p>As sit-stand desks become essential in modern offices, our anti-fatigue mats offer a comfortable and ergonomic solution to combat the challenges of cold, hard floors.<\/p><p>Designed to promote blood flow through the legs, they <strong>enhance workplace comfort and well-being<\/strong>.<\/p><p><\/p>","button_label":"VIEW ALL ANTI-FATIGUE MATS","button_link":"shopify:\/\/collections\/office-anti-fatigue-mats","button_style":"primary","align_text":"left","layout":"right","divider":false}},"5908b60e-9b23-42ff-92d5-ffc96eee3ace":{"type":"featured-collection","settings":{"title":"","home_featured_products":"office-anti-fatigue-mats","per_row":5,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"bce094fb-0249-4ed9-8c16-db00d5c09ed0":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/everlife-lipped-beveled-edge-lowpile-carpet-insetting1.png","image_width":550,"subtitle":"","title":"EVERLIFE CHAIR MATS","text":"<p>Protect your flooring from caster wear, spills, and other damage with these mats.<\/p><ul><li><strong>AnchorPro® cleat system <\/strong>ensures safe handling and locks gently into the carpet to eliminate buckling and shifting during use.<\/li><\/ul><p><\/p><ul><li>Explore a range of chair mats designed for various flooring types, from low pile to high pile carpets, to find the perfect fit for your workspace.<\/li><\/ul><p><\/p><p><em>Starting at <\/em><em><strong>$23.25\/sq ft.<\/strong><\/em><\/p><p><\/p>","button_label":"VIEW ALL EVERLIFE CHAIR MATS","button_link":"shopify:\/\/pages\/office-chair-mats","button_style":"primary","align_text":"left","layout":"left","divider":false}},"3cf93ed2-23ba-4f7d-9a76-38a1b1852c8c":{"type":"featured-collection","settings":{"title":"","home_featured_products":"office-chair-mats","per_row":5,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9":{"type":"testimonials","blocks":{"template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-1":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p><strong>Quick delivery<\/strong><br\/>Quick delivery. Product was as advertised. So far so good.<\/p>","author":"Ravi P.","author_info":"Verified Buyer"}},"template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-2":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p><strong>Standing in BC<\/strong><br\/>Very comfortable. Love that it's made in Canada & doesn't off-gas.<\/p>","author":"Merran S.","author_info":"Verified Buyer"}},"template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-3":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p><strong>Easy on the knees<\/strong><br\/>I have injuries in both knees and this mat has been a great comfort in relieving the pain from standing long times while cooking.<\/p>","author":"Jim T.","author_info":"Verified Buyer"}},"template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-4":{"type":"testimonial","settings":{"icon":"5-stars","testimonial":"<p><strong>Perfect size and comfort<\/strong><br\/>This mat is the perfect size for our workstations and it is comfortable to use all day with a sit-stand desk.<\/p>","author":"Linda C.","author_info":"Los Angeles, CA"}}},"block_order":["template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-1","template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-2","template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-3","template--14609204772993__82ee9ac4-4cc6-45a4-b147-dbf09e99f1f9-testimonial-4"],"settings":{"title":"Testimonials","align_text":"center","round_images":true,"color_background":"#e6e6e6","color_text":"#1c1d1d"}},"0af7a983-c9f6-4551-ae7c-2f36cfc69167":{"type":"slideshow","blocks":{"template--14609204772993__0af7a983-c9f6-4551-ae7c-2f36cfc69167-image-1":{"type":"image","disabled":true,"settings":{"top_subheading":"","title":"WHY USE ANTI-FATIGUE MATS?","title_size":59,"subheading":"Discover ergonomic solutions","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/comfort_series.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14609204772993__0af7a983-c9f6-4551-ae7c-2f36cfc69167-image-1"],"disabled":true,"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"98fb15c2-c369-4f41-aa0b-945b63613764":{"type":"text-columns","blocks":{"template--14609204772993__98fb15c2-c369-4f41-aa0b-945b63613764-text_block-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/image_2023_03_19T08_55_06_009Z.png","image_width":650,"title":"Ergonomic comfort and relief","text":"<p>These ergonomic standing mats provide an excellent layer of protection against cold hard floors, while keeping you healthier, more comfortable, energized, and more productive.<\/p>","button_label":"","button_link":""}},"template--14609204772993__98fb15c2-c369-4f41-aa0b-945b63613764-text_block-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/image_2023_03_19T08_56_14_670Z.png","image_width":650,"title":"increase your energy","text":"<p>Long periods of standing causes a significant decrease of blood flow to the feet, causing pain and fatigue. Our mats cause muscles to contract as the feet adjust to the flexibility of the mat. This results in increased blood flow to the heart, leading to higher energy levels and a healthier body. <\/p>","button_label":"","button_link":""}}},"block_order":["template--14609204772993__98fb15c2-c369-4f41-aa0b-945b63613764-text_block-1","template--14609204772993__98fb15c2-c369-4f41-aa0b-945b63613764-text_block-2"],"disabled":true,"settings":{"title":"","align_text":"center","divider":false}},"2d623e32-3747-4986-acd9-d54502d50207":{"type":"text-columns","blocks":{"template--14609204772993__2d623e32-3747-4986-acd9-d54502d50207-text_block-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/2_56a68631-0874-4115-ac06-8faa43459e8d.png","image_width":650,"title":"WORK-FROM-HOME ESSENTIAL: DISCOVER THE BENEFITS OF EVERLIFE CHAIR MATS","text":"<p>Are you among the growing number of professionals who have transitioned to a work-from-home setup? If so, you know how crucial creating a comfortable ...<br\/><a href=\"https:\/\/canadamats.ca\/blogs\/blog\/work-from-home-essential-discover-the-benefits-of-everlife-chair-mats\" target=\"_blank\" title=\"https:\/\/canadamats.ca\/blogs\/blog\/work-from-home-essential-discover-the-benefits-of-everlife-chair-mats\"><em><strong>Read more<\/strong><\/em><\/a><\/p>","button_label":"","button_link":""}},"template--14609204772993__2d623e32-3747-4986-acd9-d54502d50207-text_block-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/1_b254f03b-252a-4b7e-9362-d61ed94db07e.png","image_width":650,"title":"HOW BENEFICIAL ARE ANTI FATIGUE STANDING MATS","text":"<p>The latest health trend in many offices today may involve standing while working or alternating between standing and sitting at the office...<br\/><a href=\"https:\/\/canadamats.ca\/blogs\/blog\/how-beneficial-are-anti-fatigue-standing-mat\" target=\"_blank\" title=\"https:\/\/canadamats.ca\/blogs\/blog\/how-beneficial-are-anti-fatigue-standing-mat\"><em><strong>Read more<\/strong><\/em><\/a><\/p>","button_label":"","button_link":""
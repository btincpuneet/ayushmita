block_order":["template--14531103195265__dc2c464d-a992-413b-9b32-6f6468314ca6-image-1"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"2e38cff6-3f08-4a72-bd61-3bd3bd479268":{"type":"rich-text","blocks":{"template--14486593077377__2e38cff6-3f08-4a72-bd61-3bd3bd479268-1678206211dc006287-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>Find the ideal fit for your space with our custom size mats.<br\/>Whether it's for a cozy corner or a grand entrance, we've got you covered.<\/p>"}}},"block_order":["template--14486593077377__2e38cff6-3f08-4a72-bd61-3bd3bd479268-1678206211dc006287-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"23d4fefd-0325-4067-a0ce-2893fead7399":{"type":"text-columns","blocks":{"template--14486593077377__23d4fefd-0325-4067-a0ce-2893fead7399-1678206284db50f2e2-0":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Dura_Nop_720x_391906b9-934e-49a9-a384-cecdaaed4d55.jpg","image_width":650,"title":"dura nop mats","text":"<p>Offering a perfect blend of value and durability, our mats feature a classic Berber pattern, widely favored across North America, effectively trapping 80% of dirt and moisture at the doorstep.<\/p><p><em>Starting at <\/em><em><strong>$8.50\/sq ft.<\/strong><\/em><\/p>","button_label":"Buy dura nop","button_link":"shopify:\/\/products\/dura-nop-entrance-mats"}},"template--14486593077377__23d4fefd-0325-4067-a0ce-2893fead7399-1678206284db50f2e2-1":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/8900-1_1600x1600_862c9371-9bd1-455f-8831-64573736456a.jpg","image_width":650,"title":"CM VIPER 8150 MATS","text":"<p>The durable looped vinyl surface of this mat removes, hides, and traps dirt and moisture keeping surrounding areas clean and safe. The non-slip backing also allows water to quickly drain out of the side.<\/p><p><em>Starting at <\/em><em><strong>$6.00\/sq ft.<\/strong><\/em><\/p>","button_label":"Buy CM VIPER 8150","button_link":"shopify:\/\/products\/cm-viper-8150-everscrape-logo-mats"}},"template--14486593077377__23d4fefd-0325-4067-a0ce-2893fead7399-1678206284db50f2e2-2":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/dura-nop-entrance-mats-3_1200x1200_1_8aa3a7e8-724e-41b1-a791-c77409ca00cd.jpg","image_width":650,"title":"DURA NOP slimline mats","text":"<p>Dura Nop Slimline is suitable for all heavy traffic areas indoors as well as outdoors with an overhang. The heavy fiber and dense construction will prevent this mat from crushing<\/p><p><em>Starting at <\/em><em><strong>$8.00\/sq ft.<\/strong><\/em><\/p>","button_label":"Buy Dura Nop slimline","button_link":"shopify:\/\/products\/dura-nop-slimline-entrance-mats"}},"ded4b1ea-8775-46e6-a90c-0c02c370d2ea":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/8950-2.png","image_width":650,"title":"CM VIPER 8950 MATS","text":"<ul><li>Perfect for outdoor use<\/li><li>Efficient debris scraping<\/li><li>Conceals dirt within its fibers for an all-day clean entrance<\/li><\/ul><p><em>Starting at <\/em><em><strong>$18.83\/sq ft.<\/strong><\/em><\/p>","button_label":"BUY CM VIPER 8950","button_link":"shopify:\/\/products\/cm-viper-8950-indoor-outdoor-scraper-matting"}},"bf625779-b0c7-41d2-926f-d5cdd1601a8f":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/9200-1.png","image_width":650,"title":"CM VIPER  9200 WIPER\/SCRAPER","text":"<ul><li>Eco-friendly<\/li><li>Efficient water absorption and dirt scraping balance<\/li><li>Good for outdoor use under covered areas<\/li><\/ul><p><em>Starting at <\/em><em><strong>$21.67\/sq ft.<\/strong><\/em><\/p>","button_label":"BUY CM VIPER 9200","button_link":"shopify:\/\/products\/cm-viper-9200-wiper-scraper-matting"}},"55d84dda-3d28-481f-9320-b0ed5223a3c6":{"type":
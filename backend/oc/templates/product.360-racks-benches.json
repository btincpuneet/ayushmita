"color_tint":"#000000","color_tint_opacity":8,"framed":true}}},"block_order":["banner_4Qmh4f"],"name":"t:sections.promo-grid.presets.promotional_grid.name","settings":{"full_width":false,"gutter_size":0,"space_above":false,"space_below":true}},"sub":{"type":"product-full-width","blocks":{"2e419ccc-d9c8-4aff-a591-eb502853320a":{"type":"description","settings":{"is_tab":false}}},"block_order":["2e419ccc-d9c8-4aff-a591-eb502853320a"],"settings":{"max_width":false}},"e98b186a-cb19-48cb-8775-57d1b1ee5ebe":{"type":"rich-text","blocks":{"19395395-ab98-4ad2-8cb6-274c48ffe6a1":{"type":"heading","settings":{"title":"Frequently Asked Questions"}},"c2c28a4a-2065-470b-9375-0248492fed55":{"type":"text","settings":{"enlarge_text":true,"text":"<p><a href=\"https:\/\/canadamats.ca\/pages\/frequently-asked-questions-floor-defender-garage-containment-mats\" target=\"_blank\" title=\"https:\/\/canadamats.ca\/pages\/frequently-asked-questions-floor-defender-garage-containment-mats\"><strong>Got Questions? Learn more about our Floor Defender Garage Continment Mats ❗HERE<\/strong><\/a>❗<\/p>"}}},"block_order":["19395395-ab98-4ad2-8cb6-274c48ffe6a1","c2c28a4a-2065-470b-9375-0248492fed55"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd":{"type":"text-and-image","settings":{"image":"{{ product.metafields.custom.image_text_1_image.value }}","image_width":400,"subtitle":"{{ product.metafields.custom.image_text_1_sub_heading.value }}","title":"{{ product.metafields.custom.image_text_1_heading.value }}","text":"<p>{{ product.metafields.custom.image_text_1_description | metafield_tag }}<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"text_columns_wenkBp":{"type":"text-columns","blocks":{"text_block_K8iDxL":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Polyurethane_Foam_1.gif","image_width":650,"title":"Polyurethane Sponge Foam","text":"<p>Polyurethane sponge foam is a high-performance material specifically crafted for demanding applications you'll need for your judo and martial arts mats. <\/p><p><\/p><ul><li><strong>Resilience and Elasticity<\/strong>: With its high resilience, the foam compresses under pressure and quickly returns to its original shape. This elasticity ensures consistent support and comfort, even during rigorous judo practice.<\/li><\/ul><p><\/p><ul><li><strong>Exceptional Shock Absorption<\/strong>: Its ability to disperse impact energy minimizes injuries during throws and falls, providing a safe training environment for judo practitioners.<\/li><\/ul><p><\/p><ul><li><strong>Moisture-Resistant<\/strong>: Designed to resist moisture, the foam prevents water absorption and the growth of mold, ensuring long-lasting durability even in humid training environments.<\/li><\/ul>","button_label":"","button_link":""}},"text_block_GUCjHJ":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Cross-Linked_PE_Foam_2_1.gif","image_width":650,"title":"Crosslinked Polyethylene Foam","text":"<p>Crosslinked polyethylene foam is a premium material engineered known for its exceptional durability, impact resistance, and firm support.  Choosing this material provides a stable and secure surface, ensuring safety and comfort during rigorous training and practice sessions.<\/p><p><\/p><ul><li><strong>Superior Impact Protection<\/strong>: Designed to absorb and disperse energy efficiently, the foam provides excellent cushioning, reducing the risk of injury during throws and falls.<\/li><\/ul><p><\/p><ul><li><strong>Waterproof and Long-Lasting<\/strong>: The closed-cell structure of the foam ensures it resists water and moisture, making it durable for intense judo practice sessions.<\/li><\/ul><p><\/p><ul><li><strong>Reliable Under Pressure<\/strong>: Resistant to wear and tear, the foam maintains its integrity even under rigorous use, ensuring consistent performance for judo training.<\/li><\/ul>","button_label":"","button_link":""}},"text_block_wBEUKY":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/thicknnes-100_900x_16d67fee-10f3-41f3-a75d-3ef6ab55cd10.webp","image_width":650,"title":"{{ product.metafields.custom.image_text_3_heading.value }}","text":"<p>{{ product.metafields.custom.image_text_3_description | metafield_tag }}<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_K8iDxL","text_block_GUCjHJ","text_block_wBEUKY"],"disabled":true,"name":"t:sections.text-columns.presets.text_columns_with_images.name","settings":{"title":"","align_text":"left","divider":false}},"text_columns_VTEdtN":{"type":"text-columns","blocks":{"text_block_dPRC7D":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/seaming_tape.png","image_width":650,"title":"COMBAT SPORTS MATS SEAMING TAPE","text":"<p>Seam-Free Tape for Combat Sports Mats is ideal for joining wrestling and martial art mats sections together. Combine multiple roll out sports mats to achieve your desired surface area.<\/p>","button_label":"GET YOURS NOW","button_link":"shopify:\/\/products\/seam-free-tape-for-combat-sports-mats"}},"text_block_gyt6DR":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vinyl_tatami_tape-500x500_cd8a0a9a-5861-4fd7-95ed-250522fd0064.jpg","image_width":650,"title":"Tatami Vinyl Seam-Free Tape for Combat Sports Mats","text":"<p>Tatami Vinyl Tape is great for martial arts mats or wrestling mats for a seamless look and is greatly used for permanent mat installations.<\/p>","button_label":"GET YOURS NOW","button_link":"shopify:\/\/products\/tatami-vinyl-seam-free-tape-for-combat-sports-mats"}},"text_block_dFcezg":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/store_tape_large-500x500_32048b33-8b41-4422-9aa9-173
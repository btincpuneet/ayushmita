5c5-974122889c17":{"type":"featured-collection","settings":{"title":"mats for the front door","home_featured_products":"plain-coco-door-mats","per_row":5,"rows":1,"mobile_scrollable":true,"view_all":true,"divider":false}},"text_columns_CdyqQQ":{"type":"text-columns","blocks":{"text_block_Qw8pDF":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/personalized.png","image_width":500,"title":"PERSONALIZED DOOR MATS","text":"<p>Elevate your doormat by printing your very own custom text or name. Choose from a wide range of premium and modern mat options.<\/p>","button_label":"VIEW ALL PERSONALIZED MATS","button_link":"shopify:\/\/collections\/personalized-coco-doormats"}},"text_block_GAJVat":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/plain.png","image_width":500,"title":"PLAIN COCO MATS","text":"<p>These eco-friendly mats not only look amazing on your front porch, but also do an excellent job of scraping away debris from shoes to keep it out of your home.<\/p>","button_label":"VIEW ALL PLAIN COCO MATS","button_link":"shopify:\/\/collections\/plain-coco-door-mats"}},"text_block_883FEH":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/designer.png","image_width":500,"title":"FUNNY\/DESIGNER COCO MATS","text":"<p>Add some fun to your entranceways with these unique mats. Bring a smile to everyone at your doorstep.<\/p>","button_label":"VIEW ALL FUNNY\/DESIGNER MATS","button_link":"shopify:\/\/collections\/funny-designer-coco-mats"}}},"block_order":["text_block_Qw8pDF","text_block_GAJVat","text_block_883FEH"],"settings":{"title":"COCO DOOR MATS","align_text":"center","divider":false}},"slideshow_D49Rre":{"type":"slideshow","blocks":{"image_ikpJtU":{"type":"image","settings":{"top_subheading":"","title":"Car Mats & Garage Flooring","title_size":60,"subheading":"Elevate Your Garage: Where Style Meets Durability on Every Floor","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/car_garage_mats.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["image_ikpJtU"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"4caceabf-66a5-4341-ae2a-0158d2cb10e3":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/Audi-Floor-Defender-11.jpg","image_width":600,"subtitle":"GARAGE CONTAINMENT","title":"FLOOR DEFENDER MATS","text":"<p>Featuring a tatami grain pattern for enhanced traction and durability, the Floor Defender Pro Garage Containment Mats are ideal for harsh winters, rated for environments between -40°C to +40°C.<br\/><br\/>With a capacity of 62 gallons, these mats efficiently catch dirt, dust, and debris, ensuring a clean garage.<br\/><br\/>They also prevent oil, chemicals, and other substances from reaching your floors, offering easy cleaning and redeployment for hassle-free maintenance.<\/p>","button_label":"SHOP FLOOR DEFENDER MATS","button_link":"shopify:\/\/products\/floor-defender-garage-containment-mats","button_style":"primary","align_text":"left","layout":"left","divider":false}},"4abe32eb-2c7f-4deb-92d9-be4d5d65869c":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/garage_tiles_2.png","image_width":500,"subtitle":"FLOOR PROTECTION","title":"GARAGE FLOORING SOLUTIONS","text":"<p>Revitalize your garage and elevate its functionality with our diverse range of garage flooring options. Whether you prefer the sleek aesthetics of modern designs or the durability of heavy-duty materials, our collection caters to a variety of styles and needs.<br\/><br\/>Explore flooring solutions that not only enhance the visual appeal of your garage but also provide practical benefits, turning it into a space that seamlessly combines style and functionality.<\/p>","button_label":"SHOP GARAGE TILES & MATS","button_link":"shopify:\/\/collections\/garage-flooring","button_style":"primary","align_text":"left","layout":"right","divider":false}},"6c689f45-7ad4-4699-97b9-011820738c5f":{"type":"slideshow","blocks":{"template--14486626631809__6c689f45-7ad4-4699-97b9-011820738c5f-16782498901a0275c9-0":{"type":"image","settings":{"top_subheading":"","title":"Build the perfect home gym","title_size":60,"subheading":"Floors that withstand extensive use and heavy impacts from gym equipment.","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-left","image":"shopify:\/\/shop_images\/vulcanized_gym_floor.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}},"template--14486626631809__6c689f45-7ad4-4699-97b9-011820738c5f-16782498901a0275c9-1":{"type":"image","disabled":true,"settings":{"top_subheading":"","title":"Two line\ntitle slide.","title_size":80,"subheading":"And big, beautiful imagery","link":"","link_text":"Optional button","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14486626631809__6c689f45-7ad4-4699-97b9-011820738c5f-16782498901a0275c9-0","template--14486626631809__6c689f45-7ad4-4699-97b9-011820738c5f-16782498901a0275c9-1"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"1f9d88e1-2538-4327-96b3-6b9924fb74bb":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/titan_2_8df16fa6-71b0-4e3b-a092-3a5472abfc24.png","image_width":500,"subtitle":"SAFE WORKOUT SESSIONS","title":"HOME GYM FLOORING SOLUTIONS","text":"<p>Ensure your facility can withstand extensive use with these durable long lasting options made out of <strong>Vulcanized Rubber<\/strong>.<br\/><br\/>✔ Anti-Microbial<br\/>✔ Slip-Resistant Surface<br\/>✔ Non-Absorbent<br\/>✔ Cut and Dent Resistant<br\/>✔ Heavy-Impact Absorption<\/p><p><em>Starting at <\/em><em><strong>$4.58 \/ sq ft.<\/strong><\/em><\/p>","button_label":"SHOP HOME GYM MATS","button_link":"shopify:\/\/collections\/home-gym-rubber-mats","button_style":"primary","align_text":"left","layout":"left","divider":false}},"advanced_content_8JQkk4":{"type":"advanced-content","blocks":{"liquid_rQfnWT":{"type":"liquid","settings":{"code":"<table>\n  <thead>\n    <tr style=\"background-color: lightgray;\">\n      <th style=\"background-color: lightgray;\"><\/th>\n      <th style=\"background-color: lightgray; text-align: center;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/vulcanized_products.png?v=1686064408\" alt=\"Vulcanized Products\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Vulcanized Products<\/th>\n      <th style=\"background-color: lightgray; text-align: center;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/urethane_bound.png?v=1686064408\" alt=\"Urethane Bound Products\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Urethane Bound Products<\/th>\n    <\/tr>\n  <\/thead>\n  <tbody>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/durability.png?v=1685465529\" alt=\"Durability\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">\n  Durability\n<\/th>\n      <td style=\"text-align: center;\">Hard wearing and durable<\/td>\n      <td style=\"text-align: center;\">With heavy\/continuous use product deteriorates<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/porosity.png?v=1685465530\" alt=\"Porosity\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Porosity<\/th>\n      <td style=\"text-align: center;\">Does not absorb liquid<\/td>\n      <td style=\"text-align: center;\">Liquids (water, perspiration, sport drinks) absorb into pores between rubber particles<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/finish_sealers.png\" alt=\"Finish\/Sealers\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Finish\/Sealers<\/th>\n      <td style=\"text-align: center;\">Not required<\/td>\n      <td style=\"text-align: center;\">Required to close pores from absorbing liquids<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/maintenance.png?v=1685465529\" alt=\"Maintenance\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Maintenance<\/th>\n      <td style=\"text-align: center;\">Smooth top surface makes mopping\/cleaning easy<\/td>\n      <td style=\"text-align: center;\">Rough\/porous top makes cleaning more difficult - mops 'stick' to it<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/cleanliness.png?v=1685465529\" alt=\"Cleanliness\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Cleanliness<\/th>\n      <td style=\"text-align: center;\">Does not harbour bacteria<\/td>\n      <td style=\"text-align: center;\">Porous surface allows bacteria to penetrate and spread<\/td>\n    <\/tr>\n   <\/tbody>\n<\/table>","width":"100%","alignment":"center"}}},"block_order":["liquid_rQfnWT"],"settings":{"full_width":false,"space_around":true}},"text_columns_kVDfMc":{"type":"text-columns","blocks":{"text_block_ANqMwY":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vulcanized_gym_floor.png","image_width":650,"title":"WHAT IS VULCANIZATION","text":"<p>Vulcanization is the process of transforming raw rubber into a durable cured material through cross-linking of polymer chains under high heat and pressure.<\/p>","button_label":"","button_link":""}},"text_block_UaHkn9":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vulcanization.jpg","image_width":650,"title":"How is Vulcanized Flooring Made?","text":"<p>End-of-life tires are recycled into tire crumb rubber, which is molded and vulcanized under high heat and pressure to create the final product.<\/p>","button_label":"","button_link":""}}},"block_order":["text_block_ANqMwY","text_block_UaHkn9"],"settings":{"title":"","align_text":"center","divider":false}},"6db7cc65-897c-4f5b-895d-b23d7bd82999":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"Made for your home","title":"RESIDENTIAL MATS","text":"<p>Our wide selection and customization in residential mat and flooring combined with exceptional customer service makes us a leader in this space. Find the perfect solution to your mat and flooring needs here!<\/p>","button_label":"view all door mats","button_link":"","image":"shopify:\/\/shop_images\/residential_mats_1.png","focal_point":"20% 0","layout":"right","height":550,"framed":false,"parallax":false,"parallax_direction":"top"}},"15645426-ea11-4754-b44e-fd43114d151d":{"type":"text-columns","blocks":{"template--14486626631809__15645426-ea11-4754-b44e-fd43114d151d-1678250364b3e3723b-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/3_59aaaf7a-d3db-4f36-8ffe-8f2bf14057a4.png","image_width":650,"title":"ANTI-FATIGUE OFFICE mats","text":"<p>Our anti-fatigue mat improves your health through increased blood flow and muscle activation.<\/p>","button_label":"anti-fatigue mats","button_link":"shopify:\/\/collections\/kitchen-anti-fatigue-mats"}},"template--14486626631809__15645426-ea11-4754-b44e-fd43114d151d-1678
t","settings":{"enlarge_text":true,"text":"<p>Discover the Unmatched Excellence of Vulcanized Rubber Flooring for Elite Gyms and Sports Facilities<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"ee9ab566-ada6-4b02-9b17-0b54db0bd62c":{"type":"advanced-content","blocks":{"template--14491778023553__ee9ab566-ada6-4b02-9b17-0b54db0bd62c-16853617405f3c542a-1":{"type":"liquid","settings":{"code":"<table>\n  <thead>\n    <tr style=\"background-color: lightgray;\">\n      <th style=\"background-color: lightgray;\"><\/th>\n      <th style=\"background-color: lightgray; text-align: center;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/vulcanized_products.png?v=1686064408\" alt=\"Vulcanized Products\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Vulcanized Products<\/th>\n      <th style=\"background-color: lightgray; text-align: center;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/urethane_bound.png?v=1686064408\" alt=\"Urethane Bound Products\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Urethane Bound Products<\/th>\n    <\/tr>\n  <\/thead>\n  <tbody>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/durability.png?v=1685465529\" alt=\"Durability\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">\n  Durability\n<\/th>\n      <td style=\"text-align: center;\">Hard wearing and durable<\/td>\n      <td style=\"text-align: center;\">With heavy\/continuous use product deteriorates<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/porosity.png?v=1685465530\" alt=\"Porosity\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Porosity<\/th>\n      <td style=\"text-align: center;\">Does not absorb liquid<\/td>\n      <td style=\"text-align: center;\">Liquids (water, perspiration, sport drinks) absorb into pores between rubber particles<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/finish_sealers.png\" alt=\"Finish\/Sealers\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Finish\/Sealers<\/th>\n      <td style=\"text-align: center;\">Not required<\/td>\n      <td style=\"text-align: center;\">Required to close pores from absorbing liquids<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/maintenance.png?v=1685465529\" alt=\"Maintenance\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Maintenance<\/th>\n      <td style=\"text-align: center;\">Smooth top surface makes mopping\/cleaning easy<\/td>\n      <td style=\"text-align: center;\">Rough\/porous top makes cleaning more difficult - mops 'stick' to it<\/td>\n    <\/tr>\n    <tr>\n      <th style=\"background-color: lightgray;\"><img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0041\/9672\/8961\/files\/cleanliness.png?v=1685465529\" alt=\"Cleanliness\" style=\"display: inline-block; vertical-align: middle; margin-right: 10px;\">Cleanliness<\/th>\n      <td style=\"text-align: center;\">Does not harbour bacteria<\/td>\n      <td style=\"text-align: center;\">Porous surface allows bacteria to penetrate and spread<\/td>\n    <\/tr>\n   <\/tbody>\n<\/table>","width":"100%","alignment":"center"}}},"block_order":["template--14491778023553__ee9ab566-ada6-4b02-9b17-0b54db0bd62c-16853617405f3c542a-1"],"settings":{"full_width":false,"space_around":true}},"2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9":{"type":"text-columns","blocks":{"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vulcanized_gym_floor.png","image_width":650,"title":"What is Vulcanization?","text":"<p>Vulcanization is the process of transforming raw rubber into a durable cured material through cross-linking of polymer chains under high heat and pressure.<\/p>","button_label":"","button_link":""}},"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/vulcanization.jpg","image_width":650,"title":"How is Vulcanized Flooring Made?","text":"<p>End-of-life tires are recycled into tire crumb rubber, which is molded and vulcanized under high heat and pressure to create the final product.<\/p>","button_label":"","button_link":""}},"template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-2":{"type":"text_block","disabled":true,"settings":{"enable_image":true,"image_width":650,"title":"WHY DO WE VULCANIZE?","text":"<p>Vulcanized rubber flooring is highly durable and dense with a strong bond between fine crumb rubber particles. It's non-porous, resisting moisture absorption from ice, drinks, cleaning liquids, and perspiration. Unlike polyurethane rubber, it's up to 20 times less absorbent, making maintenance easier as liquids stay on the surface. Its non-porous nature inhibits bacterial growth, reducing the risk of infections. Third-party testing confirms NWR vulcanized rubber flooring eliminates 99.5% of microbial build-up with simple cleaning.<\/p>","button_label":"","button_link":""}}},"block_order":["template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-0","template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-1","template--14491778023553__2cf67e72-aeeb-4519-8bb0-9b2ffe4f8eb9-16855514966bccb648-2"],"settings":{"title":"","align_text":"center","divider":false}},"text-and-image":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/vulcanized_gym_flooring.png","image_width":700,"subtitle":"","title":"WHY DO WE VULCANIZE?","text":"<ul><li>Vulcanized rubber flooring is <strong>highly durable and dense<\/strong> with a strong bond between fine crumb rubber particles. <\/li><li>It's non-porous, <strong>resisting moisture absorption<\/strong> from ice, drinks, cleaning liquids, and perspiration. <\/li><li>Unlike polyurethane rubber, it's <strong>up to 20 times less absorbent<\/strong>, making maintenance easier as liquids stay on the surface. <\/li><li>Its non-porous nature <strong>inhibits bacterial growth<\/strong>, reducing the risk of infections. <\/li><li>Third-party testing confirms <strong>vulcanized rubber flooring eliminates 99.5% of microbial build-up<\/strong> with simple cleaning.<\/li><\/ul>","button_label":"","button_link":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"cb654345-0288-483c-97d7-cdd6f500edee":{"type":"logo-list","blocks":{"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-1":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_1.value }}","link":""}},"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-0":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_2.value }}","link":""}},"template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-2":{"type":"logo_image","settings":{"image":"{{ product.metafields.custom.logo_list_image_3.value }}","link":""}}},"block_order":["template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-1","template--14491778023553__cb654345-0288-483c-97d7-cdd6f500edee-16855370770bf7e9ba-0","template--14491778023553__cb654345-0288-483
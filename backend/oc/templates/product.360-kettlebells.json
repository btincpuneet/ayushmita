ize_chart_TGqqWL","51a6a430-cf84-44a3-9429-d734a89d91bd","ddd74b6d-6daf-47e5-b4af-7036425180df","bbe11d6f-489e-496c-89a9-28549383936e","8aad83d6-af55-472b-926a-a8f99a44e45b","separator","variant_picker","b3f56785-d08a-4e13-b28b-88b87b2268fe","inventory_status","69f755d7-e378-4120-a0bc-7f86e1989226","buy_buttons","text_9teMK4","custom_e6FAjx","tab","contact","description","share","sales_point_cbyBqR","sales_point_U3kPwY","sales_point_4XTpgy","custom_KkVRMt","ece7ced3-e4d1-427e-bc13-c022ca67ad40"],"settings":{"sku_enable":true,"image_position":"left","image_size":"medium","product_zoom_enable":true,"thumbnail_position":"beside","thumbnail_height":"flexible","thumbnail_arrows":false,"mobile_layout":"partial","enable_video_looping":true,"product_video_style":"muted"}},"promo_grid_ttcfQE":{"type":"promo-grid","blocks":{"banner_9nNATj":{"type":"banner","settings":{"heading":"Need more help?","text":"Contact our sales department at (800) 624-0041","link":"https:\/\/canadamats.ca\/pages\/request-a-quote","label":"GET A QUOTE","color_tint":"#000000","color_tint_opacity":8,"framed":true}}},"block_order":["banner_9nNATj"],"name":"t:sections.promo-grid.presets.promotional_grid.name","settings":{"full_width":false,"gutter_size":0,"space_above":false,"space_below":true}},"sub":{"type":"product-full-width","blocks":{"eafc7d68-a94f-4ae5-8bae-6775dafd837e":{"type":"description","settings":{"is_tab":false}}},"block_order":["eafc7d68-a94f-4ae5-8bae-6775dafd837e"],"settings":{"max_width":false}},"3eb2f88f-12e5-4f87-aabb-ad99d885f103":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/CFXKB-Kettlebell-415x500px.png","image_width":450,"subtitle":"Kettlebells","title":"Where to Use Them","text":"<p>Ideal for functional strength training across a variety of environments: <\/p><p>✔ Home gyms <br\/>✔ Fitness studios <br\/>✔ Commercial gyms <br\/>✔ Personal training spaces <br\/>✔ General strength and conditioning workouts<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/KBR2-COREFX-Kettlebell-Rack-3-800x1000px.jpg","image_width":450,"subtitle":"Sturdy Storage","title":"Kettlebell Storage Rack","text":"<p>Keep your training space organized and safe with this durable steel storage rack. Designed to securely hold kettlebells, dumbbells, and slam balls, it features grippy rubber-lined shelves and raised edges to prevent slipping while keeping equipment easily accessible for every workout.<\/p>","button_label":"Shop Now!","button_link":"shopify:\/\/products\/kettlebell-storage-rack","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"5aa28646d1fec563ef19":{"type":"apps","blocks":{"c17b8470-41ee-4abe-8d7e-edc9ac5270f5":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}}},"block_order":["c17b8470-41ee-4abe-8d7e-edc9ac5270f5"],"settings":{"full_width":false,"space_around":true}},"0cdbf87b-3e79-4778-b332-d27fd53206c2":{"type":"rich-text","blocks":{"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0":{"type":"heading","disabled":true,"settings":{"title":"Simple Installation"}},"template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1":{"type":"text","disabled":true,"settings":{"enlarge_text":true,"text":"<p>In four simple and fast steps, you can have your surface fully installed in minutes or less.<\/p><p><strong>Getting Started<\/strong><\/p><p>The panels have two sides with female PowerLocks, and two sides with male PowerLocks. All tiles on any given installation should always have the female PowerLocks going in the same direction.<\/p><p><strong>Step One<\/strong><\/p><p>Begin the installation by laying down your first panel in any one corner and pointing the female PowerLocks in the two directions that additional panels are to be added.<\/p><p><strong>Step Two<\/strong><\/p><p>Place the next panel so that the male PowerLock line up over the top of the female loops on the first panel. It's important to make sure that the female PowerLocks are facing exactly the same direction as the first panel.<\/p><p><strong>Step Three<\/strong><\/p><p>Gently step along the joint of the two panels. You will hear and feel the PowerLocks snap into place as you go.<\/p><p><strong>Step Four<\/strong><\/p><p>Once the two panels are joined, repeat steps one through three remembering to keep the female PowerLocks aligned until your floor is complete. That's all there is to this easy-to-install flooring!<\/p>"}}},"block_order":["template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-0","template--14478213218433__0cdbf87b-3e79-4778-b332-d27fd53206c2-1678417601549c6456-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"f7c3225f-e625-4856-a697-866928ef710b":{"type":"rich-text","blocks":{"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0":{"type":"heading","settings":{"title":"REGULAR VS PRO GRADE MATS"}},"template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>The underside of Floor Defender Pro Garage Containment Mats features a tatami grain pattern for increased traction. This patterned backing prevents these mats from lifting and allows them to retain their shape over extended periods of time. Also, the tatami grain patterned backing produces a smoother, less wrinkled surface than the smooth backed regular Floor Defender Garage Containment Mats.<\/p>"}}},"block_order":["template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-0","template--14478213218433__f7c3225f-e625-4856-a697-866928ef710b-167852603719a9971e-1"],"disabled":true,"settings":{"align_text":"center","narrow_column":true,"divider":false}},"12ee58e8-5133-4e52-a73b-887b18d27f7f":{"type":"background-image-text","disabled":true,"settings":{"subtitle":"ROLL OUT AND LAY DOWN","title":"HASSLE-FREE INSTALL","text":"<p>Incredibly easy to use, the floor defenders unlike some other garage containments mats come ready to use. The single piece construction allows you to simply roll the mat out and lay it on your floor.<\/p>","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/ezgif.com-gif-maker_8.gif","focal_point":"center","layout":"left","height":550,"framed":false,"parallax":true,"parallax_direction":"top"}},"9d8d2f29-27b5-4648-b084-5ca9f0b9964b":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_42_33_705Z.png","image_width":500,"subtitle":"Improved","title":"EASY CLEAN UP","text":"<p>Floor defenders are very easy to clean, simply drag the mat outside with all its contents and hose it down. In a matter of minutes, the mat is ready to be redeployed and used all over again.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"49e1522d-4e00-4356-91df-3d3dbada5a3e":{"type":"text-and-image","disabled":true,"settings":{"image":"shopify:\/\/shop_images\/image_2023_03_11T09_45_06_105Z.png","image_width":500,"subtitle":"","title":"SIMPLE & COMPACT STORAGE","text":"<p>Although the Floor Defender Mats can be used year round, some of our customers prefer to only have the mats out in the winter.<\/p><p>Storing these mats after winter is incredibly easy. Simply roll them back up into a compact size and store it way in your garage.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f220664d-cc7b-4aea-a660-b60af2d6dd55":{"type":"featured-collection","disabled":true,"settings":{"title":"Featured collection","home_featured_products":"garage-flooring","per_row":4,"rows":1,"mobile_scrollable":true,"view_all":false,"divider":false}},"product-recommendations":{"type":"product-recommendations","settings":{"show_product_recommendations":true,"product_recommendations_heading":"You may also like","related_count":5}},"recently-viewed":{"type":"recently-viewed","settings":{"recent_count":5}},"collection-return":{"type":"collection-return","settings":{}},"168078895274d4618a":{"type":"apps","blocks":{"84012a34-7866-4c74-b4f7-16f370ff2d45":{"type":"shopify:\/\/apps\/yotpo-product-reviews\/blocks\/reviews\/eb7dfd7d-db44-4334-bc49-c893b51b36cf","settings":{"product":"{{product}}"}}},"block_order":["84012a34-7866-4c74-b4f7-16f370ff2d45"],"disabled":true,"settings":{"full_width":false,"space_around":true}}},"order":["main","promo_grid_ttcfQE","sub","3eb2f88f-12e5-4f87-aabb-ad99d885f103","f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd","5aa28646d1fec563ef19","0cdbf87b-3e79-4778-b332-d27fd53206c2","f7c3225f-e625-4856-a697-866928ef710b","12ee58e8-5133-4e52-a73b-887b18d27f7f","9d8d2f29-27b5-4648-b084-5ca9f0b9964b","49e1522d-4e00-4356-91df-3d3dbada5a3e","f220664d-cc7b-4aea-a660-b60af2d6dd55","product-recommendations","recently-viewed","collection-return","168078895274d4618a"]}
ayout":"left","divider":false}},"9d8d2f29-27b5-4648-b084-5ca9f0b9964b":{"type":"text-and-image","custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/03b.gif","image_width":500,"subtitle":"","title":"HIGH-QUALITY MATERIAL","text":"<p>This ergonomically designed exercise mat features a 5cm thick EPE foam padding, providing a comfortable and safe experience while absorbing shocks. Its high-quality PU leather cover is resistant to tears, punctures, and sweat, and can be easily cleaned with a damp cloth.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"c8a01ad0-d5f3-4e37-a39e-bcf733a75f71":{"type":"text-and-image","settings":{"image":"shopify:\/\/shop_images\/EPE_folding_sports_mat.jpg","image_width":500,"subtitle":"","title":"{{ product.metafields.custom.image_text_3_heading.value }}","text":"<p>{{ product.metafields.custom.image_text_3_description | metafield_tag }}<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"left","divider":false}},"f2f4d304-6a8f-48b3-a6cd-0466dc6e11bd":{"type":"text-and-image","disabled":true,"custom_css":[".h1,h1 {font-size: calc(var(--typeHeaderSize) * 0.85); font-weight: bold; font-size: 22px;}"],"settings":{"image":"shopify:\/\/shop_images\/easy_to_store_and_carry.jpg","image_width":700,"subtitle":"","title":"EASY STORAGE & TRANSPORTATION","text":"<p>The mat can be effortlessly folded up, allowing for space-saving storage. Additionally, the mat comes equipped with sturdy sewn-in carrying handles, ensuring convenient transportation wherever you need it.<\/p>","button_label":"","button_link":"","button_label2":"","button_link2":"","button_style":"primary","align_text":"left","layout":"right","divider":false}},"01c73b11-cbc3-4cc9-b665-e14c60c922d8":{"type":"slideshow","blocks":{"template--14497374994561__01c73b11-cbc3-4cc9-b665-e14c60c922d8-1686335180c24b57eb-0":{"type":"image","settings":{"top_subheading":"Need Mats for professional grade use?","title":"TRY OUR PREMIUM SPORTS MATS","title_size":60,"subheading":"Elevate Performance, Enhance Safety","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-bottom horizontal-right","image":"shopify:\/\/shop_images\/2_4967240a-db74-4eed-9ac4-c7c7103ff7b0.png","image_mobile":"shopify:\/\/shop_images\/2_1_351c229e-7ce1-4b28-958f-a2f52f38a911.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"center center"}}},"block_order":["template--14497374994561__01c73b11-cbc3-4cc9-b665-e14c60c922d8-1686335180c24b57eb-0"],"settings":{"section_height":"natural","mobile_height":"auto","parallax":false,"style":"bars","autoplay":true,"autoplay_speed":5}},"33b5544f-e9ee-478c-85d2-1f130ff4a717":{"type":"logo-list","blocks":{"template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-3":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/puncture_resistant1.png","link":""}},"template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-1":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/spacesaving.png","link":""}},"template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-2":{"type":"logo_image","settings":{"image":"shopify:\/\/shop_images\/easymaintenance.png","link":""}}},"block_order":["template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-3","template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-1","template--14497374994561__33b5544f-e9ee-478c-85d2-1f130ff4a717-1686335328bca7dab0-2"],"settings":{"title":"","logo_opacity":100,"divider":false}},"ee1e24b1-d444-4ce4-8537-f30e4e4abdfa":{"type":"rich-text","blocks":{"template--14497374994561__ee1e24b1-d444-4ce4-8537-f30e4e4abdfa-1686335001eda9b1e9-0":{"type":"heading","settings":{"title":"OUR HIGH-QUALITY PREMIUM SPORTS MATS ARE METICULOUSLY CRAFTED"}},"template--14497374994561__ee1e24b1-d444-4ce4-8537-f30e4e4abdfa-1686335001eda9b1e9-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>To provide you with the ultimate training experience. Engineered with top-of-the-line materials and cutting-edge technology, these mats offer unmatched performance, durability, and comfort.<\/p>"}}},"block_order":["template--14497374994561__ee1e24b1-d444-4ce4-8537-f30e4e4abdfa-1686335001eda9b1e9-0","template--14497374994561__ee1e24b1-d444-4ce4-8537-f30e4e4abdfa-1686335001eda9b1e9-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb":{"type":"text-columns","blocks":{"template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Cross-Linked_PE_Foam_2.gif","image_width":650,"title":"1-3\/8” CROSS LINK FOAM MATS","text":"<p>Engineered to provide a firm foundation for sports activities, our mats <strong>ensure firm foot setting <\/strong>and unparalleled stability. With <strong>exceptional shock absorption <\/strong>properties, they minimize impact and protect your body during intense training sessions.<\/p>","button_label":"BUY 1-3\/8” CROSS LINK FOAM MATS","button_link":"shopify:\/\/products\/tumbling-super-mats"}},"template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Cross-Linked_PE_Foam_2_1.gif","image_width":650,"title":"2” CROSS LINK FOAM MATS","text":"<p>Our meticulously designed mats offer a firm foundation, providing a<strong>stable foot setting<\/strong>and unmatched stability for sports activities. Experience<strong>greater shock absorption<\/strong>capabilities that effectively minimize impact, safeguarding your body during intense training sessions.<\/p>","button_label":"BUY 2” CROSS LINK FOAM MATS","button_link":"shopify:\/\/products\/karate-mats"}},"template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Dual_Foam_Cora.gif","image_width":650,"title":"COMBO MARTIAL ARTS MATS","text":"<p>Crafted with precision, our mats feature a top layer that <strong>ensures exceptional stability, facilitating confident footing <\/strong>for athletes at intermediate to expert levels. The bottom layer is designed to absorb impact, <strong>providing a cushioned landing surface <\/strong>for falls and throws.<\/p>","button_label":"BUY COMBO MARTIAL ARTS MATS","button_link":"shopify:\/\/products\/combo-martial-art-mats"}}},"block_order":["template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-0","template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-1","template--14497374994561__0f3d6d6a-5fb9-4539-b1d2-ecbae73004bb-1686335463fab4e695-2"],"settings":{"title":"PREMIUM FOLDING MATS","align_text":"center","divider":false}},"a7ce93cc-62fe-40d2-8ee3-9b89e81f2f4a":{"type":"text-columns","blocks":{"template--14497374994561__a7ce93cc-62fe-40d2-8ee3-9b89e81f2f4a-1686335463fab4e695-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/Rebond_Foam_1.gif","image_width":400,"title":"ALL-PURPOSE TUMBLING MATS","text":"<p>Our specially crafted mats are the <strong>perfect choice for beginners honing their falling and tumbling <\/strong>techniques. Constructed with <strong>high-quality rebonded foam<\/strong>, these mats deliver <strong>maximum cushioning and impact absorption<\/strong>, ensuring a safe and supportive learning experience.<\/p>","button_label":"BUY ALL-PURPOSE TUMBLING MATS","button_link":"shopify:\/\/products\/all-purpose-tumbling-mats"}},"template--14497374994561__a7ce93cc-62fe-40d2-8ee3-9b89e81f2f4a-1686335463fab4e695-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/03b.gif","image_width":400,"title":"VARSITY EXERCISE MAT","text":"<p>Made out of Polyurethane foam, the Varsity Mat is <strong>dense and durable<\/strong>, often used in professional-grade sports mats. It provides <strong>excellent shock absorption and cushioning<\/strong>, making it <strong>suitable for high-intensity activities and professional sports applications<\/strong>.<\/p>","button_label":"BUY VARSITY EXERCISE MAT","button_link":"shopify:\/\/products\/varsity-folding-mats"}}},"block_order":["template--14497374994561__a7ce93cc-62fe-40d2-8ee3-9b89e81f2f4a-1686335463fab4e695-0","template--14497374994561__a7ce93cc-62fe-40d2-8ee3-9b89e81f2f4a-1686335463fab4e695-1"],"settings":{"title":"","align_text":"center","divider":false}},"6ea33e48-83df-40f5-9625-ffbb97560388":{"type":"text-columns","blocks":{"template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/4_71b06699-cafc-4d46-863f-9b55a10be5ae.png","image_width":400,"title":"HIGH-QUALITY FOAM","text":"<p>Made from high-quality foam materials, these mats offer<strong>optimal cushioning, impact absorption, and support<\/strong>for your workouts. Experience the perfect blend of comfort and durability as you push your limits in activities like gymnastics, martial arts, or general fitness training.<\/p>","button_label":"","button_link":""}},"template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/3_d538efc9-367b-43b1-bd8e-2fc99273e6a1.png","image_width":400,"title":"EXPERIENCE HYGIENIC EXCELLENCE","text":"<p>Our vinyl sports mats feature<strong>advanced antimicrobial properties that inhibit the growth of bacteria and fungi<\/strong>. Experience a clean and protected environment, free from odors and potential infections.<\/p>","button_label":"","button_link":""}},"template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-2":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/1_c698d7be-eb35-4578-8147-44ff4e2a9b01.png","image_width":400,"title":"UNRIVALED DURABILITY","text":"<p><strong>Made out of 18 oz. heavy duty vinyl<\/strong>, these tumbling mats can withstand the toughest of activities. With exceptional durability and resilience, they deliver long-lasting performance and reliable protection for your intense workouts.<\/p>","button_label":"","button_link":""}},"0b8f11ed-8598-4f5a-81fe-eed1618835f8":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/easy_to_store_and_carry.jpg","image_width":400,"title":"CONVENIENCE MEETS PERFORMANCE","text":"<p>Designed for easy transport and storage, our foldable sports mats offer the perfect balance of portability and functionality. Engineered with premium materials, they<strong>maintain their durability and performance even after repeated folding and unfolding<\/strong>.<\/p>","button_label":"","button_link":""}}},"block_order":["template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-0","template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-1","template--14497374994561__6ea33e48-83df-40f5-9625-ffbb97560388-1686335463fab4e695-2","0b8f11ed-8598-4f5a-81fe-eed1618835f8"],"settings":{"title":"","align_text":"center","divider":false}},"8bfc492c-4798-489e-960f-9c468e9067f4":{"type":"text-columns","blocks":{"template--14497374994561__8bfc492c-4798-489e-960f-9c468e9067f4-1686336266c4eb326f-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/6254_ce424b27-0377-435e-8941-1c357445d448.png","image_width":400,"title":"SPORTS PUZZLE MATS","text":"<p>These mats are made of high-density EVA foam with a tough vinyl surface that provides users with durability and support while reducing the risk of injury. These double-sided interlocking tiles are great for martial arts activities of all levels.<br\/><br\/><strong>Skill Level:<\/strong> All Levels<\/p><p><em>Starting at $2.46\/sq ft.<\/em><\/p>","button_label":"BUY SPORTS PUZZLE MATS","button_link":"shopify:\/\/products\/puzzle-mats"}},"template--14497374994561__8bfc492c-4798-489e-960f-9c468e9067f4-1686336266c4eb326f-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/43523_b6593d62-80c6-48f8-bb87-9bbf23e6ec74.png","image_width":400,"title":"JUDO MATS","text":"<p>Made from high-density EVA foam, these mats are great for handling falls and absorbing shock. These double-sided interlocking tiles are great for training facility and ideal for standing up martial arts<br\/><br\/><strong>Skill Level:<\/strong> All Levels<\/p><p><em>Starting at $5.67\/sq ft.<\/em><\/p>","button_label":"BUY JUDO MATS","button_link":"shopify:\/\/products\/judo-mat"}}},"block_order":["template--14497374994561__8bfc492c-4798-489e-960f-9c468e9067f4-1686336266c4eb326f-0","template--14497374994561__8bfc492c-4798-489e-960f-9c468e9067f4-1686336266c4eb326f-1"],"settings":{"title":"PRMIUM PUZZLE SPORTS MATS","align_text":"center","divider":false}},"7f07ac1a-25df-4d11-9684-86b70ba8e027":{"type":"slideshow","blocks":{"template--14497374994561__7f07ac1a-25df-4d11-9684-86b70ba8e027-1686335180c24b57eb-0":{"type":"image","settings":{"top_subheading":"","title":"EXPERTLY CURATED","title_size":60,"subheading":"Discover Excellence in Every Move with Our Line of Sports Mats","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","image":"shopify:\/\/shop_images\/3_5c419c9d-7984-4700-9d04-40875acea967.png","image_mobile":"shopify:\/\/shop_images\/3_1_9ba4e245-adf6-4ee8-baa8-8078edbb7edf.png","parallax_direction":"top","overlay_opacity":0,"focal_point":"cente
{% doc %}
  @prompt
    Create a full-width dark section (black background) for a commercial gym flooring product page. Layout has two parts:
    
    LEFT SIDE (60% width):
    - Small red pill/badge top-left with step number "§ 02" in white text on red (#CC0000) background
    - Large bold white headline in display font, 3 lines: "Most gym flooring problems show up after the workouts begin." — where "show up" is in a muted gray/dark color as an accent within the white text
    - Short body paragraph in small light gray text below the headline
    - A thin horizontal red line (#CC0000) spanning full width at the very top of the section
    
    RIGHT SIDE (40% width), split into two columns:
    - Left column header: "GENERIC RUBBER" in small red uppercase label, followed by a list of negatives with em dash bullets: "— Absorbs sweat & moisture", "— Strong rubber odor", "— Delaminates under drops", "— Replaced in 3–5 yrs" in light gray text
    - Right column header: "CM RESILIENT" in small white uppercase label, followed by a checklist with red checkmarks: "✓ Repels water", "✓ Minimized odor", "✓ Vulcanized core", "✓ 20-yr indoor life" in white text
    
    DESIGN: Full black background (#0a0a0a), white and red (#CC0000) typography, bold display font for headline, generous padding top and bottom (80px), all text settings editable via schema., heading is not showing
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gym-comparison-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    position: relative;
  }

  .ai-gym-comparison__top-line-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.accent_color }};
    margin-bottom: 60px;
  }

  .ai-gym-comparison__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    gap: 80px;
    align-items: flex-start;
  }

  .ai-gym-comparison__left-{{ ai_gen_id }} {
    flex: 0 0 60%;
  }

  .ai-gym-comparison__badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.5px;
  }

  .ai-gym-comparison__headline-{{ ai_gen_id }} {
    font-family: {{ block.settings.headline_font.family }}, {{ block.settings.headline_font.fallback_families }};
    font-weight: {{ block.settings.headline_font.weight }};
    font-style: {{ block.settings.headline_font.style }};
    color: {{ block.settings.headline_color }};
    font-size: {{ block.settings.headline_font_size }}px;
    line-height: {{ block.settings.headline_line_height }};
    margin: 0 0 24px;
    letter-spacing: -0.5px;
  }

  .ai-gym-comparison__headline-accent-{{ ai_gen_id }} {
    color: {{ block.settings.headline_accent_color }};
  }

  .ai-gym-comparison__body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_font_size }}px;
    line-height: {{ block.settings.body_line_height }};
    margin: 0;
  }

  .ai-gym-comparison__right-{{ ai_gen_id }} {
    flex: 0 0 40%;
    display: flex;
    gap: 40px;
  }

  .ai-gym-comparison__column-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-gym-comparison__column-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_header_font_size }}px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .ai-gym-comparison__column-header--generic-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
  }

  .ai-gym-comparison__column-header--cm-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
  }

  .ai-gym-comparison__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-gym-comparison__list-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.list_font_size }}px;
    line-height: {{ block.settings.list_line_height }};
    margin-bottom: 12px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .ai-gym-comparison__list-item--generic-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
  }

  .ai-gym-comparison__list-item--cm-{{ ai_gen_id }} {
    color: {{ block.settings.headline_color }};
  }

  .ai-gym-comparison__bullet-{{ ai_gen_id }} {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .ai-gym-comparison__checkmark-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    font-weight: 700;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-gym-comparison__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
      padding: 0 24px;
    }

    .ai-gym-comparison__left-{{ ai_gen_id }},
    .ai-gym-comparison__right-{{ ai_gen_id }} {
      flex: 1 1 100%;
    }

    .ai-gym-comparison__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.7 }}px;
    }

    .ai-gym-comparison__top-line-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-gym-comparison__right-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 32px;
    }

    .ai-gym-comparison__headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.6 }}px;
    }
  }
{% endstyle %}

<gym-comparison-{{ ai_gen_id }} class="ai-gym-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gym-comparison__top-line-{{ ai_gen_id }}"></div>
  
  <div class="ai-gym-comparison__container-{{ ai_gen_id }}">
    <div class="ai-gym-comparison__left-{{ ai_gen_id }}">
      {% if block.settings.badge_text != blank %}
        <div class="ai-gym-comparison__badge-{{ ai_gen_id }}">
          {{ block.settings.badge_text }}
        </div>
      {% endif %}

      <h2 class="ai-gym-comparison__headline-{{ ai_gen_id }}">
        {{ block.settings.headline_part_1 }}
        {% if block.settings.headline_accent != blank %}
          <span class="ai-gym-comparison__headline-accent-{{ ai_gen_id }}">{{ block.settings.headline_accent }}</span>
        {% endif %}
        {{ block.settings.headline_part_2 }}
      </h2>

      {% if block.settings.body_text != blank %}
        <p class="ai-gym-comparison__body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </p>
      {% endif %}
    </div>

    <div class="ai-gym-comparison__right-{{ ai_gen_id }}">
      <div class="ai-gym-comparison__column-{{ ai_gen_id }}">
        {% if block.settings.generic_header != blank %}
          <div class="ai-gym-comparison__column-header-{{ ai_gen_id }} ai-gym-comparison__column-header--generic-{{ ai_gen_id }}">
            {{ block.settings.generic_header }}
          </div>
        {% endif %}
        <ul class="ai-gym-comparison__list-{{ ai_gen_id }}">
          {% if block.settings.generic_item_1 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--generic-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }}">—</span>
              <span>{{ block.settings.generic_item_1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.generic_item_2 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--generic-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }}">—</span>
              <span>{{ block.settings.generic_item_2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.generic_item_3 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--generic-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }}">—</span>
              <span>{{ block.settings.generic_item_3 }}</span>
            </li>
          {% endif %}
          {% if block.settings.generic_item_4 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--generic-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }}">—</span>
              <span>{{ block.settings.generic_item_4 }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

      <div class="ai-gym-comparison__column-{{ ai_gen_id }}">
        {% if block.settings.cm_header != blank %}
          <div class="ai-gym-comparison__column-header-{{ ai_gen_id }} ai-gym-comparison__column-header--cm-{{ ai_gen_id }}">
            {{ block.settings.cm_header }}
          </div>
        {% endif %}
        <ul class="ai-gym-comparison__list-{{ ai_gen_id }}">
          {% if block.settings.cm_item_1 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--cm-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }} ai-gym-comparison__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.cm_item_1 }}</span>
            </li>
          {% endif %}
          {% if block.settings.cm_item_2 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--cm-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }} ai-gym-comparison__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.cm_item_2 }}</span>
            </li>
          {% endif %}
          {% if block.settings.cm_item_3 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--cm-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }} ai-gym-comparison__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.cm_item_3 }}</span>
            </li>
          {% endif %}
          {% if block.settings.cm_item_4 != blank %}
            <li class="ai-gym-comparison__list-item-{{ ai_gen_id }} ai-gym-comparison__list-item--cm-{{ ai_gen_id }}">
              <span class="ai-gym-comparison__bullet-{{ ai_gen_id }} ai-gym-comparison__checkmark-{{ ai_gen_id }}">✓</span>
              <span>{{ block.settings.cm_item_4 }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </div>
</gym-comparison-{{ ai_gen_id }}>

<script>
  (function() {
    class GymComparison{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('gym-comparison-{{ ai_gen_id }}', GymComparison{{ ai_gen_id }});
  })();
</script>

{% schema %}
